# Public form action exposed to the browser.
PUBLIC_NEWSLETTER_ENDPOINT=/api/subscribe/
# Server-only Resend API key.
RESEND_API_KEY=
# Server-only Resend segment identifier.
RESEND_SEGMENT_ID=
# Required server-only personal newsletter topic identifier.
RESEND_TOPIC_ID=
# Server-only: 32 random bytes encoded as 64 hex characters. Never PUBLIC_.
NEWSLETTER_CONFIRMATION_SECRET=
