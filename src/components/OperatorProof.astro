---
/* Unnumbered band closing the 01 arc, after the Caretrics block: one named
   operator quote, verbatim from caretrics.com with Rob's approval (2026-08-24).
   Moved below Caretrics 2026-08-27: the quote names "the Caretrics team", so
   ahead of the Caretrics block it floated. The eyebrow became visible the same
   day for the same reason. See docs/COPY.md. */
import Eyebrow from './Eyebrow.astro';
import { OPERATOR_PROOF } from '../data/operator-proof';
import { UI } from '../data/ui';
---

<section class="proof" aria-label={UI.operatorProof.regionLabel}>
  <div class="proof__inner">
    <Eyebrow>{UI.operatorProof.regionLabel}</Eyebrow>
    <figure class="proof__figure">
      <blockquote class="proof__quote">
        <p>“{OPERATOR_PROOF.quote}”</p>
      </blockquote>
      <figcaption class="proof__attribution">
        {OPERATOR_PROOF.name}{UI.section.separator}{OPERATOR_PROOF.role}
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .proof { background: var(--cream); }

  .proof__inner {
    width: 100%;
    max-width: var(--max-page);
    margin: 0 auto;
    /* Below the Caretrics block, whose own bottom padding provides the space
       above; the 88px here holds the band off the Principles rule below. */
    padding: 0 var(--gutter-desktop) 88px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .proof__figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .proof__quote {
    max-width: 62ch;
    margin: 0;
    padding-left: 20px;
    border-left: 3px solid var(--forest-500);
  }

  .proof__quote p {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: 24px;
    font-style: italic;
    line-height: 1.4;
    text-wrap: pretty;
  }

  .proof__attribution {
    padding-left: 23px;
    color: var(--ink-muted);
    font-size: 16px;
    line-height: 1.5;
  }

  @media (max-width: 767.98px) {
    .proof__inner { padding: 0 var(--gutter-mobile) 40px; gap: 14px; }
    .proof__figure { gap: 12px; }
    .proof__quote { padding-left: 16px; }
    .proof__quote p { font-size: 19px; line-height: 1.45; }
    .proof__attribution { padding-left: 19px; font-size: 15px; }
  }
</style>
