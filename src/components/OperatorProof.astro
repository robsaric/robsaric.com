---
/* Unnumbered band between 01 and 02: one named operator quote, verbatim from
   caretrics.com with Rob's approval (2026-08-24). See docs/COPY.md. */
import { OPERATOR_PROOF } from '../data/operator-proof';
import { UI } from '../data/ui';
---

<section class="proof" aria-label={UI.operatorProof.regionLabel}>
  <div class="proof__inner">
    <figure class="proof__figure">
      <blockquote class="proof__quote">
        <p>“{OPERATOR_PROOF.quote}”</p>
      </blockquote>
      <figcaption class="proof__attribution">
        {OPERATOR_PROOF.name}{UI.section.separator}{OPERATOR_PROOF.role}
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .proof { background: var(--cream); }

  .proof__inner {
    width: 100%;
    max-width: var(--max-page);
    margin: 0 auto;
    padding: 88px var(--gutter-desktop) 0;
  }

  .proof__figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .proof__quote {
    max-width: 62ch;
    margin: 0;
    padding-left: 20px;
    border-left: 3px solid var(--forest-500);
  }

  .proof__quote p {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: 24px;
    font-style: italic;
    line-height: 1.4;
    text-wrap: pretty;
  }

  .proof__attribution {
    padding-left: 23px;
    color: var(--ink-muted);
    font-size: 16px;
    line-height: 1.5;
  }

  @media (max-width: 767.98px) {
    .proof__inner { padding: 40px var(--gutter-mobile) 0; }
    .proof__figure { gap: 12px; }
    .proof__quote { padding-left: 16px; }
    .proof__quote p { font-size: 19px; line-height: 1.45; }
    .proof__attribution { padding-left: 19px; font-size: 15px; }
  }
</style>
