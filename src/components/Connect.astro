---
import { EDITORIAL as E } from '../data/editorial';
import { SITE } from '../data/site';
import { UI } from '../data/ui';
import Arrow from './Arrow.astro';
const newsletterEndpoint = import.meta.env.PUBLIC_NEWSLETTER_ENDPOINT?.trim();
---
<section class="connect" data-write-to-me data-invalid-email={UI.newsletter.invalidEmail} aria-labelledby="connect-title">
  <div class="wrap connect-layout">
    <div><h2 id="connect-title">{E.connect.heading}</h2><p>{E.connect.body}</p>
      <div class="connect-actions"><a class="action" href={SITE.links.linkedin} target="_blank" rel="noopener">{E.connect.follow}<Arrow diagonal /></a><a class="text-link" href="/contact/">{E.connect.email}<Arrow /></a></div>
    </div>
    {newsletterEndpoint && <div class="newsletter">
      <h3>{E.connect.newsletterTitle}</h3><p>{E.connect.newsletterBody}</p>
      <form method="post" action={newsletterEndpoint} data-newsletter-form>
        <div class="visually-hidden" aria-hidden="true"><input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" /></div>
        <label for="newsletter-email">{UI.newsletter.emailLabel}</label>
        <input id="newsletter-email" type="email" name="email" required autocomplete="email" placeholder={UI.newsletter.emailPlaceholder} aria-describedby="newsletter-status" data-newsletter-email />
        <span id="newsletter-status" class="newsletter-status" aria-live="polite" data-newsletter-status></span>
        <button class="action" type="submit" data-newsletter-submit data-loading-label={UI.newsletter.subscribing}>{UI.newsletter.subscribe}<Arrow /></button>
      </form>
    </div>}
  </div>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-write-to-me]').forEach(root => {
    root.dataset.ready = 'true';
    const form = root.querySelector<HTMLFormElement>('[data-newsletter-form]');
    const email = root.querySelector<HTMLInputElement>('[data-newsletter-email]');
    const status = root.querySelector<HTMLElement>('[data-newsletter-status]');
    const submit = root.querySelector<HTMLButtonElement>('[data-newsletter-submit]');
    if (!form || !email || !status || !submit) return;
    form.noValidate = true;
    email.addEventListener('input', () => {
      if (email.validity.valid) { email.removeAttribute('aria-invalid'); status.textContent = ''; }
    });
    form.addEventListener('submit', event => {
      if (!email.validity.valid) {
        event.preventDefault(); email.setAttribute('aria-invalid', 'true');
        status.textContent = root.dataset.invalidEmail ?? ''; email.focus(); return;
      }
      email.removeAttribute('aria-invalid');
      status.textContent = '';
      submit.textContent = submit.dataset.loadingLabel ?? ''; submit.disabled = true;
    });
  });
</script>
<style>
.connect { background: var(--sky); padding: 80px 0; }
.connect-layout { display: grid; grid-template-columns: minmax(0,1fr); gap: 64px; }
.connect-layout:has(.newsletter) { grid-template-columns: 1.3fr 1fr; }
h2 { max-width: 16ch; font-size: var(--text-h2); margin: 0 0 24px; }
p { max-width: 52ch; font-size: 18px; line-height: 1.65; margin: 0; }
.connect-actions { display: flex; flex-wrap: wrap; gap: 16px 28px; margin-top: 28px; }
.newsletter { padding-left: 40px; border-left: 1px solid var(--rule); align-self: center; }
h3 { font-size: 24px; margin: 0 0 12px; }
.newsletter p { font-size: 16px; margin-bottom: 24px; }
form { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; }
label { font-size: 14px; }
input[type=email] { width: 100%; height: 52px; padding: 12px 14px; border: 1px solid var(--ink-muted); border-radius: 6px; background: var(--white); color: var(--ink); }
input::placeholder { color: var(--ink-muted); }
input[aria-invalid=true] { border-color: var(--status-critical-text); }
.newsletter-status { min-height: 20px; font-size: 14px; color: var(--status-critical-text); }
button { cursor: pointer; }
button:disabled { opacity: .7; cursor: wait; }
@media (max-width: 767.98px) {
 .connect { padding: 56px 0; }
 .connect-layout:has(.newsletter) { grid-template-columns: minmax(0,1fr); gap: 40px; }
 .newsletter { padding: 32px 0 0; border-left: 0; border-top: 1px solid var(--rule); }
 p { font-size: 17px; }
}
</style>
