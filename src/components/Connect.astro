---
import { EDITORIAL as E } from '../data/editorial';
import { SITE } from '../data/site';
import Arrow from './Arrow.astro';
import Newsletter from './Newsletter.astro';
interface Props { newsletterOnly?: boolean; }
const { newsletterOnly = false } = Astro.props;
const newsletterEndpoint = import.meta.env.PUBLIC_NEWSLETTER_ENDPOINT?.trim();
---
{(!newsletterOnly || newsletterEndpoint) && <div class:list={['connect', { 'newsletter-only': newsletterOnly }]}>
  <div class="wrap connect-layout">
    {!newsletterOnly && <section aria-labelledby="connect-title"><h2 id="connect-title">{E.connect.heading}</h2><p>{E.connect.body}</p>
      <div class="connect-actions"><a class="action" href={SITE.links.linkedin} target="_blank" rel="noopener">{E.connect.follow}<Arrow diagonal /></a><a class="text-link" href="/contact/">{E.connect.email}<Arrow /></a></div>
    </section>}
    {newsletterEndpoint && <div class="newsletter-column">
      <Newsletter id={newsletterOnly ? 'home-newsletter' : 'connect-newsletter'} prominent={newsletterOnly} headingLevel={newsletterOnly ? 2 : 3} showSample={newsletterOnly} split={newsletterOnly} />
    </div>}
  </div>
</div>}
<style>
.connect { background: var(--sky); padding: 80px 0; }
.newsletter-only { background: var(--paper); padding-block: 24px 48px; }
.connect-layout { display: grid; grid-template-columns: minmax(0,1fr); gap: 64px; }
.connect-layout:has(.newsletter-column) { grid-template-columns: 1.3fr 1fr; }
.newsletter-only .connect-layout { grid-template-columns: minmax(0, 1fr); }
.newsletter-only .newsletter-column { padding: 48px; border: 1px solid var(--rule); border-radius: 12px; background: var(--paper-inset); }
h2 { max-width: 16ch; font-size: var(--text-h2); margin: 0 0 24px; }
p { max-width: 52ch; font-size: 18px; line-height: 1.65; margin: 0; }
.connect-actions { display: flex; flex-wrap: wrap; gap: 16px 28px; margin-top: 28px; }
.newsletter-column { padding-left: 40px; border-left: 1px solid var(--rule); align-self: center; min-width: 0; }
@media (max-width: 767.98px) {
 .connect { padding: 56px 0; }
 .newsletter-only { padding-block: 12px 28px; }
 .newsletter-only .newsletter-column { padding: 28px 22px; }
 .connect-layout:has(.newsletter-column) { grid-template-columns: minmax(0,1fr); gap: 40px; }
 .newsletter-column { padding: 32px 0 0; border-left: 0; border-top: 1px solid var(--rule); }
 p { font-size: 17px; }
}
</style>
