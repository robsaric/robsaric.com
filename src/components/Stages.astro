---
import Section from './Section.astro';
import Button from './Button.astro';
import Eyebrow from './Eyebrow.astro';
import { COPY } from '../data/copy';
import { SITE } from '../data/site';
import { DEFAULT_STAGE_INDEX, STAGES } from '../data/stages';

const idPrefix = 'caretrics-stage';
---

<Section
  id="caretrics"
  number={COPY.caretrics.number}
  label={COPY.caretrics.label}
  tone="cream"
>
  <div
    class="caretrics"
    data-caretrics-stages
    data-default-stage={DEFAULT_STAGE_INDEX}
  >
    <div class="caretrics__intro">
      <h2>{COPY.caretrics.heading}</h2>
      <p class="caretrics__body caretrics__body--desktop">
        {COPY.caretrics.bodyDesktop}
      </p>
      <p class="caretrics__body caretrics__body--mobile">
        {COPY.caretrics.bodyMobile}
      </p>
    </div>

    <div class="stages">
      {STAGES.map((stage, index) => {
        const triggerId = `${idPrefix}-trigger-${index + 1}`;
        const panelId = `${idPrefix}-panel-${index + 1}`;
        const open = index === DEFAULT_STAGE_INDEX;

        return (
          <div class="stage">
            <button
              id={triggerId}
              class="stage__button"
              type="button"
              aria-expanded={open ? 'true' : 'false'}
              aria-controls={panelId}
              data-stage-index={index}
            >
              <span class="stage__button-main">
                <span
                  class:list={[
                    'stage__dot',
                    { 'stage__dot--owned': stage.owned },
                  ]}
                  aria-hidden="true"
                ></span>
                <span class="stage__name">{stage.name}</span>
              </span>
              <span
                class="stage__chevron"
                aria-hidden="true"
                data-stage-chevron
              >
                {open ? '−' : '+'}
              </span>
            </button>

            <div
              id={panelId}
              class="stage__panel"
              role="region"
              aria-labelledby={triggerId}
              data-stage-panel={index}
              hidden={!open}
            >
              <div class="stage__panel-inner">
                <div class="stage__question">
                  <Eyebrow>{COPY.caretrics.questionEyebrow}</Eyebrow>
                  <p>{stage.question}</p>
                </div>
                <div class="stage__signals">
                  <Eyebrow>{COPY.caretrics.signalsEyebrow}</Eyebrow>
                  <p>{stage.signals}</p>
                  <p class="stage__note">{stage.note}</p>
                </div>
              </div>
            </div>
          </div>
        );
      })}
    </div>

    <div class="caretrics__details">
      <div>
        <h3>{COPY.caretrics.doesHeading}</h3>
        <p>{COPY.caretrics.doesBody}</p>
        <span class="caretrics__trust">{COPY.caretrics.trustLine}</span>
      </div>
      <div>
        <h3>{COPY.caretrics.doesNotHeading}</h3>
        <p>{COPY.caretrics.doesNotBody}</p>
        <Button
          class="caretrics__cta"
          href={SITE.caretricsUrl}
          size="xl"
          icon="arrow-right"
          external
        >
          {COPY.caretrics.cta}
        </Button>
      </div>
    </div>

    <div class="caretrics__mobile-summary">
      <p>{COPY.caretrics.mobileBody}</p>
      <span class="caretrics__trust">{COPY.caretrics.trustLine}</span>
      <Button
        class="caretrics__cta"
        href={SITE.caretricsUrl}
        size="xl"
        icon="arrow-right"
        external
      >
        {COPY.caretrics.cta}
      </Button>
    </div>

    <div class="caretrics__togetheren">
      <div>
        <span class="caretrics__togetheren-title">
          {COPY.caretrics.togetherenTitle}
        </span>
        <span class="caretrics__togetheren-body caretrics__togetheren-body--desktop">
          {COPY.caretrics.togetherenBodyDesktop}
        </span>
        <span class="caretrics__togetheren-body caretrics__togetheren-body--mobile">
          {COPY.caretrics.togetherenBodyMobile}
        </span>
      </div>
      <a href={SITE.togetherenUrl} target="_blank" rel="noopener">
        {COPY.caretrics.togetherenLink}
      </a>
    </div>
  </div>
</Section>

<script>
  const stageRoots =
    document.querySelectorAll<HTMLElement>('[data-caretrics-stages]');

  stageRoots.forEach((root) => {
    if (root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';

    const buttons = Array.from(
      root.querySelectorAll<HTMLButtonElement>('[data-stage-index]'),
    );
    const panels = Array.from(
      root.querySelectorAll<HTMLElement>('[data-stage-panel]'),
    );
    const mobileQuery = window.matchMedia('(max-width: 767.98px)');
    const defaultStage = Number(root.dataset.defaultStage ?? 0);
    let active = defaultStage;

    const selectStage = (index: number) => {
      active = index;

      buttons.forEach((button, buttonIndex) => {
        const open = buttonIndex === active;
        button.setAttribute('aria-expanded', String(open));
        const chevron =
          button.querySelector<HTMLElement>('[data-stage-chevron]');
        if (chevron) chevron.textContent = open ? '−' : '+';
      });

      panels.forEach((panel, panelIndex) => {
        panel.hidden = panelIndex !== active;
      });
    };

    buttons.forEach((button, index) => {
      button.addEventListener('click', () => {
        if (mobileQuery.matches && active === index) {
          selectStage(-1);
          return;
        }
        selectStage(index);
      });
    });

    mobileQuery.addEventListener('change', (event) => {
      if (!event.matches && active < 0) selectStage(defaultStage);
    });
  });
</script>

<style>
  .caretrics { display: flex; flex-direction: column; gap: 44px; }

  .caretrics__intro {
    max-width: 58ch;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  h2 {
    margin: 0;
    font-size: var(--text-h2);
    line-height: var(--lh-heading);
    letter-spacing: var(--tracking-h2);
    text-wrap: pretty;
  }

  .caretrics__body,
  .caretrics__details p,
  .caretrics__mobile-summary p {
    margin: 0;
    font-size: var(--text-body-l);
    line-height: var(--lh-body);
    text-wrap: pretty;
  }

  .caretrics__body--mobile,
  .caretrics__mobile-summary { display: none; }

  .stages {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    overflow: hidden;
    background: var(--white);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
  }

  .stage { display: contents; }

  .stage__button {
    min-height: var(--tap-min);
    padding: 20px;
    grid-row: 1;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 8px;
    color: var(--ink);
    background: var(--white);
    border: 0;
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    text-align: left;
    cursor: pointer;
  }

  .stage:last-child .stage__button { border-right: 0; }
  .stage__button[aria-expanded='true'] { background: var(--wash); }
  .stage__button:focus-visible { outline-offset: -2px; }

  .stage__button-main {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  .stage__dot {
    width: 12px;
    height: 12px;
    display: block;
    flex: 0 0 12px;
    background: transparent;
    border: 2px solid var(--ink-muted);
    border-radius: var(--radius-pill);
  }

  .stage__dot--owned {
    background: var(--forest-500);
    border-color: var(--forest-500);
  }

  .stage__name {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  .stage__chevron { display: none; }

  .stage__panel {
    min-width: 0;
    grid-row: 2;
    grid-column: 1 / -1;
  }

  .stage__panel[hidden] { display: none; }

  .stage__panel-inner {
    min-height: 180px;
    padding: 36px 40px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
  }

  .stage__question,
  .stage__signals {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .stage__question p {
    margin: 0;
    font-size: var(--text-signal);
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.015em;
    text-wrap: pretty;
  }

  .stage__signals p {
    margin: 0;
    font-size: var(--text-body-l);
    line-height: var(--lh-body);
  }

  .stage__signals .stage__note {
    color: var(--ink-muted);
    font-size: 16px;
    line-height: 1.55;
  }

  .caretrics__details {
    padding-top: 40px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    border-top: 1px solid var(--rule);
  }

  .caretrics__details > div {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }

  h3 {
    margin: 0;
    font-size: var(--text-h3);
    letter-spacing: var(--tracking-h3);
  }

  .caretrics__trust {
    color: var(--ink-muted);
    font-size: 15px;
    line-height: 1.5;
  }

  .caretrics__cta { margin-top: 6px; }

  .caretrics__togetheren {
    padding-top: 28px;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 40px;
    border-top: 1px solid var(--rule);
  }

  .caretrics__togetheren > div {
    max-width: 62ch;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .caretrics__togetheren-title { font-size: 18px; font-weight: 600; }

  .caretrics__togetheren-body {
    color: var(--ink-muted);
    font-size: 17px;
    line-height: 1.55;
  }

  .caretrics__togetheren-body--mobile { display: none; }

  .caretrics__togetheren a {
    flex: 0 0 auto;
    font-size: 17px;
    font-weight: 600;
  }

  @media (max-width: 767.98px) {
    .caretrics { gap: 18px; }
    .caretrics__intro { gap: 18px; }
    h2 { font-size: 27px; line-height: 1.2; letter-spacing: -0.022em; }
    .caretrics__body { font-size: 17px; }
    .caretrics__body--desktop { display: none; }
    .caretrics__body--mobile { display: block; }
    .stages { display: block; }
    .stage { display: block; border-bottom: 1px solid var(--rule); }
    .stage:last-child { border-bottom: 0; }

    .stage__button {
      width: 100%;
      min-height: 56px;
      padding: 16px 18px;
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      border: 0;
    }

    .stage__button-main {
      flex-direction: row;
      align-items: center;
      gap: 12px;
    }

    .stage__name { font-size: 19px; }
    .stage__chevron { display: inline; color: var(--ink-muted); font-family: var(--font-mono); font-size: 18px; }

    .stage__panel-inner {
      min-height: 0;
      padding: 4px 18px 20px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .stage__question,
    .stage__signals { gap: 12px; }

    .stage__question :global(.eyebrow),
    .stage__signals :global(.eyebrow) { display: none; }

    .stage__question p { font-size: 19px; line-height: 1.4; }
    .stage__signals p { font-size: 16px; line-height: 1.55; }
    .stage__signals .stage__note { font-size: 15px; }
    .caretrics__details { display: none; }

    .caretrics__mobile-summary {
      padding-top: 4px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .caretrics__mobile-summary p { font-size: 17px; }
    .caretrics__cta { width: 100%; margin-top: 0; }

    .caretrics__togetheren {
      padding-top: 18px;
      flex-direction: column;
      align-items: stretch;
      gap: 6px;
    }

    .caretrics__togetheren-title { font-size: 17px; }
    .caretrics__togetheren-body { font-size: 16px; }
    .caretrics__togetheren-body--desktop { display: none; }
    .caretrics__togetheren-body--mobile { display: inline; }

    .caretrics__togetheren a {
      min-height: var(--tap-min);
      display: inline-flex;
      align-items: center;
      align-self: flex-start;
      font-size: 16px;
    }
  }
</style>
