---
import { Image } from 'astro:assets';
import portrait from '../assets/images/rob-portrait.jpg';
import { COPY } from '../data/copy';
import { SITE } from '../data/site';
import Button from './Button.astro';
import Eyebrow from './Eyebrow.astro';
---

<section class="hero">
  <div class="hero__inner">
    <div class="hero__copy">
      <Eyebrow class="hero__eyebrow hero__eyebrow--desktop">
        {COPY.hero.eyebrowDesktop}
      </Eyebrow>
      <Eyebrow class="hero__eyebrow hero__eyebrow--mobile">
        {COPY.hero.eyebrowMobile}
      </Eyebrow>
      <h1>{COPY.hero.heading}</h1>
      <p class="hero__body">{COPY.hero.body}</p>
      <div class="hero__actions">
        <Button
          href={SITE.caretricsUrl}
          size="xl"
          icon="arrow-right"
          external
        >
          {COPY.hero.primaryCta}
        </Button>
        <Button href="/field-notes/" size="xl" variant="outline">
          {COPY.hero.secondaryCta}
        </Button>
      </div>
      <p class="hero__tagline">{COPY.hero.tagline}</p>
    </div>

    <Image
      class="hero__portrait"
      src={portrait}
      alt={COPY.hero.portraitAlt}
      width={400}
      height={460}
      loading="eager"
      decoding="async"
    />
  </div>
</section>

<style>
  .hero { background: var(--cream); }

  .hero__inner {
    width: 100%;
    max-width: var(--max-page);
    margin: 0 auto;
    padding: 104px var(--gutter-desktop) 72px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 400px;
    gap: 88px;
    align-items: center;
  }

  .hero__copy {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .hero__eyebrow--mobile { display: none; }

  h1 {
    max-width: 17ch;
    margin: 0;
    color: var(--ink);
    font-size: var(--text-hero);
    font-weight: 700;
    line-height: var(--lh-tight);
    letter-spacing: var(--tracking-hero);
    text-wrap: pretty;
  }

  .hero__body {
    max-width: 54ch;
    margin: 0;
    color: var(--ink);
    font-size: var(--text-lead);
    line-height: var(--lh-body);
    text-wrap: pretty;
  }

  .hero__actions {
    padding-top: 4px;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
  }

  .hero__tagline {
    margin: 0;
    color: var(--ink-muted);
    font-size: var(--text-ui-s);
    line-height: var(--lh-ui);
  }

  .hero__portrait {
    width: 400px;
    height: 460px;
    display: block;
    object-fit: cover;
    border: 1px solid var(--rule);
    border-radius: var(--radius-xl);
  }

  @media (max-width: 767.98px) {
    .hero__inner {
      padding: 40px var(--gutter-mobile) 32px;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 20px;
    }

    .hero__copy { display: contents; }
    .hero__eyebrow { order: 1; }
    .hero__eyebrow--desktop { display: none; }
    .hero__eyebrow--mobile { display: inline; }
    h1 { order: 2; max-width: none; font-size: 34px; line-height: 1.1; letter-spacing: -0.028em; }
    .hero__portrait { order: 3; width: 190px; height: 190px; }
    .hero__body { order: 4; max-width: none; font-size: 17px; }
    .hero__actions { order: 5; padding-top: 0; display: block; }
    .hero__actions :global(.button) { width: 100%; }
    .hero__actions :global(.button--outline) { display: none; }
    .hero__tagline { order: 6; }
  }
</style>
