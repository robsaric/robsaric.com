---
import { Image } from 'astro:assets';
/* The homepage carries the Caretrics polo portrait (2026-08-23): eye-level,
   natural light, one brand cue, no lanyard. The Jane Summit photo it replaced
   stays in the repo for an event context; the studio portrait stays on /about/. */
import portrait from '../assets/images/rob-portrait-caretrics.png';
import { COPY } from '../data/copy';
import { SITE } from '../data/site';
import Button from './Button.astro';
import Eyebrow from './Eyebrow.astro';
---

<section class="hero">
  <div class="hero__inner">
    <div class="hero__copy">
      <Eyebrow class="hero__eyebrow hero__eyebrow--desktop">
        {COPY.hero.eyebrowDesktop}
      </Eyebrow>
      <Eyebrow class="hero__eyebrow hero__eyebrow--mobile">
        {COPY.hero.eyebrowMobile}
      </Eyebrow>
      <h1>{COPY.hero.heading}</h1>
      <div class="hero__body">
        <p>{COPY.hero.bodyIntro}</p>
        <p>{COPY.hero.bodyOutcome}</p>
      </div>
      <div class="hero__actions">
        <Button
          href={SITE.caretricsProductUrl}
          size="xl"
          icon="arrow-right"
          external
        >
          {COPY.hero.primaryCta}
        </Button>
        <Button href="/field-notes/" size="xl" variant="outline">
          {COPY.hero.secondaryCta}
        </Button>
        <a class="hero__notes-link" href="/field-notes/">
          {COPY.hero.secondaryCtaMobile}
        </a>
      </div>
      <p class="hero__tagline">{COPY.hero.tagline}</p>
    </div>

    <div class="hero__portrait-frame">
      <span class="hero__portrait-offset" aria-hidden="true"></span>
      <Image
        class="hero__portrait"
        src={portrait}
        alt={COPY.hero.portraitAlt}
        width={400}
        height={460}
        densities={[1, 2]}
        loading="eager"
        decoding="async"
      />
    </div>
  </div>
</section>

<style>
  .hero { background: var(--cream); }

  .hero__inner {
    width: 100%;
    max-width: var(--max-page);
    margin: 0 auto;
    padding: 104px var(--gutter-desktop) 72px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 400px;
    gap: 88px;
    align-items: center;
  }

  .hero__copy {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .hero__eyebrow--mobile { display: none; }

  h1 {
    max-width: 17ch;
    margin: 0;
    color: var(--ink);
    font-size: var(--text-hero);
    font-weight: 700;
    line-height: var(--lh-tight);
    letter-spacing: var(--tracking-hero);
    text-wrap: pretty;
  }

  .hero__body {
    max-width: 54ch;
    display: flex;
    flex-direction: column;
    gap: 14px;
    font-size: var(--text-lead);
    line-height: var(--lh-body);
  }

  .hero__body p {
    margin: 0;
    color: var(--ink);
    text-wrap: pretty;
  }

  .hero__notes-link {
    min-height: var(--tap-min);
    display: none;
    align-items: center;
    align-self: flex-start;
    font-size: 16px;
    font-weight: 600;
  }

  .hero__actions {
    padding-top: 4px;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
  }

  .hero__tagline {
    margin: 0;
    color: var(--ink-muted);
    font-size: var(--text-ui-s);
    line-height: var(--lh-ui);
  }

  /* The site's signature photo treatment (the /about/ header grammar): a lime
     offset card behind the portrait. Lime as a surface on cream, never text. */
  .hero__portrait-frame {
    position: relative;
    width: 400px;
    height: 460px;
  }

  .hero__portrait-offset {
    position: absolute;
    left: -14px;
    bottom: -14px;
    width: 100%;
    height: 100%;
    background: var(--lime-500);
    border-radius: var(--radius-xl);
  }

  .hero__portrait {
    position: relative;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    border: 1px solid var(--rule);
    border-radius: var(--radius-xl);
  }

  /* One staggered entrance on first paint, opacity and transform only so
     nothing shifts layout. tokens.css kills all animation under
     prefers-reduced-motion, so the reduced case needs nothing extra here. */
  @keyframes hero-rise {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: none; }
  }

  .hero__eyebrow,
  h1,
  .hero__body,
  .hero__actions,
  .hero__tagline,
  .hero__portrait-frame {
    animation: hero-rise 0.6s var(--ease-out) both;
  }

  h1 { animation-delay: 60ms; }
  .hero__body { animation-delay: 120ms; }
  .hero__portrait-frame { animation-delay: 120ms; }
  .hero__actions { animation-delay: 180ms; }
  .hero__tagline { animation-delay: 240ms; }

  @media (min-width: 768px) and (max-width: 1149.98px) {
    .hero__inner {
      padding-top: 72px;
      grid-template-columns: minmax(0, 1fr) 280px;
      gap: 48px;
    }

    .hero__portrait-frame { width: 100%; height: 340px; }
  }

  @media (max-width: 767.98px) {
    .hero__inner {
      padding: 40px var(--gutter-mobile) 32px;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 20px;
    }

    .hero__copy { display: contents; }
    .hero__eyebrow { order: 1; }
    .hero__eyebrow--desktop { display: none; }
    .hero__eyebrow--mobile { display: inline; }
    h1 { order: 2; max-width: none; font-size: 34px; line-height: 1.1; letter-spacing: -0.028em; }
    .hero__body { order: 3; max-width: none; gap: 12px; font-size: 17px; }
    .hero__actions {
      order: 4;
      padding-top: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 4px;
    }
    .hero__actions :global(.button) { width: 100%; }
    .hero__actions :global(.button--outline) { display: none; }
    .hero__notes-link { display: inline-flex; }
    .hero__portrait-frame { order: 5; width: 190px; height: 190px; }
    .hero__portrait-offset { left: -10px; bottom: -10px; }
    .hero__tagline { order: 6; }
  }
</style>
