---
import Arrow from './Arrow.astro';
import { QUICK_START as Q, START_CONTEXT } from '../data/toolbox-start';
interface Props {
  kind: keyof typeof START_CONTEXT;
  name: string;
  prompt: string;
  methodHref: string;
  kit?: boolean;
}
const {kind, name, prompt, methodHref, kit = false} = Astro.props;
const context = START_CONTEXT[kind];
const markerIndex = prompt.indexOf(context.marker);
if (markerIndex < 0) throw new Error(`Missing starting context in ${name}`);
const instructions = prompt.slice(0, markerIndex).trim();
const base = `/downloads/${name}`;
---
<section id="prompt" class="quick-start" aria-labelledby="quick-start-title">
  <div class="quick-heading"><h2 id="quick-start-title">{Q.heading}</h2><p>{context.result}</p></div>
  <div class="quick-columns">
    <div data-quick-prompt data-marker={context.marker} data-copied={Q.copied} data-fallback={Q.fallback}>
      <p>{kit ? Q.kitIntro : Q.intro}</p>
      <div class="quick-actions"><button class="action" type="button" data-copy-quick hidden>{Q.copy}</button><a class="text-link" href={`${base}/chat-prompt.txt`} download>{Q.promptFile}</a></div>
      <p class="copy-status" role="status" aria-live="polite" aria-atomic="true"></p>
      <div data-copy-fallback hidden><label for={`${name}-prepared`}>{Q.prepared}</label><textarea id={`${name}-prepared`} readonly rows="12"></textarea></div>
      <fieldset><legend>{Q.context}</legend>
        <div class:list={['context-fields', { 'single-field': context.fields.length === 1 }]}>
          {context.fields.map((field, index) => <div>
            <label for={`${name}-context-${index}`}>{field.label}</label>
            <textarea id={`${name}-context-${index}`} data-context-key={field.key} rows={context.fields.length === 1 ? 4 : 2} placeholder={field.hint} autocomplete="off" spellcheck="true"></textarea>
          </div>)}
        </div>
      </fieldset>
      <p class="privacy">{Q.privacy}</p>
      <details class="prompt-instructions"><summary>{Q.instructions}</summary><pre data-instructions>{instructions}</pre></details>
      <noscript><p>{Q.noScript}</p></noscript>
    </div>
    <aside class="quick-download" aria-labelledby="quick-skill-title">
      <h3 id="quick-skill-title">{Q.reuse}</h3>
      <code>{name}</code>
      <p>{kit ? Q.kit : Q.archive}</p>
      <a class="action" href={`${base}/${name}${kit ? '-kit' : ''}.zip`} download>{kit ? Q.kitZip : Q.skillZip}<Arrow /></a>
      <a class="text-link" href="#downloads">{Q.setup}<Arrow /></a>
      <a class="text-link" href={`${base}/${name}/SKILL.md`}>{Q.source}</a>
      <a class="text-link method-link" href={methodHref}>{Q.more}<Arrow /></a>
    </aside>
  </div>
</section>
<script>
  import { assemblePrompt } from '../lib/toolbox-prompt';
  document.querySelectorAll<HTMLElement>('[data-quick-prompt]').forEach(panel => {
    const button = panel.querySelector<HTMLButtonElement>('[data-copy-quick]');
    const instructions = panel.querySelector<HTMLElement>('[data-instructions]');
    const status = panel.querySelector<HTMLElement>('.copy-status');
    const fallback = panel.querySelector<HTMLElement>('[data-copy-fallback]');
    const output = fallback?.querySelector<HTMLTextAreaElement>('textarea');
    if (!button || !instructions || !status || !fallback || !output) return;
    button.hidden = false;
    button.addEventListener('click', async () => {
      const fields = Array.from(panel.querySelectorAll<HTMLTextAreaElement>('[data-context-key]')).map(field => ({key: field.dataset.contextKey ?? '', value: field.value}));
      const text = assemblePrompt(instructions.textContent ?? '', panel.dataset.marker ?? '', fields);
      status.textContent = '';
      try {
        if (!navigator.clipboard?.writeText) throw new Error('Clipboard unavailable');
        await navigator.clipboard.writeText(text);
        fallback.hidden = true;
        status.textContent = panel.dataset.copied ?? '';
      } catch {
        output.value = text;
        fallback.hidden = false;
        output.focus(); output.select();
        status.textContent = panel.dataset.fallback ?? '';
      }
    });
  });
</script>
<style>
  .quick-start { padding-block:32px 44px; border-block:1px solid var(--rule); scroll-margin-top:24px; }
  .quick-heading { margin-bottom:24px; }
  h2 { font:400 clamp(1.9rem,3vw,2.5rem)/1.2 var(--font-display); margin:0 0 10px; }
  p { font-size:16px; line-height:1.65; margin:0 0 20px; max-width:72ch; }
  .quick-heading p { margin:0; }
  .quick-columns { display:grid; grid-template-columns:minmax(0,1.8fr) minmax(250px,1fr); gap:clamp(32px,5vw,64px); }
  fieldset { padding:0; margin:0; border:0; min-width:0; }
  legend { font-size:14px; color:var(--ink-muted); margin-bottom:12px; }
  .context-fields { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:16px; }
  .single-field { grid-template-columns:1fr; }
  label { display:block; font-size:14px; font-weight:600; margin-bottom:8px; }
  .quick-start textarea { display:block; width:100%; min-height:88px; max-height:none; padding:12px; resize:vertical; border:1px solid var(--rule); border-radius:4px; color:var(--ink); background:var(--paper); font:400 16px/1.5 var(--font-sans); }
  textarea::placeholder { color:var(--ink-muted); opacity:1; }
  .privacy { font-size:13px; color:var(--ink-muted); margin:14px 0; }
  .quick-actions { display:flex; align-items:center; flex-wrap:wrap; gap:12px 20px; }
  .text-link { display:inline-flex; min-height:44px; align-items:center; font-size:14px; }
  .copy-status { margin:8px 0; font-size:14px; }
  .prompt-instructions { margin-top:16px; border-top:1px solid var(--rule); }
  summary { padding-block:14px; min-height:44px; font-size:14px; cursor:pointer; }
  pre { white-space:pre-wrap; overflow-wrap:anywhere; font:400 15px/1.7 var(--font-sans); margin:4px 0 20px; }
  .quick-download { border-left:1px solid var(--rule); padding-left:28px; }
  h3 { font:400 27px/1.2 var(--font-display); margin:0 0 12px; }
  code { font-size:13px; overflow-wrap:anywhere; }
  .quick-download p { font-size:14px; margin:14px 0 20px; }
  .quick-download .text-link { display:flex; width:fit-content; }
  .quick-download .action { margin-bottom:10px; }
  .method-link { margin-top:20px; }
  @media(max-width:1000px) { .quick-columns { grid-template-columns:minmax(0,1fr); gap:24px; } .quick-download { border-left:0; border-top:1px solid var(--rule); padding:24px 0 0; } }
  @media(max-width:600px) { .context-fields { grid-template-columns:minmax(0,1fr); } .quick-start { padding-block:28px; } }
</style>
