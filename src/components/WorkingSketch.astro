---
import { EDITORIAL as E } from '../data/editorial';
---
<section class="working" aria-labelledby="working-title">
  <div class="wrap working-layout">
    <div class="working-intro"><h2 id="working-title">{E.process.heading}</h2><p>{E.process.intro}</p></div>
    <div class="sketch" data-sketch>
      <div class="sketch-controls" aria-label={E.process.staticCaption}>
        {E.process.steps.map((step, index) => <button type="button" aria-pressed={index === 0} aria-controls={`sketch-panel-${index}`} data-step={index}>{step.label}</button>)}
      </div>
      <svg class="sketch-line" viewBox="0 0 600 64" fill="none" aria-hidden="true">
        <path class="thread" d="M20 34C65 10 98 58 146 34S234 10 282 34 370 58 418 34 505 10 566 34" stroke="currentColor" stroke-width="2" pathLength="1" />
        <path d="m550 20 18 14-20 10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <div class="sketch-panels">
        {E.process.steps.map((step, index) => <div id={`sketch-panel-${index}`} class="sketch-panel" data-panel={index}>
          <h3>{step.title}</h3><p>{step.text}</p><p class="sketch-note">{step.note}</p>
        </div>)}
      </div>
      <p class="sketch-caption"><span class="enhanced-caption">{E.process.caption}</span><span class="static-caption">{E.process.staticCaption}</span></p>
    </div>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-sketch]').forEach(root => {
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-step]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-panel]'));
    const select = (index: number, animate = false) => {
      buttons.forEach((button, i) => button.setAttribute('aria-pressed', String(index === i)));
      panels.forEach((panel, i) => { panel.hidden = i !== index; });
      if (animate && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        panels[index]?.animate([{ opacity: .5, transform: 'translateY(6px)' }, { opacity: 1, transform: 'translateY(0)' }], { duration: 320, easing: 'cubic-bezier(.16,1,.3,1)' });
        root.querySelector('.thread')?.animate([{ strokeDashoffset: 1 }, { strokeDashoffset: 0 }], { duration: 650, easing: 'cubic-bezier(.16,1,.3,1)' });
      }
    };
    select(0);
    root.dataset.enhanced = 'true';
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(entries => {
        if (!entries.some(entry => entry.isIntersecting)) return;
        root.querySelector('.thread')?.animate([{ strokeDashoffset: 1 }, { strokeDashoffset: 0 }], { duration: 1100, easing: 'cubic-bezier(.16,1,.3,1)' });
        observer.disconnect();
      }, { threshold: .4 });
      observer.observe(root);
    }
    buttons.forEach((button, index) => button.addEventListener('click', () => select(index, true)));
  });
</script>
<style>
.working { background: var(--blue); color: var(--white); padding: 88px 0; }
.working-layout { display: grid; grid-template-columns: .85fr 1.15fr; gap: clamp(48px, 8vw, 120px); align-items: center; }
.working-intro h2 { font-size: clamp(2.6rem, 4.8vw, 4.75rem); max-width: 9ch; margin: 0 0 28px; }
.working-intro p { max-width: 34ch; color: var(--on-dark-78); font-size: 18px; line-height: 1.7; margin: 0; }
.sketch { padding-top: 8px; }
.sketch-controls { display: none; justify-content: space-between; gap: 12px; }
[data-enhanced] .sketch-controls { display: flex; }
button { padding: 12px 18px; min-height: 48px; border: 1px solid var(--on-dark-28); border-radius: 100px; color: var(--white); background: transparent; cursor: pointer; font-size: 16px; font-weight: 600; transition: background 200ms, color 200ms; }
button:hover { border-color: var(--white); }
button[aria-pressed="true"] { background: var(--yellow); color: var(--ink); border-color: var(--yellow); }
button:focus-visible { outline-color: var(--yellow); outline-offset: 5px; }
.sketch-line { width: 100%; height: 68px; margin: 12px 0 22px; color: var(--yellow); overflow: visible; }
.thread { stroke-dasharray: 1; }
.sketch-panels { min-height: 215px; }
.sketch-panel h3 { font-size: 30px; margin: 0 0 16px; }
.sketch-panel p { max-width: 45ch; font-size: 18px; line-height: 1.65; margin: 0; }
.sketch-panel .sketch-note { margin: 22px 0 0; color: var(--yellow); font-size: 15px; }
.sketch-panel + .sketch-panel { margin-top: 28px; }
[data-enhanced] .sketch-panel { margin-top: 0; }
.sketch-caption { margin: 28px 0 0; font-size: 13px; color: var(--on-dark-78); border-top: 1px solid var(--on-dark-28); padding-top: 16px; }
.enhanced-caption { display: none; }
[data-enhanced] .enhanced-caption { display: inline; }
[data-enhanced] .static-caption { display: none; }
@media (max-width: 767.98px) {
  .working { padding: 56px 0; }
  .working-layout { grid-template-columns: minmax(0, 1fr); gap: 40px; }
  .working-intro h2 { max-width: 12ch; }
  .working-intro p { max-width: none; font-size: 17px; }
  button { padding: 11px 15px; font-size: 15px; }
  .sketch-panel h3 { font-size: 26px; }
  .sketch-panel p { font-size: 17px; }
  .sketch-panels { min-height: 235px; }
}
</style>
