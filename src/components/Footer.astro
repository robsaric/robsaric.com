---
import { SITE } from '../data/site';
import { UI } from '../data/ui';
import { EDITORIAL as E } from '../data/editorial';
import Arrow from './Arrow.astro';
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-top"><a class="footer-name" href="/">{SITE.name}</a><p>{E.footer.line}</p></div>
    <nav aria-label={UI.footer.navigationLabel}>
      <a href="/field-notes/">{E.writing.pageTitle}</a>
      <a href="/about/">{E.about.title}</a>
      <a href="/contact/">{E.connect.email}</a>
      <a href={SITE.links.linkedin} target="_blank" rel="noopener">{UI.footer.linkedin}<Arrow diagonal /></a>
      <a href="/rss.xml">{UI.footer.rss}</a>
    </nav>
    <div class="footer-bottom">
      <div><a href="/archive/">{E.footer.archive}</a><a href="/principles/">{E.footer.principles}</a><a href={SITE.links.source} target="_blank" rel="noopener">{E.footer.source}</a></div>
    </div>
  </div>
</footer>
<style>
.site-footer { background: var(--ink); color: var(--paper); padding: 56px 0 28px; }
.footer-top { display: flex; align-items: baseline; justify-content: space-between; gap: 24px; }
.footer-name { font: 700 32px/1.2 var(--font-display); letter-spacing: -.035em; text-decoration: none; }
.footer-top p { font-size: 20px; margin: 0; color: var(--on-dark-78); }
nav { display: flex; flex-wrap: wrap; gap: 12px 32px; padding: 32px 0 44px; }
a { color: var(--paper); display: inline-flex; align-items: center; gap: 8px; min-height: 44px; }
a:hover { color: var(--yellow); }
a:focus-visible { outline-color: var(--yellow); }
nav a { text-decoration: none; min-width: var(--tap-min); }
.footer-bottom { border-top: 1px solid var(--on-dark-28); padding-top: 20px; display: flex; justify-content: space-between; align-items: center; gap: 16px; font-size: 13px; color: var(--on-dark-78); }
.footer-bottom div { display: flex; gap: 24px; flex-wrap: wrap; }
.footer-bottom a { color: inherit; }
@media (max-width: 767.98px) {
  .footer-top, .footer-bottom { align-items: flex-start; flex-direction: column; gap: 12px; }
  nav { gap: 4px 24px; padding: 24px 0; }
  .footer-bottom div { gap: 4px 20px; }
}
</style>
