---
import Arrow from './Arrow.astro';
import DashboardSketch from './DashboardSketch.astro';
import { EDITORIAL as E } from '../data/editorial';
import { formatNoteDate } from '../lib/notes';
import type { ReadingItem } from '../lib/editorial';
interface Props { item: ReadingItem; compact?: boolean; }
const { item, compact = false } = Astro.props;
---
<article class:list={['featured-essay', { compact }]}>
  <div class="featured-copy">
    <h3><a href={item.href}>{item.title}</a></h3>
    <p>{item.summary}</p>
    <a class="text-link" href={item.href}>{E.writing.readEssay}<Arrow /></a>
    <time datetime={item.date.toISOString()}>{formatNoteDate(item.date)}</time>
  </div>
  <DashboardSketch compact={compact} />
</article>
<style>
.featured-essay { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1.1fr); gap: clamp(32px,5vw,72px); align-items: center; padding-block: 32px 44px; border-top: 1px solid var(--rule); }
.featured-essay.compact { align-items: start; padding-block: 24px 32px; gap: clamp(24px,4vw,56px); }
h3 { font-size: clamp(30px,3.2vw,46px); line-height: 1.15; margin: 0; max-width: 18ch; }
h3 a { color: var(--ink); text-decoration: none; }
h3 a:hover { color: var(--blue); }
p { font-size: 18px; line-height: 1.65; max-width: 42ch; margin: 20px 0; color: var(--ink-muted); }
.text-link { font-size: 15px; }
time { display: block; margin-top: 18px; font-size: 12px; color: var(--ink-muted); font-variant-numeric: tabular-nums; }
@media (max-width: 1050px) {
 .featured-essay { gap: 28px; grid-template-columns: minmax(0,1fr) minmax(0,1.15fr); }
 p { font-size: 16px; }
}
@media (max-width: 767.98px) {
 .featured-essay { grid-template-columns: minmax(0,1fr); padding-block: 24px 28px; gap: 24px; }
 h3 { font-size: 32px; max-width: 22ch; }
 p { margin-block: 16px 12px; }
 time { margin-top: 10px; }
 .featured-essay.compact { padding-block: 20px 24px; gap: 20px; }
}
</style>
