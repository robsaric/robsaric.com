---
import Eyebrow from './Eyebrow.astro';
import { COPY } from '../data/copy';
import { NOW_ITEMS, SHOW_DRAFTS } from '../data/now';

const items = NOW_ITEMS.filter((item) => SHOW_DRAFTS || !item.draft).slice(0, 3);
---

{items.length > 0 && (
  <section class="now" aria-labelledby="now-heading">
    <div class="now__inner">
      <h2 id="now-heading" class="visually-hidden">{COPY.now.heading}</h2>
      <div class="now__grid" style={`--now-count: ${items.length}`}>
        {items.map((item) => (
          <a class="now__item" href={item.href}>
            <Eyebrow>{item.kicker}</Eyebrow>
            <span class="now__title">{item.title}</span>
            <span class="now__blurb">{item.blurb}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .now { background: var(--cream); }

  .now__inner {
    width: 100%;
    max-width: var(--max-page);
    margin: 0 auto;
    padding: 0 var(--gutter-desktop) 88px;
  }

  /* Columns follow the visible item count: no empty desktop columns while
     the two draft slots stay hidden in production. */
  .now__grid {
    padding-top: 28px;
    display: grid;
    grid-template-columns: repeat(var(--now-count, 3), minmax(0, 1fr));
    gap: 40px;
    border-top: 1px solid var(--rule);
  }

  .now__item {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    color: var(--ink);
    text-decoration: none;
  }

  .now__item:hover { text-decoration: none; }
  .now__item:focus-visible { outline-offset: 4px; }

  .now__title {
    color: var(--ink);
    font-size: 19px;
    font-weight: 600;
    line-height: 1.4;
    text-wrap: pretty;
  }

  .now__blurb {
    max-width: 62ch;
    color: var(--ink-muted);
    font-size: 16px;
    line-height: 1.55;
    text-wrap: pretty;
  }

  @media (max-width: 767.98px) {
    .now__inner { padding: 0 var(--gutter-mobile) 40px; }

    .now__grid {
      padding-top: 0;
      grid-template-columns: minmax(0, 1fr);
      gap: 18px;
      border-top: 0;
    }

    .now__item {
      min-height: var(--tap-min);
      padding-top: 16px;
      gap: 6px;
      border-top: 1px solid var(--rule);
    }

    .now__title { font-size: 18px; }
    .now__blurb { display: none; }
  }
</style>
