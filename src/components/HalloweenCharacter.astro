---
import { HALLOWEEN as H } from '../data/hero-scenes';
import '../styles/halloween-character.css';
---
<div class="halloween-character" data-halloween data-pause-label={H.pause} data-resume-label={H.resume}>
  <div class="halloween-stage" role="img" aria-label={H.description}>
    <div class="halloween-wizard" data-wizard aria-hidden="true"></div>
    <div class="halloween-flight" aria-hidden="true">
      {H.brands.map((brand, i) => <div class:list={['spell-tile', 'spell-brand', `spell-tile--${i}`]} data-spell={i}>
        <img src={`/illustrations/halloween/${brand.asset}`} width="30" height="30" alt="" />
        <span>{brand.name}</span>
      </div>)}
      <div class="spell-tile spell-picture spell-tile--3" data-spell="3">
        <svg viewBox="0 0 60 48" fill="none"><circle cx="44" cy="12" r="6" fill="currentColor" opacity=".2"/><path d="m4 39 17-22 12 15 8-10 15 17Z" fill="currentColor" opacity=".15"/><path d="m4 39 17-22 12 15 8-10 15 17M4 41h52" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
      </div>
      <div class="spell-tile spell-picture spell-tile--4" data-spell="4">
        <svg viewBox="0 0 60 48" fill="none"><path d="M14 37c-10-4-9-23 1-26 4-2 8 0 11 0s7-2 11 0c12 3 13 22 1 27-6 3-17 2-24-1Z" fill="currentColor" opacity=".12"/><path d="M26 11c-2-6 2-8 5-8M26 11c-11-3-17 3-17 14s7 15 17 14c11 2 19-4 19-14S38 9 26 11Zm0 0c-7 6-8 21 0 28m1-28c9 6 10 21 0 28M17 23l4-4 3 4m6 0 3-4 4 4m-17 6c4 4 10 4 14 0" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      <svg class="wand-spark" data-spark viewBox="0 0 24 24"><path d="M12 2v5m0 10v5M2 12h5m10 0h5M5 5l3 3m8 8 3 3M5 19l3-3m8-8 3-3" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linecap="round"/></svg>
    </div>
  </div>
  <div class="halloween-controls"><span>{H.caption}</span>
    <button class="halloween-toggle" data-halloween-toggle type="button" aria-label={H.pause} title={H.pause} hidden>
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path class="spell-pause" d="M5 3v10M11 3v10" stroke="currentColor" stroke-width="2"/><path class="spell-play" d="m5 3 8 5-8 5Z" fill="currentColor"/></svg>
    </button>
  </div>
</div>
<script>
  import { initializeHalloweenCharacters } from '../lib/halloween-character';
  // A development-only still is useful for reviewing the composed artwork.
  initializeHalloweenCharacters(import.meta.env.DEV && new URLSearchParams(location.search).get('motion') === 'still');
</script>
