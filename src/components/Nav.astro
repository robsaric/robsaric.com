---
import Button from './Button.astro';
import { SITE } from '../data/site';
import { UI } from '../data/ui';

const links = [
  { label: UI.nav.fieldNotes, href: '/field-notes/' },
  { label: UI.nav.principles, href: '/principles/' },
  { label: UI.nav.about, href: '/about/' },
];
---

<header class="site-nav">
  <div class="site-nav__inner">
    <a class="site-nav__wordmark" href="/" aria-label={UI.nav.wordmarkLabel}>
      {SITE.name}
    </a>

    <nav class="site-nav__desktop" aria-label={UI.nav.primaryLabel}>
      {links.map((link) => (
        <a class="site-nav__link" href={link.href}>{link.label}</a>
      ))}
      <Button href={SITE.caretricsUrl} icon="arrow-up-right" external>
        {UI.nav.caretrics}
      </Button>
    </nav>

    <div class="site-nav__mobile">
      <Button href={SITE.caretricsUrl} external>{UI.nav.caretrics}</Button>
      <details class="site-nav__menu" data-nav-menu>
        <summary
          aria-label={UI.nav.openMenu}
          aria-expanded="false"
          aria-controls="mobile-menu"
          data-open-label={UI.nav.openMenu}
          data-close-label={UI.nav.closeMenu}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" />
          </svg>
        </summary>
        <nav id="mobile-menu" class="site-nav__panel" aria-label={UI.nav.primaryLabel}>
          {links.map((link) => (
            <a class="site-nav__link" href={link.href}>{link.label}</a>
          ))}
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  const navMenus = document.querySelectorAll<HTMLDetailsElement>('[data-nav-menu]');

  navMenus.forEach((menu) => {
    if (menu.dataset.ready === 'true') return;
    menu.dataset.ready = 'true';

    const summary = menu.querySelector<HTMLElement>('summary');
    const links = menu.querySelectorAll<HTMLAnchorElement>('.site-nav__link');

    const syncMenuState = () => {
      if (!summary) return;
      summary.setAttribute('aria-expanded', String(menu.open));
      summary.setAttribute(
        'aria-label',
        menu.open
          ? summary.dataset.closeLabel ?? ''
          : summary.dataset.openLabel ?? '',
      );
    };

    menu.addEventListener('toggle', syncMenuState);
    links.forEach((link) => link.addEventListener('click', () => {
      menu.open = false;
    }));

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        summary?.focus();
      }
    });
  });
</script>

<style>
  .site-nav {
    position: sticky;
    z-index: 20;
    top: 0;
    height: var(--nav-h-desktop);
    background: var(--cream);
    border-bottom: 1px solid var(--rule);
  }

  .site-nav__inner {
    width: 100%;
    max-width: var(--max-page);
    height: 100%;
    margin: 0 auto;
    padding: 0 var(--gutter-desktop);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .site-nav__wordmark {
    color: var(--forest-500);
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.015em;
    text-decoration: none;
  }

  .site-nav__desktop {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .site-nav__link {
    min-height: var(--tap-min);
    display: inline-flex;
    align-items: center;
    color: var(--ink);
    font-size: var(--text-ui);
    font-weight: 500;
    text-decoration: none;
  }

  .site-nav__link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .site-nav__mobile { display: none; }

  @media (max-width: 767.98px) {
    .site-nav { height: var(--nav-h-mobile); }
    .site-nav__inner { padding-inline: var(--gutter-mobile); }
    .site-nav__wordmark { font-size: 16px; }
    .site-nav__desktop { display: none; }

    .site-nav__mobile {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .site-nav__menu > summary {
      width: var(--tap-min);
      height: var(--tap-min);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--forest-500);
      background: transparent;
      border: 0;
      list-style: none;
      cursor: pointer;
    }

    .site-nav__menu > summary::-webkit-details-marker { display: none; }

    .site-nav__menu > summary svg {
      width: 22px;
      height: 22px;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.75;
      stroke-linecap: round;
    }

    .site-nav__panel {
      position: absolute;
      top: 100%;
      left: 0;
      width: 100%;
      padding-inline: var(--gutter-mobile);
      background: var(--cream);
      border-bottom: 1px solid var(--rule);
    }

    .site-nav__panel .site-nav__link {
      width: 100%;
      border-top: 1px solid var(--rule);
    }
  }
</style>
