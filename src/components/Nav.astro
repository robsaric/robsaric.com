---
import { SITE } from '../data/site';
import { UI } from '../data/ui';
import { EDITORIAL } from '../data/editorial';
import Arrow from './Arrow.astro';
const links = [
  { label: UI.nav.fieldNotes, href: '/field-notes/' },
  { label: UI.nav.about, href: '/about/' },
  { label: UI.nav.work, href: '/building/' },
];
const current = (href: string) => Astro.url.pathname.startsWith(href);
---
<header class="site-nav">
  <div class="site-nav__inner">
    <a class="wordmark" href="/" aria-label={UI.nav.wordmarkLabel}>{SITE.name}<span aria-hidden="true">.</span></a>
    <nav class="desktop-nav" aria-label={UI.nav.primaryLabel}>
      {links.map(link => <a href={link.href} aria-current={current(link.href) ? 'page' : undefined}>{link.label}</a>)}
      <a class="nav-follow" href={SITE.links.linkedin} target="_blank" rel="noopener">{EDITORIAL.connect.follow}<Arrow diagonal /></a>
    </nav>
    <details class="mobile-menu" data-nav-menu>
      <summary aria-controls="mobile-menu" data-open-label={UI.nav.openMenu} data-close-label={UI.nav.closeMenu} aria-label={UI.nav.openMenu}>
        <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 8h18M3 16h18" stroke="currentColor" stroke-width="1.7" /></svg>
      </summary>
      <nav id="mobile-menu" aria-label={UI.nav.primaryLabel}>
        {links.map(link => <a href={link.href} aria-current={current(link.href) ? 'page' : undefined}>{link.label}</a>)}
        <a href={SITE.links.linkedin} target="_blank" rel="noopener">{EDITORIAL.connect.follow}<Arrow diagonal /></a>
        <a href="/contact/">{UI.nav.writeToMe}</a>
      </nav>
    </details>
  </div>
</header>
<script>
  document.querySelectorAll<HTMLDetailsElement>('[data-nav-menu]').forEach(menu => {
    const summary = menu.querySelector('summary');
    const sync = () => {
      summary?.setAttribute('aria-expanded', String(menu.open));
      summary?.setAttribute('aria-label', menu.open ? summary.dataset.closeLabel ?? '' : summary.dataset.openLabel ?? '');
    };
    sync();
    menu.addEventListener('toggle', sync);
    menu.querySelectorAll('a').forEach(link => link.addEventListener('click', () => { menu.open = false; }));
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && menu.open) { menu.open = false; summary?.focus(); }
    });
  });
</script>
<style>
.site-nav { position: relative; z-index: 20; border-bottom: 1px solid var(--rule); background: var(--paper); }
.site-nav__inner { max-width: var(--max-page); margin: auto; padding: 0 var(--gutter-desktop); height: var(--nav-h-desktop); display: flex; align-items: center; justify-content: space-between; gap: 24px; }
.wordmark { display: inline-flex; align-items: baseline; min-height: 44px; padding-block: 8px; font: 750 25px/1.1 var(--font-display); letter-spacing: -.04em; color: var(--ink); text-decoration: none; white-space: nowrap; }
.wordmark span { color: var(--blue); }
.desktop-nav { display: flex; align-items: center; gap: 32px; }
nav a { min-height: 44px; display: inline-flex; align-items: center; gap: 12px; color: var(--ink); text-decoration: none; font-size: 15px; font-weight: 500; }
nav a:hover, nav a[aria-current] { color: var(--blue); text-decoration: underline; text-underline-offset: 7px; }
nav .nav-follow { padding-left: 30px; border-left: 1px solid var(--rule); color: var(--blue); }
.mobile-menu { display: none; }
@media (max-width: 767.98px) {
  .site-nav__inner { height: var(--nav-h-mobile); }
  .desktop-nav { display: none; }
  .mobile-menu { display: block; }
  summary { width: 44px; height: 44px; display: grid; place-items: center; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  .mobile-menu nav { position: absolute; top: 100%; left: 0; right: 0; display: grid; padding: 12px 24px 24px; border-bottom: 1px solid var(--rule); background: var(--paper); box-shadow: var(--shadow-nav); }
  .mobile-menu nav a { padding: 12px 0; border-bottom: 1px solid var(--rule); }
  .mobile-menu[open] nav { animation: rs-panel-enter 200ms var(--ease-out); }
}
</style>
