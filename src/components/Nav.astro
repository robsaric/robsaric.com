---
import { SITE } from '../data/site';
import { UI } from '../data/ui';
import { EDITORIAL } from '../data/editorial';
import Arrow from './Arrow.astro';
import Wordmark from './Wordmark.astro';
const links = [
  { label: UI.nav.fieldNotes, href: '/writing/' },
  { label: UI.nav.about, href: '/about/' },
  { label: UI.nav.work, href: '/building/' },
];
const current = (href: string) => Astro.url.pathname.startsWith(href) || (href === '/writing/' && Astro.url.pathname.startsWith('/field-notes/'));
---
<header class="site-nav">
  <div class="site-nav__inner">
    <Wordmark />
    <nav class="desktop-nav" aria-label={UI.nav.primaryLabel}>
      {links.map(link => <a href={link.href} aria-current={current(link.href) ? 'page' : undefined}>{link.label}</a>)}
      <a class="nav-follow" href={SITE.links.linkedin} target="_blank" rel="noopener">{EDITORIAL.connect.follow}<Arrow diagonal /></a>
    </nav>
    <details class="mobile-menu" data-nav-menu>
      <summary aria-controls="mobile-menu" data-open-label={UI.nav.openMenu} data-close-label={UI.nav.closeMenu} aria-label={UI.nav.openMenu}>
        <span class="menu-label--open" aria-hidden="true">{UI.nav.menu}</span><span class="menu-label--close" aria-hidden="true">{UI.nav.close}</span>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path class="menu-stroke menu-stroke--one" d="M4 12h16" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /><path class="menu-stroke menu-stroke--two" d="M4 12h16" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /></svg>
      </summary>
      <nav id="mobile-menu" aria-label={UI.nav.primaryLabel}>
        <div class="mobile-menu__primary">{links.map(link => <a href={link.href} aria-current={current(link.href) ? 'page' : undefined}>{link.label}</a>)}</div>
        <div class="mobile-menu__secondary"><a href={SITE.links.linkedin} target="_blank" rel="noopener">{EDITORIAL.connect.follow}<Arrow diagonal /></a><a href="/contact/">{UI.nav.writeToMe}</a></div>
      </nav>
    </details>
  </div>
</header>
<script>
  document.querySelectorAll<HTMLDetailsElement>('[data-nav-menu]').forEach(menu => {
    const summary = menu.querySelector('summary');
    const sync = () => {
      summary?.setAttribute('aria-expanded', String(menu.open));
      summary?.setAttribute('aria-label', menu.open ? summary.dataset.closeLabel ?? '' : summary.dataset.openLabel ?? '');
    };
    sync();
    menu.addEventListener('toggle', sync);
    menu.querySelectorAll('a').forEach(link => link.addEventListener('click', () => { menu.open = false; }));
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && menu.open) { menu.open = false; summary?.focus(); }
    });
  });
</script>
<style>
.site-nav { position: relative; z-index: 20; border-bottom: 1px solid var(--rule); background: var(--paper); }
.site-nav__inner { max-width: var(--max-page); margin: auto; padding: 0 var(--gutter-desktop); height: var(--nav-h-desktop); display: flex; align-items: center; justify-content: space-between; gap: 24px; }
.desktop-nav { display: flex; align-items: center; gap: 32px; }
nav a { min-height: 44px; display: inline-flex; align-items: center; gap: 12px; color: var(--ink); text-decoration: none; font-size: 15px; font-weight: 500; }
nav a:hover, nav a[aria-current] { color: var(--blue); text-decoration: underline; text-underline-offset: 7px; }
nav .nav-follow { padding-left: 30px; border-left: 1px solid var(--rule); color: var(--blue); }
.mobile-menu { display: none; }
@media (max-width: 767.98px) {
  .site-nav__inner { height: var(--nav-h-mobile); }
  .desktop-nav { display: none; }
  .mobile-menu { display: block; }
  summary { min-width: 88px; min-height: 44px; display: flex; align-items: center; justify-content: flex-end; gap: 10px; padding: 8px 0 8px 8px; cursor: pointer; list-style: none; font-size: 15px; }
  summary::-webkit-details-marker { display: none; }
  .menu-label--close, .mobile-menu[open] .menu-label--open { display: none; }
  .mobile-menu[open] .menu-label--close { display: inline; }
  .menu-stroke { transform-origin: 12px 12px; transition: transform 180ms var(--ease-out); }
  .menu-stroke--one { transform: translateY(-4px); }
  .menu-stroke--two { transform: translateY(4px); }
  .mobile-menu[open] .menu-stroke--one { transform: rotate(45deg); }
  .mobile-menu[open] .menu-stroke--two { transform: rotate(-45deg); }
  .mobile-menu nav { position: absolute; top: 100%; left: 0; right: 0; padding: 12px 24px 20px; max-height: calc(100dvh - var(--nav-h-mobile)); overflow-y: auto; border-bottom: 1px solid var(--rule); background: var(--paper); box-shadow: var(--shadow-nav); }
  .mobile-menu__primary { display: grid; }
  .mobile-menu__primary a { padding: 10px 0; min-height: 56px; border-bottom: 1px solid var(--rule); font: 400 32px/1.2 var(--font-editorial); letter-spacing: -.02em; }
  .mobile-menu__primary a:last-child { border-bottom: 0; }
  .mobile-menu__secondary { display: flex; flex-wrap: wrap; gap: 4px 28px; margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--rule); }
  .mobile-menu__secondary a { padding-block: 8px; min-height: 44px; font-size: 16px; }
  .mobile-menu[open] nav { animation: rs-panel-enter 200ms var(--ease-out); }
}
@media (prefers-reduced-motion: reduce) {
  .menu-stroke { transition: none; }
  .mobile-menu[open] nav { animation: none; }
}
</style>
