---
import { GUIDE_PRESENTATION as G } from '../data/toolbox-presentation';
interface Props { rows: ReadonlyArray<{ input: string; output: string; decision: string }> }
const { rows } = Astro.props;
---
<section id="outputs" class="guide-outcomes">
  <h2>{G.heading}</h2>
  <table role="table">
    <thead role="rowgroup"><tr role="row">{G.columns.map(label => <th role="columnheader" scope="col">{label}</th>)}</tr></thead>
    <tbody role="rowgroup">{rows.map(row => <tr role="row">
      {[row.input, row.output, row.decision].map((text, i) => <td role="cell"><span aria-hidden="true">{G.columns[i]}</span>{text}</td>)}
    </tr>)}</tbody>
  </table>
</section>
<style>
.guide-outcomes { padding-block: 48px; scroll-margin-top: 28px; }
h2 { font-size: clamp(1.9rem,3vw,2.5rem); line-height: 1.2; margin: 0 0 24px; max-width: 32ch; }
table { width: 100%; border-collapse: collapse; table-layout: fixed; }
th { text-align: left; font: 500 14px/1.5 var(--font-sans); color: var(--ink-muted); padding: 16px 24px; }
td { vertical-align: top; font-size: 16px; line-height: 1.65; padding: 24px; border-top: 1px solid var(--rule); }
th:first-child { width: 28%; } th:last-child { width: 30%; }
th:nth-child(2),td:nth-child(2) { background: var(--paper-inset); }
td:first-child { font-weight: 600; }
td span { display: none; }
@media(max-width: 1000px) { th,td { padding:16px; } }
@media(max-width: 600px) {
  .guide-outcomes { padding-block:32px; }
  table,tbody,tr,td { display:block; width:100%; }
  thead { position:absolute; width:1px; height:1px; overflow:hidden; clip-path:inset(50%); }
  tr { border-top:1px solid var(--rule); padding-block:16px; }
  td { padding:8px 0; border:0; }
  td:nth-child(2) { background:transparent; }
  td span { display:block; color:var(--ink-muted); font-size:13px; font-weight:400; margin-bottom:4px; }
}
</style>
