---
import Arrow from './Arrow.astro';
import { PRINCIPLES } from '../data/principles';
---
<div class="beliefs">
  {PRINCIPLES.map(item => <section class="belief">
    <h2>{item.line}</h2>
    <div class="belief-detail"><p>{item.body}</p><p>{item.choice}</p><a class="text-link" href={item.href}>{item.link}<Arrow /></a></div>
  </section>)}
</div>
<style>
.belief { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1.2fr); gap: clamp(40px,7vw,100px); padding-block: 48px; border-top: 1px solid var(--rule); }
h2 { margin: 0; font-size: clamp(28px,3.1vw,42px); line-height: 1.2; max-width: 21ch; }
p { margin: 0 0 18px; font-size: 18px; line-height: 1.75; max-width: 58ch; }
.text-link { font-size: 14px; margin-top: 4px; }
.belief:first-child { padding-top: 0; border: 0; }
.belief:last-child { padding-bottom: 0; }
@media (max-width: 767.98px) {
 .belief { grid-template-columns: minmax(0,1fr); gap: 20px; padding-block: 32px; }
 h2 { font-size: 29px; }
 p { font-size: 17px; }
}
</style>
