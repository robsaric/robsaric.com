---
import Newsletter from './Newsletter.astro';

interface Props {
  id: string;
}

const { id } = Astro.props;
const endpoint = import.meta.env.PUBLIC_NEWSLETTER_ENDPOINT?.trim();
---
{endpoint && <div class="toolbox-newsletter">
  <Newsletter id={id} showLinkedIn />
</div>}

<style>
.toolbox-newsletter {
  min-width: 0;
  margin-top: 48px;
  padding: 32px;
  background: var(--paper-inset);
  border: 1px solid var(--rule);
  border-radius: 12px;
}
@media (max-width: 767.98px) {
  .toolbox-newsletter {
    margin-top: 32px;
    padding: 26px 22px;
  }
}
</style>
