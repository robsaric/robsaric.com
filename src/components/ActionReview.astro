---
import { ACTION_REVIEW as R } from '../data/dashboard-sketch';
---
<figure class="action-review">
  <div class="review-heading">{R.heading}</div>
  <table>
    <thead><tr>{R.columns.map(label => <th scope="col">{label}</th>)}</tr></thead>
    <tbody>{R.rows.map(row => <tr>
      <th scope="row">{row.status}</th>
      <td>{row.event}</td>
      <td>{row.next}</td>
    </tr>)}</tbody>
  </table>
  <figcaption>{R.caption}</figcaption>
</figure>
<style>
.action-review { margin: 40px 0; padding-block: 28px; border-block: 1px solid var(--ink); }
.review-heading { font: 700 24px/1.3 var(--font-display); letter-spacing: -.025em; max-width: 28ch; margin-bottom: 24px; }
table { width: 100%; border-collapse: collapse; font-size: 15px; line-height: 1.55; table-layout: fixed; }
th, td { padding: 16px 12px; text-align: left; vertical-align: top; border-bottom: 1px solid var(--rule); }
thead th { font-size: 12px; font-weight: 500; color: var(--ink-muted); padding-top: 0; }
thead th:first-child { width: 23%; }
thead th:nth-child(2) { width: 31%; }
tbody th { font-weight: 600; }
th:first-child { padding-left: 0; }
td:last-child { padding-right: 0; }
figcaption { font-size: 14px; line-height: 1.6; color: var(--ink-muted); margin-top: 20px; }
@media (max-width: 600px) {
 .review-heading { font-size: 23px; }
 table { font-size: 14px; }
 th, td { padding: 14px 7px; }
 thead th:first-child { width: 24%; }
 thead th:nth-child(2) { width: 29%; }
}
</style>
