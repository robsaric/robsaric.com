---
import { ACTION_REVIEW as R } from '../data/dashboard-sketch';
---
<figure class="action-review" id="see-what-happened-and-what-still-needs-you" aria-labelledby="review-heading">
  <span id="what-id-change" aria-hidden="true"></span>
  <h2 id="review-heading">{R.heading}</h2>
  <div class="column-labels" aria-hidden="true"><span>{R.statusLabel}</span><span>{R.eventLabel}</span><span>{R.nextLabel}</span></div>
  <ul class="review-entries" role="list">
    {R.rows.map(row => <li class="review-entry">
      <span class="record-status">{row.status}</span>
      <p class="record-event">{row.event}</p>
      <dl><dt>{R.nextLabel}</dt><dd>{row.next}</dd></dl>
    </li>)}
  </ul>
  <figcaption>{R.caption}</figcaption>
</figure>
<style>
.action-review { margin: 32px 0; padding-block: 24px 20px; border-block: 1px solid var(--ink); scroll-margin-top: 32px; }
.action-review h2 { margin: 0 0 24px; font: 750 24px/1.25 var(--font-display); letter-spacing: -.025em; max-width: 30ch; }
.column-labels, .review-entry { display: grid; grid-template-columns: 130px minmax(0,1fr) minmax(0,1.2fr); gap: 20px; }
.column-labels { font-size: 12px; line-height: 1.5; color: var(--ink-muted); padding-bottom: 10px; }
.action-review .review-entries { padding: 0; margin: 0; list-style: none; }
.action-review .review-entry { padding-block: 18px; border-top: 1px solid var(--rule); margin: 0; align-items: start; }
.record-status { justify-self: start; font-size: 13px; line-height: 1.5; font-weight: 650; background: var(--yellow); padding: 3px 7px; }
.action-review .record-event { font-size: 16px; line-height: 1.55; font-weight: 600; margin: 0; }
dl { margin: 0; }
dt { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
dd { font-size: 15px; line-height: 1.65; margin: 0; }
figcaption { font-size: 13px; line-height: 1.65; color: var(--ink-muted); margin-top: 12px; }
@media (max-width: 600px) {
 .action-review h2 { font-size: 22px; }
 .column-labels { display: none; }
 .action-review .review-entry { grid-template-columns: minmax(0,1fr); gap: 10px; padding-block: 18px; }
 dt { position: static; width: auto; height: auto; overflow: visible; clip-path: none; font-size: 12px; color: var(--ink-muted); margin-bottom: 3px; }
 dd { font-size: 16px; }
}
</style>
