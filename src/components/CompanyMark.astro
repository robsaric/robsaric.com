---
import caretrics from '../assets/brands/caretrics.svg';
import caretricsNight from '../assets/brands/caretrics-night.svg';
import togetheren from '../assets/brands/togetheren.svg?raw';

interface Props { company: 'caretrics' | 'togetheren' | 'skillnav' }
const { company } = Astro.props;
---
<span class:list={['company-mark', company]} aria-hidden="true">
  {company === 'caretrics' && <>
    <img class="day" src={caretrics.src} width="180" height="40" alt="" />
    <img class="night" src={caretricsNight.src} width="180" height="60" alt="" />
  </>}
  {company === 'togetheren' && <Fragment set:html={togetheren} />}
  {company === 'skillnav' && <svg viewBox="0 0 200 42" fill="none">
    <path d="M18 3v36M0 21h36M5.3 8.3l25.4 25.4M5.3 33.7L30.7 8.3" stroke="currentColor" stroke-width="1.4" />
    <text x="47" y="32" fill="currentColor" font-size="33" font-weight="700" letter-spacing="-1.3">skillnav<tspan>.</tspan></text>
  </svg>}
</span>

<style>
  .company-mark { display: flex; align-items: center; width: 190px; height: 60px; color: var(--ink); }
  .company-mark img { display: block; width: 100%; height: auto; }
  .company-mark :global(svg) { display: block; width: 100%; height: auto; }
  .togetheren { width: 200px; }
  .skillnav { width: 172px; height: 44px; }
  .skillnav text { font-family: var(--font-manrope), sans-serif; }
  .night { display: none !important; }
  :global(html[data-appearance="night"]) .day { display: none; }
  :global(html[data-appearance="night"]) .night { display: block !important; }
</style>
