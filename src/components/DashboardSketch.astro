---
import { REVIEW_LOOP as R } from '../data/review-loop.mjs';
import '../styles/review-loop.css';
interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
---
<figure class:list={['review-loop', { compact }]}>
  <div class="loop-heading">{R.heading}</div>
  <p class="loop-example">{R.example}</p>
  <div class="loop-track">
    <ol class="loop-steps">
      {R.steps.map((step, i) => <li>
        <span class="loop-number" aria-hidden="true">{i + 1}</span>
        <div><strong>{step.question}</strong><p>{step.detail}</p></div>
      </li>)}
    </ol>
    <span class="loop-return" aria-hidden="true"></span>
  </div>
  <figcaption class="loop-note">{R.note}</figcaption>
</figure>
