---
import { UI } from '../data/ui';
interface Props { id: string; }
const { id } = Astro.props;
---
<button id={id} class="appearance-control" type="button" role="switch" aria-checked="false" aria-label={UI.appearance.label} data-appearance-control hidden>
  <span class="appearance-day" aria-hidden="true">{UI.appearance.day}</span>
  <span class="appearance-track" aria-hidden="true"><span class="appearance-thumb"></span></span>
  <span class="appearance-night" aria-hidden="true">{UI.appearance.night}</span>
</button>
<script>
  import { APPEARANCE_KEY, resolveAppearance } from '../lib/appearance.mjs';
  const controls = [...document.querySelectorAll<HTMLButtonElement>('[data-appearance-control]')];
  const root = document.documentElement;
  const sync = () => controls.forEach(control => {
    control.setAttribute('aria-checked', String(root.dataset.appearance === 'night'));
    control.hidden = false;
  });
  controls.forEach(control => control.addEventListener('click', () => {
    const preference = root.dataset.appearance === 'night' ? 'day' : 'night';
    root.dataset.appearancePreference = preference;
    root.dataset.appearance = resolveAppearance(preference, new Date().getHours());
    try { localStorage.setItem(APPEARANCE_KEY, preference); } catch { /* The choice still works for this page. */ }
    sync();
    document.dispatchEvent(new Event('appearancechange'));
  }));
  window.addEventListener('pageshow', event => {
    if (!event.persisted) return;
    let preference = root.dataset.appearancePreference ?? 'auto';
    try { preference = localStorage.getItem(APPEARANCE_KEY) ?? 'auto'; } catch { /* Keep this page's choice. */ }
    if (!['day', 'night', 'auto'].includes(preference)) preference = 'auto';
    root.dataset.appearancePreference = preference;
    root.dataset.appearance = resolveAppearance(preference, new Date().getHours());
    sync();
    document.dispatchEvent(new Event('appearancechange'));
  });
  sync();
</script>
<style>
.appearance-control { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 44px; padding: 6px 2px; border: 0; background: transparent; color: var(--ink-muted); font: inherit; font-size: 13px; cursor: pointer; }
.appearance-control[hidden] { display: none; }
.appearance-track { display: block; width: 36px; height: 22px; padding: 3px; border-radius: 20px; background: var(--ink); }
.appearance-thumb { display: block; width: 16px; height: 16px; border-radius: 50%; background: var(--paper); transition: transform 160ms var(--ease-out); }
.appearance-control[aria-checked="true"] .appearance-thumb { transform: translateX(14px); }
.appearance-control[aria-checked="false"] .appearance-day,
.appearance-control[aria-checked="true"] .appearance-night { color: var(--ink); font-weight: 600; }
.appearance-control:hover .appearance-track { outline: 2px solid var(--control-border); outline-offset: 2px; }
.appearance-control:focus-visible { outline: 2px solid var(--ink); outline-offset: 4px; border-radius: 4px; }
@media (prefers-reduced-motion: reduce) { .appearance-thumb { transition: none; } }
</style>
