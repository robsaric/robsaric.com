---
import Section from './Section.astro';
import Button from './Button.astro';
import Eyebrow from './Eyebrow.astro';
import { COPY } from '../data/copy';
import { UI } from '../data/ui';
import {
  EVIDENCE_SIGNAL,
  EVIDENCE_STEPS,
} from '../data/evidence-steps';

const totalSteps = EVIDENCE_STEPS.length;
---

<Section
  id="evidence"
  number={COPY.evidence.number}
  label={COPY.evidence.label}
  tone="dark"
>
  <div class="evidence" data-evidence>
    <div class="evidence__intro">
      <h2>{COPY.evidence.heading}</h2>
      <p class="evidence__body evidence__body--desktop">
        {COPY.evidence.bodyDesktop}
      </p>
      <p class="evidence__body evidence__body--mobile">
        {COPY.evidence.bodyMobile}
      </p>
    </div>

    <div class="evidence__panel">
      <div class="evidence__signal">
        <Eyebrow onDark>{COPY.evidence.signalEyebrow}</Eyebrow>
        <span class="evidence__signal-line">{EVIDENCE_SIGNAL}</span>
      </div>

      <div class="evidence__rail">
        {EVIDENCE_STEPS.map((step, index) => (
          <button
            type="button"
            class="evidence__step"
            aria-label={step.label}
            aria-pressed={index === 0 ? 'true' : 'false'}
            data-step-index={index}
            data-complete={index === 0 ? 'true' : 'false'}
            data-counter={UI.evidence.stepCounter(index + 1, totalSteps)}
            data-action-label={
              index === totalSteps - 1
                ? UI.evidence.startAgain
                : UI.evidence.nextStep
            }
          >
            <span class="evidence__step-number">
              {String(index + 1).padStart(2, '0')}
            </span>
            <span class="evidence__step-label">{step.label}</span>
          </button>
        ))}
      </div>

      <div class="evidence__contents">
        {EVIDENCE_STEPS.map((step, index) => (
          <div
            class="evidence__step-content"
            data-step-content={index}
            hidden={index !== 0}
          >
            <Eyebrow class="evidence__kicker">{step.kicker}</Eyebrow>
            <p>{step.body}</p>
            <span class="evidence__source">{step.source}</span>
          </div>
        ))}
      </div>

      <div class="evidence__controls">
        <Button
          class="evidence__next"
          type="button"
          variant="lime"
          data-evidence-next
        >
          {UI.evidence.nextStep}
        </Button>
        <span class="evidence__counter" data-evidence-counter>
          {UI.evidence.stepCounter(1, totalSteps)}
        </span>
      </div>
    </div>
  </div>
</Section>

<script>
  const evidenceRoots =
    document.querySelectorAll<HTMLElement>('[data-evidence]');

  evidenceRoots.forEach((root) => {
    if (root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';

    const buttons = Array.from(
      root.querySelectorAll<HTMLButtonElement>('[data-step-index]'),
    );
    const contents = Array.from(
      root.querySelectorAll<HTMLElement>('[data-step-content]'),
    );
    const next = root.querySelector<HTMLButtonElement>('[data-evidence-next]');
    const counter =
      root.querySelector<HTMLElement>('[data-evidence-counter]');
    let active = 0;

    const selectStep = (index: number) => {
      active = index;

      buttons.forEach((button, buttonIndex) => {
        button.setAttribute(
          'aria-pressed',
          String(buttonIndex === active),
        );
        button.dataset.complete = String(buttonIndex <= active);
      });

      contents.forEach((content, contentIndex) => {
        content.hidden = contentIndex !== active;
      });

      const selected = buttons[active];
      if (counter) counter.textContent = selected?.dataset.counter ?? '';
      if (next) next.textContent = selected?.dataset.actionLabel ?? '';
    };

    buttons.forEach((button, index) => {
      button.addEventListener('click', () => selectStep(index));
    });

    next?.addEventListener('click', () => {
      selectStep((active + 1) % buttons.length);
    });
  });
</script>

<style>
  .evidence {
    display: grid;
    grid-template-columns: 400px minmax(0, 1fr);
    gap: 72px;
    align-items: start;
  }

  .evidence__intro {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  h2 {
    margin: 0;
    color: var(--on-dark);
    font-size: var(--text-h2);
    line-height: var(--lh-heading);
    letter-spacing: var(--tracking-h2);
    text-wrap: pretty;
  }

  .evidence__body {
    margin: 0;
    color: var(--on-dark);
    font-size: var(--text-body-l);
    line-height: var(--lh-body);
    text-wrap: pretty;
  }

  .evidence__body--mobile { display: none; }

  .evidence__panel {
    padding: 36px;
    display: flex;
    flex-direction: column;
    gap: 28px;
    background: var(--on-dark-05);
    border: 1px solid var(--on-dark-28);
    border-radius: var(--radius-lg);
  }

  .evidence__signal {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .evidence__signal-line {
    color: var(--on-dark);
    font-size: var(--text-signal);
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.015em;
  }

  .evidence__rail { display: flex; align-items: stretch; }

  .evidence__step {
    min-height: var(--tap-min);
    padding: 14px 12px 0 0;
    flex: 1;
    /* Without this the five steps refuse to shrink below their label text and
       push the whole page sideways. */
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    color: var(--on-dark-78);
    background: transparent;
    border: 0;
    border-top: 2px solid var(--on-dark-28);
    text-align: left;
    cursor: pointer;
  }

  .evidence__step[data-complete='true'] { border-top-color: var(--lime-500); }

  .evidence__step-number {
    color: var(--on-dark-78);
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.06em;
    font-variant-numeric: tabular-nums;
  }

  .evidence__step-label {
    color: var(--on-dark-78);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.3;
  }

  .evidence__step[aria-pressed='true'] .evidence__step-number {
    color: var(--lime-500);
  }

  .evidence__step[aria-pressed='true'] .evidence__step-label {
    color: var(--on-dark);
  }

  .evidence__step-content {
    min-height: 168px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .evidence__step-content[hidden] { display: none; }
  .evidence__kicker { color: var(--lime-500); }

  .evidence__step-content p {
    max-width: 56ch;
    margin: 0;
    color: var(--on-dark);
    font-size: 19px;
    line-height: var(--lh-body);
    text-wrap: pretty;
  }

  .evidence__source {
    padding-top: 12px;
    margin-top: auto;
    color: var(--on-dark-78);
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.5;
    border-top: 1px solid var(--on-dark-28);
  }

  .evidence__controls {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .evidence__counter {
    color: var(--on-dark-78);
    font-family: var(--font-mono);
    font-size: 13px;
  }

  @media (min-width: 768px) and (max-width: 1149.98px) {
    .evidence {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }
  }

  @media (max-width: 767.98px) {
    .evidence {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .evidence__intro { display: contents; }
    h2 { order: 1; font-size: 27px; line-height: 1.2; letter-spacing: -0.022em; }
    .evidence__body--desktop { display: none; }
    .evidence__body--mobile { order: 2; display: block; font-size: 17px; }
    .evidence__panel { order: 3; padding: 20px; gap: 18px; background: transparent; }
    .evidence__signal { gap: 8px; }
    .evidence__signal-line { font-size: 20px; }
    .evidence__rail { gap: 6px; }

    .evidence__step {
      padding: 10px 0 0;
      border-top-width: 3px;
    }

    .evidence__step-label { display: none; }
    .evidence__step-content { min-height: 210px; gap: 10px; }
    .evidence__step-content p { font-size: 17px; }
    .evidence__source { padding-top: 10px; }
    .evidence__next { width: 100%; }
    .evidence__counter { display: none; }
  }
</style>
