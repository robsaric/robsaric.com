---
import BaseLayout from './BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import { SITE } from '../data/site';
import { UI } from '../data/ui';
import '../styles/prose.css';

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  date: Date;
  publishedTime: Date;
  modifiedTime?: Date;
  notice?: string;
  /** Field notes carry the byline; archive posts stay as written. */
  showByline?: boolean;
  backHref: string;
  backLabel: string;
  jsonLd: Record<string, unknown>;
  /** Notes pass their generated share card; archive posts keep the default. */
  ogImage?: string;
  ogImageAlt?: string;
}

const {
  title,
  description,
  eyebrow,
  date,
  publishedTime,
  modifiedTime,
  notice,
  showByline = false,
  backHref,
  backLabel,
  jsonLd,
  ogImage,
  ogImageAlt,
} = Astro.props;

const dateFormat = new Intl.DateTimeFormat('en-CA', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
const formattedDate = dateFormat.format(date);
const formattedUpdated = modifiedTime ? dateFormat.format(modifiedTime) : undefined;
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={jsonLd}
  type="article"
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  ogImage={ogImage}
  ogImageAlt={ogImageAlt}
>
  <div class="article-shell">
    <article class="article">
      <header class="article__header">
        <Eyebrow>{eyebrow}</Eyebrow>
        <h1>{title}</h1>
        <p class="article__dates">
          <time datetime={date.toISOString()}>{formattedDate}</time>
          {formattedUpdated && modifiedTime && (
            <>
              {' · '}
              <time datetime={modifiedTime.toISOString()}>
                {UI.article.updated(formattedUpdated)}
              </time>
            </>
          )}
        </p>
        {showByline && (
          <p class="article__byline">
            {UI.article.bylineBefore}<a href="/about/">{SITE.author.name}</a>{UI.article.bylineAfter}
          </p>
        )}
        {notice && <p class="article__notice">{notice}</p>}
      </header>

      <div class="prose">
        <slot />
      </div>

      <footer class="article__footer">
        <a href={backHref}>{backLabel}</a>
      </footer>
    </article>
  </div>
</BaseLayout>

<style>
  .article-shell {
    width: 100%;
    max-width: var(--max-page);
    margin: 0 auto;
    padding: var(--section-pad-desktop) var(--gutter-desktop);
  }

  .article {
    width: 100%;
    max-width: 68ch;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .article__header {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  h1 {
    margin: 0;
    font-size: 48px;
    line-height: 1.1;
    letter-spacing: -0.028em;
    text-wrap: pretty;
  }

  .article__dates {
    margin: 0;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .article__byline {
    margin: 0;
    color: var(--ink-muted);
    font-size: 16px;
    line-height: 1.5;
  }

  .article__notice {
    margin: 0;
    padding-top: 16px;
    color: var(--ink-muted);
    font-size: 16px;
    line-height: 1.55;
    border-top: 1px solid var(--rule);
  }

  .article__footer {
    padding-top: 24px;
    border-top: 1px solid var(--rule);
  }

  .article__footer a {
    min-height: var(--tap-min);
    display: inline-flex;
    align-items: center;
    font-size: 16px;
    font-weight: 600;
  }

  @media (max-width: 767.98px) {
    .article-shell {
      padding: var(--section-pad-mobile) var(--gutter-mobile);
    }

    .article { gap: 32px; }
    .article__header { gap: 14px; }
    h1 { font-size: 34px; }
  }
</style>
