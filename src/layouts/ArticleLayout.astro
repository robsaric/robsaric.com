---
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import Arrow from '../components/Arrow.astro';
import ReadingList from '../components/ReadingList.astro';
import { SITE } from '../data/site';
import { UI } from '../data/ui';
import { EDITORIAL as E } from '../data/editorial';
import { getEarlierWriting } from '../lib/editorial';
import portrait from '../assets/images/rob-portrait.jpg';
import '../styles/prose.css';
interface Props {
  title: string; description: string; eyebrow: string;
  date: Date; publishedTime: Date; modifiedTime?: Date; notice?: string;
  showByline?: boolean; backHref: string; backLabel: string;
  jsonLd: Record<string, unknown>; ogImage?: string; ogImageAlt?: string;
}
const { title, description, date, publishedTime, modifiedTime, notice, showByline = false, backHref, backLabel, jsonLd, ogImage, ogImageAlt } = Astro.props;
const dateFormat = new Intl.DateTimeFormat('en-CA', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const related = (await getEarlierWriting()).filter(item => item.href !== Astro.url.pathname).slice(0,2);
---
<BaseLayout title={title} description={description} jsonLd={jsonLd} type="article" publishedTime={publishedTime} modifiedTime={modifiedTime} ogImage={ogImage} ogImageAlt={ogImageAlt}>
  <div class="wrap article-shell">
    <article>
      <header class="article-header">
        <h1>{title}</h1>
        <div class="article-meta"><time datetime={date.toISOString()}>{dateFormat.format(date)}</time>{modifiedTime && <time datetime={modifiedTime.toISOString()}>{UI.article.updated(dateFormat.format(modifiedTime))}</time>}{showByline && <a href="/about/">{SITE.name}</a>}</div>
        {notice && <p class="article-notice">{notice}</p>}
      </header>
      <div class="article-body">
        <aside class="author"><Image src={portrait} alt="" width={72} height={72} loading="lazy" fit="cover" position="top" /><a href="/about/">{SITE.name}</a><p>{E.article.authorDetail}</p><a class="author-follow" href={SITE.links.linkedin} target="_blank" rel="noopener">{UI.footer.linkedin}<Arrow diagonal /></a></aside>
        <div class="prose"><slot /></div>
      </div>
      <footer class="article-end">
        <a class="text-link" href={backHref}>{backLabel}<Arrow /></a>
        <div class="follow"><h2>{E.article.followHeading}</h2><p>{E.article.followBody}</p><a class="action" href={SITE.links.linkedin} target="_blank" rel="noopener">{E.connect.follow}<Arrow diagonal /></a></div>
      </footer>
    </article>
    <section class="related" aria-labelledby="related-title"><h2 id="related-title">{E.article.heading}</h2><ReadingList items={related} /></section>
  </div>
</BaseLayout>
<style>
.article-shell { padding-block: 72px 80px; }
.article-header { max-width: 1040px; margin-inline: auto; margin-bottom: 56px; }
h1 { font-size: clamp(2.5rem, 5vw, 4.5rem); line-height: 1.12; margin: 0 0 28px; font-weight: 800; }
.article-meta { display: flex; flex-wrap: wrap; gap: 10px 24px; font-size: 13px; color: var(--ink-muted); align-items: center; font-variant-numeric: tabular-nums; }
.article-meta a { min-height: 44px; display: inline-flex; align-items: center; }
.article-notice { margin: 24px 0 0; font-size: 16px; line-height: 1.65; color: var(--ink-muted); padding-top: 20px; border-top: 1px solid var(--rule); max-width: 70ch; }
.article-body { display: grid; grid-template-columns: 160px minmax(0, 720px); gap: 64px; max-width: 1040px; margin: auto; }
.author { font-size: 14px; display: flex; flex-direction: column; align-items: flex-start; }
.author img { border-radius: 50%; margin-bottom: 16px; width: 72px; height: 72px; }
.author a { min-height: 44px; display: inline-flex; align-items: center; gap: 8px; font-weight: 600; }
.author p { line-height: 1.65; color: var(--ink-muted); margin: 0 0 14px; }
.author .author-follow { font-size: 13px; text-decoration: none; }
.article-end { max-width: 720px; margin: 48px auto 0; }
.follow { background: var(--sky); padding: 36px; margin-top: 40px; }
.follow h2 { font-size: 28px; margin: 0 0 16px; }
.follow p { font-size: 17px; line-height: 1.65; margin: 0 0 24px; }
.related { max-width: 1040px; margin: 72px auto 0; }
.related > h2 { font-size: 34px; margin: 0 0 32px; }
@media (max-width: 1023px) {
 .article-body { grid-template-columns: minmax(0, 720px); justify-content: center; }
 .author { display: none; }
 .article-header { max-width: 800px; }
}
@media (max-width: 767.98px) {
 .article-shell { padding-block: 44px 56px; }
 .article-header { margin-bottom: 36px; }
 h1 { font-size: clamp(2.1rem, 7.7vw, 3rem); }
 .article-meta { gap: 6px 16px; }
 .follow { padding: 24px; }
 .follow h2 { font-size: 26px; }
 .related { margin-top: 48px; }
 .related > h2 { font-size: 28px; }
}
</style>
