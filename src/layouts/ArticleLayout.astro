---
import BaseLayout from './BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import '../styles/prose.css';

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  date: Date;
  notice?: string;
  backHref: string;
  backLabel: string;
  jsonLd: Record<string, unknown>;
}

const {
  title,
  description,
  eyebrow,
  date,
  notice,
  backHref,
  backLabel,
  jsonLd,
} = Astro.props;

const formattedDate = new Intl.DateTimeFormat('en-CA', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
}).format(date);
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <div class="article-shell">
    <article class="article">
      <header class="article__header">
        <Eyebrow>{eyebrow}</Eyebrow>
        <h1>{title}</h1>
        <time datetime={date.toISOString()}>{formattedDate}</time>
        {notice && <p class="article__notice">{notice}</p>}
      </header>

      <div class="prose">
        <slot />
      </div>

      <footer class="article__footer">
        <a href={backHref}>{backLabel}</a>
      </footer>
    </article>
  </div>
</BaseLayout>

<style>
  .article-shell {
    width: 100%;
    max-width: var(--max-page);
    margin: 0 auto;
    padding: var(--section-pad-desktop) var(--gutter-desktop);
  }

  .article {
    width: 100%;
    max-width: 68ch;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .article__header {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  h1 {
    margin: 0;
    font-size: 48px;
    line-height: 1.1;
    letter-spacing: -0.028em;
    text-wrap: pretty;
  }

  time {
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .article__notice {
    margin: 0;
    padding-top: 16px;
    color: var(--ink-muted);
    font-size: 16px;
    line-height: 1.55;
    border-top: 1px solid var(--rule);
  }

  .article__footer {
    padding-top: 24px;
    border-top: 1px solid var(--rule);
  }

  .article__footer a {
    min-height: var(--tap-min);
    display: inline-flex;
    align-items: center;
    font-size: 16px;
    font-weight: 600;
  }

  @media (max-width: 767.98px) {
    .article-shell {
      padding: var(--section-pad-mobile) var(--gutter-mobile);
    }

    .article { gap: 32px; }
    .article__header { gap: 14px; }
    h1 { font-size: 34px; }
  }
</style>
