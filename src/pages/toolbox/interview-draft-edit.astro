---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Arrow from '../../components/Arrow.astro';
import ToolboxDiagram from '../../components/ToolboxDiagram.astro';
import ToolboxSkillSource from '../../components/ToolboxSkillSource.astro';
import { TOOLBOX as T, INTERVIEW_YOUR_DRAFT as I } from '../../data/toolbox';
import ToolboxOutcome from '../../components/ToolboxOutcome.astro';
import { GUIDE_PRESENTATION as G } from '../../data/toolbox-presentation';
import '../../styles/toolbox-guide.css';
---
<BaseLayout title={I.title} socialTitle={I.headline} description={I.description} ogImageAlt={I.headline}>
<div class="wrap toolbox-guide">
<header class="guide-header">
      <a class="text-link back-link" href="/toolbox/">{T.title}</a>
      <h1>{I.headline}</h1>

      <p class="guide-intro">{I.intro}</p>
      <p class="guide-kind"><strong>{I.category}</strong><span>{I.formats}</span></p><p class="guide-format">{I.format}</p>
      <div class="guide-action">
        <a class="action" href="#prompt">{I.action}<Arrow /></a>
        <a class="text-link" href="#downloads">{I.skillAction}<Arrow /></a>
        <span>{I.availability}</span>
      </div>
    </header><nav class="guide-contents" aria-label={I.contentsLabel}>
 <a href="#outputs">{G.overviewLink}</a><a href="#example">{G.exampleLink}</a><a href="#workflow">{G.methodLink}</a><a href="#prompt">{G.promptLink}</a><a href="#downloads">{G.downloadsLink}</a>
 </nav>
<ToolboxOutcome rows={G.interviewRows} />
<section id="example" aria-labelledby="example-heading">
          <div class="section-lead"><h2 id="example-heading">{I.example.heading}</h2><p>{G.interviewExampleIntro}</p></div><div class="section-content">
          <details class="worked-example" open>
            <summary>{I.example.label}</summary>
            <div class="example-body">
              <p class="example-disclaimer">{I.example.disclaimer}</p>
              <dl>
                <dt>{I.example.draftLabel}</dt><dd>{I.example.draft}</dd>
                <dt>{I.example.questionLabel}</dt><dd>{I.example.question}</dd>
                <dt>{I.example.answerLabel}</dt><dd>{I.example.answer}</dd>
                <dt>{I.example.editLabel}</dt><dd>{I.example.editBefore} <span class="suggested-join">{I.example.editAddition}</span></dd>
                <dt>{I.example.finalEditLabel}</dt><dd>{I.example.finalEdit}</dd>
              </dl>
              <p class="example-explanation">{I.example.explanation}</p>
            </div>
          </details>
        </div></section>

<section id="workflow" aria-labelledby="workflow-heading">
          <div class="section-lead"><h2 id="workflow-heading">{I.workflow.heading}</h2><p>{I.why}</p><p>{I.opening}</p></div><div class="section-content">

          <dl class="guide-inputs">{I.workflow.inputs.map(item => <div><dt>{item.label}</dt><dd>{item.body}</dd></div>)}</dl>
          <details class="method-details"><summary>{G.methodDetails}</summary><ToolboxDiagram kind="interview" /><ol class="workflow-steps">
            {I.workflow.steps.map(step => <li><h3>{step.title}</h3><p>{step.body}</p></li>)}
          </ol></details>
        </div></section>
<section id="prompt" aria-labelledby="prompt-heading" class="prompt-section">
          <div class="section-lead"><h2 id="prompt-heading">{I.prompt.heading}</h2>
          <p>{I.prompt.intro}</p></div><div class="section-content">
          <div data-copy-prompt data-copied={I.prompt.copied} data-selected={I.prompt.selected} data-failed={I.prompt.failed} data-select-label={I.prompt.select}>
            <label class="visually-hidden" for="interview-prompt">{I.prompt.label}</label>
            <textarea id="interview-prompt" readonly spellcheck="false" rows="18">{I.prompt.text}</textarea>
            <div class="prompt-controls">
              <button class="action" type="button" data-copy-button hidden>{I.prompt.copy}</button>
              <p class="copy-status" role="status" aria-live="polite" aria-atomic="true" data-copy-status></p>
            </div>
            <noscript><p class="prompt-fallback">{I.prompt.noScript}</p></noscript>
          </div>
        </div></section>
<section id="downloads" aria-labelledby="downloads-heading">
          <div class="section-lead"><h2 id="downloads-heading">{I.downloads.heading}</h2>
          <p>{I.downloads.intro}</p></div><div class="section-content">
          <p class="skill-name">{I.skillNameLabel} <code>{I.skillName}</code></p>
          <ul class="downloads">
            {I.downloads.files.map(file => <li>
              <a class="text-link" href={file.href} download>{file.label}<Arrow /></a>
              <span class="file-format">{file.format}</span>
              <p>{file.detail}</p>
            </li>)}
          </ul>
          <div class="download-references">
            <a href={I.downloads.sourceHref}>{I.downloads.source}</a>
          </div>
          <ToolboxSkillSource name="interview-draft-edit" />
          <h3>{I.downloads.setupHeading}</h3>
          <div class="skill-setups">
            {I.downloads.setups.map(setup => <details>
              <summary>{setup.name}</summary>
              <div class="setup-body">
                {setup.steps.map(step => <p>{step}</p>)}
                {setup.path && <code class="setup-path">{setup.path}</code>}
                <blockquote>{setup.invocation}</blockquote>
                <p>{setup.detail}</p>
                <a href={setup.href} target="_blank" rel="noopener noreferrer">{setup.link}</a>
              </div>
            </details>)}
          </div>
          <p class="download-updates">{I.downloads.updates}</p>
        </div></section>
<section aria-labelledby="limits-heading">
          <h2 id="limits-heading">{I.limits.heading}</h2>
          {I.limits.paragraphs.map(paragraph => <p>{paragraph}</p>)}
          <h3>{I.limits.libraryHeading}</h3>
          <p>{I.limits.library}</p>
        </section>
<section class="guide-closing" aria-labelledby="closing-heading">
          <h2 id="closing-heading">{I.closing.heading}</h2>
          <p>{I.closing.body}</p>
          <div class="closing-links">
            <a class="text-link" href="#prompt">{I.closing.action}<Arrow /></a>
            <a class="text-link" href="/writing/">{I.closing.writing}<Arrow /></a>
          </div>
        </section>
</div>
</BaseLayout>
<script>
  document.querySelectorAll<HTMLElement>('[data-copy-prompt]').forEach(panel => {
    const input = panel.querySelector<HTMLTextAreaElement>('textarea');
    const button = panel.querySelector<HTMLButtonElement>('[data-copy-button]');
    const status = panel.querySelector<HTMLElement>('[data-copy-status]');
    if (!input || !button || !status) return;

    const selectPrompt = () => {
      input.focus();
      input.select();
      input.setSelectionRange(0, input.value.length);
    };

    if (!navigator.clipboard?.writeText) button.textContent = panel.dataset.selectLabel ?? button.textContent;
    button.addEventListener('click', async () => {
      if (!navigator.clipboard?.writeText) {
        selectPrompt();
        status.textContent = panel.dataset.selected ?? '';
        return;
      }
      try {
        await navigator.clipboard.writeText(input.value);
        status.textContent = panel.dataset.copied ?? '';
      } catch {
        selectPrompt();
        status.textContent = panel.dataset.failed ?? '';
      }
    });
    button.hidden = false;
  });
</script>
