---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Arrow from '../../components/Arrow.astro';
import ToolboxNewsletter from '../../components/ToolboxNewsletter.astro';
import ToolboxWorkedExample from '../../components/ToolboxWorkedExample.astro';
import { Content as AfterACallExample } from '../../../skills/crm-by-conversation/resources/after-a-call-example.md';
import ToolboxQuickStart from '../../components/ToolboxQuickStart.astro';
import { QUICK_START as Q } from '../../data/toolbox-start';
import ToolboxSkillSource from '../../components/ToolboxSkillSource.astro';
import { TOOLBOX as T } from '../../data/toolbox';
import { CRM as C, CRM_PROMPT } from '../../data/crm-by-conversation';
import ToolboxOutcome from '../../components/ToolboxOutcome.astro';
import { GUIDE_PRESENTATION as G } from '../../data/toolbox-presentation';
import '../../styles/toolbox-guide.css';
---
<BaseLayout title={C.title} socialTitle={C.promise} description={C.description} ogImageAlt={C.promise}>
<div class="wrap toolbox-guide">
<header class="guide-header">
      <a class="text-link back-link" href="/toolbox/">{T.title}</a>
      <h1>{C.title}</h1>

      <p class="guide-question">{C.promise}</p>
      <p class="guide-intro">{C.intro}</p>
      <p class="guide-kind"><strong>{C.category}</strong><span>{C.formats}</span></p><p class="guide-format">{C.format}</p>
      <div class="guide-action"><a class="action" href="#prompt">{C.primary}<Arrow /></a><a class="text-link" href={C.downloads.files[0].href} download>{C.secondary}<Arrow /></a></div>
    </header>
<ToolboxQuickStart kind="crm" name="crm-by-conversation" prompt={CRM_PROMPT} methodHref="#workflow" connected />

<section id="before" aria-labelledby="before-heading">
          <div class="section-lead"><h2 id="before-heading">{C.before.heading}</h2><p>{C.before.intro}</p><p><a class="text-link" href={C.before.attioHref} target="_blank" rel="noopener noreferrer">{C.before.attioLabel}<Arrow /></a></p></div><div class="section-content">
          <dl class="bring">{C.before.items.map(item => <div><dt>{item.label}</dt><dd>{item.body}</dd></div>)}</dl>
        </div>
          <p class="small-note">{C.before.note}</p></section>

<section id="example" aria-labelledby="example-heading">
          <div class="section-lead"><h2 id="example-heading">{C.example.heading}</h2><p>{C.example.intro}</p></div><div class="section-content">
          <ToolboxWorkedExample label={C.example.label} open><AfterACallExample /></ToolboxWorkedExample>
        </div></section>

<details class="output-details"><summary>{Q.outputs}</summary><ToolboxOutcome rows={G.crmRows} /></details>
<section id="workflow" aria-labelledby="workflow-heading">
          <div class="section-lead"><h2 id="workflow-heading">{C.workflow.heading}</h2><p>{C.workflow.why}</p></div><div class="section-content">
          <h3>{C.workflow.commandsHeading}</h3>
          <dl class="guide-inputs">{C.workflow.commands.map(item => <div><dt>{item.label}</dt><dd>{item.body}</dd></div>)}</dl>
          <details class="method-details"><summary>{C.workflow.methodDetails}</summary><ol class="workflow-steps">
            {C.workflow.steps.map(step => <li><h3>{step.title}</h3><p>{step.body}</p></li>)}
          </ol></details>
        </div></section>
<section id="downloads" aria-labelledby="downloads-heading">
          <div class="section-lead"><h2 id="downloads-heading">{Q.setup}</h2>
          <p>{C.downloads.intro}</p></div><div class="section-content">
          <p class="skill-name">{C.skillNameLabel} <code>{C.skillName}</code></p><p class="version">{C.version}</p>
          <ul class="downloads">
            {C.downloads.files.map(file => <li>
              <a class="text-link" href={file.href} download>{file.label}<Arrow /></a>
              <span class="file-format">{file.format}</span>
              <p>{file.detail}</p>
            </li>)}
          </ul>
          <div class="download-references">
            <a href={C.downloads.sourceHref}>{C.downloads.source}</a>
          </div>
          <ToolboxSkillSource name="crm-by-conversation" />
          <h3>{C.downloads.setupHeading}</h3>
          <div class="skill-setups">
            {C.downloads.setups.map(setup => <details>
              <summary>{setup.name}</summary>
              <div class="setup-body">
                {setup.steps.map(step => <p>{step}</p>)}
                {setup.path && <code class="setup-path">{setup.path}</code>}
                <blockquote>{setup.invocation}</blockquote>
                <a href={setup.href} target="_blank" rel="noopener noreferrer">{setup.link}</a>
              </div>
            </details>)}
          </div>
          <p>{C.downloads.setupCheck}</p>
          <p class="download-updates">{C.downloads.updates}</p>
        </div></section>
<section aria-labelledby="limits-heading"><h2 id="limits-heading">{C.limits.heading}</h2>{C.limits.paragraphs.map(paragraph => <p>{paragraph}</p>)}</section>
<section class="guide-closing" aria-labelledby="closing-heading"><h2 id="closing-heading">{C.closing.heading}</h2><p>{C.closing.body}</p><a class="text-link" href="#prompt">{C.closing.action}<Arrow /></a></section>
<ToolboxNewsletter id="crm-by-conversation-newsletter" />
</div>
</BaseLayout>
