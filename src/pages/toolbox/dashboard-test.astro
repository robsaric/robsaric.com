---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Arrow from '../../components/Arrow.astro';
import ToolboxDiagram from '../../components/ToolboxDiagram.astro';
import ToolboxSkillSource from '../../components/ToolboxSkillSource.astro';
import { DASHBOARD_TEST as D, DASHBOARD_PROMPT } from '../../data/dashboard-test';
---
<BaseLayout title={D.title} socialTitle={D.question} description={D.description} ogImageAlt={D.question}>
  <div class="wrap guide-page">
    <header class="guide-header">
      <a class="text-link back-link" href="/toolbox/">{D.back}</a>
      <h1>{D.title}</h1>
      <p class="guide-kind"><strong>{D.category}</strong><span>{D.formats}</span></p>
      <p class="guide-question">{D.question}</p>
      <p class="guide-intro">{D.intro}</p>
      <p class="guide-format">{D.format}</p>
      <div class="guide-action"><a class="action" href="#checklist">{D.primary}<Arrow /></a><a class="text-link" href="#downloads">{D.secondary}<Arrow /></a></div>
    </header>
    <div class="guide-layout">
      <nav class="guide-contents" aria-label={D.navLabel}>{D.nav.map(item => <a href={item.href}>{item.label}</a>)}</nav>
      <div class="guide-body">
        <section id="before" aria-labelledby="before-heading"><h2 id="before-heading">{D.beforeHeading}</h2><dl class="bring">{D.before.map(item => <div><dt>{item.label}</dt><dd>{item.body}</dd></div>)}</dl><p class="small-note">{D.privacy}</p></section>
        <section id="checklist" aria-labelledby="checklist-heading">
          <ToolboxDiagram kind="dashboard" />
          <h2 id="checklist-heading">{D.checklistHeading}</h2><p>{D.checklistIntro}</p>
          <ul class="review-checklist">{D.checklist.map((item,i) => <li><label><input type="checkbox" aria-describedby={`check-help-${i}`} /><span>{item.title}</span></label><p id={`check-help-${i}`}>{item.body}</p></li>)}</ul>
          <p class="small-note">{D.checklistNote}</p>
          <div class="review-alternative"><h3>{D.alternativeHeading}</h3><p>{D.alternative}</p></div>
          <a class="text-link" href="/downloads/dashboard-test/checklist.md" download>{D.checklistDownload}<Arrow /></a>
        </section>
        <section id="prompt" aria-labelledby="prompt-heading">
          <h2 id="prompt-heading">{D.promptHeading}</h2><p>{D.promptIntro}</p>
          <div data-copy-prompt data-copied={D.copied} data-selected={D.selected} data-failed={D.failed} data-select-label={D.select}>
            <label class="visually-hidden" for="dashboard-prompt">{D.promptLabel}</label><textarea id="dashboard-prompt" readonly spellcheck="false" rows="12">{DASHBOARD_PROMPT}</textarea>
            <div class="prompt-controls"><button class="action" type="button" data-copy-button hidden>{D.copy}</button><p class="copy-status" role="status" aria-live="polite" aria-atomic="true" data-copy-status></p></div>
            <noscript><p>{D.noScript}</p></noscript>
          </div>
        </section>
        <section id="downloads" aria-labelledby="downloads-heading">
          <h2 id="downloads-heading">{D.downloadHeading}</h2><p>{D.downloadIntro}</p><p class="skill-name">{D.skillNameLabel} <code>{D.skillName}</code></p><p class="version">{D.version}</p>
          <div class="closing-links"><a class="action" href="/downloads/dashboard-test/dashboard-test.zip" download>{D.downloadLabel}<Arrow /></a><a class="text-link" href="/downloads/dashboard-test/chat-prompt.txt" download>{D.promptDownload}<Arrow /></a></div>
          <p class="small-note"><a href="/downloads/dashboard-test/dashboard-test/SKILL.md">{D.sourceLabel}</a></p>
          <ToolboxSkillSource name="dashboard-test" />
          <h3>{D.setupHeading}</h3><div class="skill-setups">{D.setups.map(setup => <details><summary>{setup.name}</summary><div class="setup-body"><p>{setup.body}</p>{setup.path && <code class="setup-path">{setup.path}</code>}<blockquote>{setup.invoke}</blockquote><a href={setup.url} target="_blank" rel="noopener noreferrer">{setup.link}</a></div></details>)}</div><p>{D.setupCheck}</p><p class="small-note">{D.updates}</p>
        </section>
        <section id="examples" aria-labelledby="examples-heading"><h2 id="examples-heading">{D.examplesHeading}</h2><p>{D.examplesIntro}</p>{D.examples.map(example => <details class="worked-example"><summary>{example.title}</summary><div class="example-body"><p>{example.context}</p><dl><dt>{D.verdictLabel}</dt><dd>{example.verdict}</dd><dt>{D.improvementLabel}</dt><dd>{example.improvement}</dd><dt>{D.checkLabel}</dt><dd>{example.check}</dd></dl></div></details>)}</section>
        <section aria-labelledby="limits-heading"><h2 id="limits-heading">{D.limitHeading}</h2><p>{D.limit}</p></section>
        <section class="guide-closing" aria-labelledby="closing-heading"><h2 id="closing-heading">{D.closingHeading}</h2><p>{D.closing}</p><a class="text-link" href={D.articleHref}>{D.articleLink}<Arrow /></a></section>
      </div>
    </div>
  </div>
</BaseLayout>
<script>
  document.querySelectorAll<HTMLElement>('[data-copy-prompt]').forEach(panel => {
    const input = panel.querySelector<HTMLTextAreaElement>('textarea');
    const button = panel.querySelector<HTMLButtonElement>('[data-copy-button]');
    const status = panel.querySelector<HTMLElement>('[data-copy-status]');
    if (!input || !button || !status) return;

    const selectPrompt = () => {
      input.focus();
      input.select();
      input.setSelectionRange(0, input.value.length);
    };

    if (!navigator.clipboard?.writeText) button.textContent = panel.dataset.selectLabel ?? button.textContent;
    button.addEventListener('click', async () => {
      if (!navigator.clipboard?.writeText) {
        selectPrompt();
        status.textContent = panel.dataset.selected ?? '';
        return;
      }
      try {
        await navigator.clipboard.writeText(input.value);
        status.textContent = panel.dataset.copied ?? '';
      } catch {
        selectPrompt();
        status.textContent = panel.dataset.failed ?? '';
      }
    });
    button.hidden = false;
  });
</script>
<style>
  .guide-kind { display: flex; flex-wrap: wrap; gap: 4px 20px; color: var(--ink-muted); font: 14px/1.6 var(--font-sans); margin: 0 0 24px; }
  .guide-kind strong { color: var(--ink); font-weight: 600; }
  .guide-page { padding-block: 28px 96px; }
  .guide-header { max-width: 980px; padding-bottom: 52px; }
  .back-link { color: var(--ink-muted); margin-bottom: 22px; }
  h1 { font-size: clamp(3rem, 6.5vw, 5.5rem); margin: 0 0 24px; }
  .guide-intro { max-width: 45ch; font-size: clamp(1.25rem, 2.2vw, 1.6rem); line-height: 1.55; margin: 0; }
  .guide-format { max-width: 65ch; margin: 16px 0 0; font-size: 16px; line-height: 1.65; color: var(--ink-muted); }
  .skill-name, .guide-body .skill-name { margin: 12px 0 0; font-size: 14px; line-height: 1.6; color: var(--ink-muted); }
  .skill-name code { color: var(--ink); font: inherit; font-family: var(--font-mono); overflow-wrap: anywhere; }
  .guide-action { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 24px; margin-top: 28px; }
  .guide-action span { color: var(--ink-muted); font-size: 14px; }
  .guide-layout { display: grid; grid-template-columns: minmax(160px, .45fr) minmax(0, 1.55fr); gap: clamp(36px, 7vw, 100px); border-top: 1px solid var(--rule); padding-top: 40px; }
  .guide-contents { align-self: start; display: flex; flex-direction: column; }
  .guide-contents a { display: flex; align-items: center; min-height: 44px; width: fit-content; padding-block: 8px; color: var(--ink-muted); font-size: 14px; line-height: 1.45; text-underline-offset: 4px; }
  .guide-body { max-width: 70ch; min-width: 0; }
  .guide-body p { font-size: 18px; line-height: 1.75; margin: 0 0 22px; }
  .guide-body .opening { margin-bottom: 40px; }
  section { scroll-margin-top: 40px; padding-top: 36px; margin-top: 36px; border-top: 1px solid var(--rule); }
  #workflow { border: 0; margin-top: 0; padding-top: 0; }
  h2 { font-size: clamp(1.9rem, 3vw, 2.5rem); line-height: 1.18; margin: 0 0 22px; }
  h3 { font-family: var(--font-sans); font-size: 18px; font-weight: 600; line-height: 1.45; letter-spacing: -.01em; margin: 28px 0 10px; }
  .workflow-steps { padding-left: 25px; margin: 28px 0 0; }
  .workflow-steps li { padding-left: 10px; margin-bottom: 28px; }
  .workflow-steps li::marker { color: var(--ink-muted); font-size: 15px; }
  .workflow-steps h3 { margin-top: 0; }
  .workflow-steps p { margin: 0; }
  textarea { display: block; width: 100%; resize: vertical; min-height: 270px; max-height: 900px; background: var(--paper-inset); border: 1px solid var(--rule); border-radius: 4px; color: var(--ink); padding: 22px; font-family: var(--font-sans); font-size: 16px; line-height: 1.65; tab-size: 2; }
  .prompt-controls { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; margin-top: 16px; }
  .prompt-controls button { cursor: pointer; }
  .prompt-controls .copy-status { flex: 1 1 240px; font-size: 14px; line-height: 1.5; margin: 0; color: var(--ink-muted); }
  .prompt-fallback { color: var(--ink-muted); }
  .downloads { list-style: none; margin: 18px 0; padding: 0; }
  .downloads li { padding-block: 12px 18px; border-bottom: 1px solid var(--rule); }
  .downloads .text-link { font-size: 16px; margin-right: 12px; }
  .file-format { font-size: 12px; color: var(--ink-muted); white-space: nowrap; }
  .downloads p { font-size: 16px; line-height: 1.65; color: var(--ink-muted); margin: 3px 0 0; }
  .download-references { display: flex; flex-direction: column; gap: 2px; }
  .download-references a { display: flex; align-items: center; min-height: 44px; padding-block: 8px; font-size: 14px; line-height: 1.5; }
  .skill-setups { border-block: 1px solid var(--rule); }
  .skill-setups details + details { border-top: 1px solid var(--rule); }
  .skill-setups summary { cursor: pointer; min-height: 54px; padding-block: 17px; font-size: 16px; font-weight: 600; }
  .setup-body { padding: 0 0 22px; }
  .setup-body p { font-size: 16px; line-height: 1.65; margin-bottom: 14px; }
  .setup-path { display: block; background: var(--paper-inset); color: var(--ink); padding: 14px 16px; font: 14px/1.65 var(--font-mono); overflow-wrap: anywhere; margin-bottom: 18px; }
  .setup-body blockquote { border-left: 2px solid var(--rule); margin: 18px 0; padding: 4px 0 4px 18px; font-size: 17px; line-height: 1.65; overflow-wrap: anywhere; }
  .setup-body a { display: inline-flex; align-items: center; min-height: 44px; font-size: 14px; }
  .guide-body .download-updates { margin-top: 18px; font-size: 14px; line-height: 1.65; color: var(--ink-muted); }
  .worked-example { border: 1px solid var(--rule); border-radius: 4px; background: var(--paper-inset); }
  .worked-example summary { cursor: pointer; min-height: 54px; padding: 17px 22px; font-size: 16px; font-weight: 600; }
  .example-body { padding: 0 22px 22px; }
  .example-body .example-disclaimer, .example-body .example-explanation { font-size: 15px; color: var(--ink-muted); line-height: 1.65; }
  .example-body .example-explanation { margin-bottom: 0; }
  dl { margin: 24px 0; }
  dt { font-size: 14px; font-weight: 600; margin: 24px 0 8px; }
  dd { margin: 0; font-size: 17px; line-height: 1.7; }
  .suggested-join { font-style: italic; }
  .guide-closing p { max-width: 55ch; }
  .closing-links { display: flex; flex-wrap: wrap; gap: 8px 28px; }
  @media (max-width: 900px) {
    .guide-layout { grid-template-columns: minmax(0, 1fr); gap: 30px; }
    .guide-contents { flex-direction: row; flex-wrap: wrap; gap: 0 24px; }
    .guide-body { max-width: 72ch; }
  }
  @media (max-width: 767.98px) {
    .guide-page { padding-block: 18px 64px; }
    .guide-header { padding-bottom: 36px; }
    .back-link { margin-bottom: 14px; }
    .guide-layout { padding-top: 22px; }
    .guide-body p { font-size: 17px; }
    .guide-action { align-items: flex-start; flex-direction: column; }
    .guide-contents { gap: 0 20px; }
    section { margin-top: 30px; padding-top: 30px; }
    textarea { padding: 16px; }
    .downloads .text-link { gap: 8px; font-size: 15px; }
    .worked-example summary { padding-inline: 16px; }
    .example-body { padding-inline: 16px; }
  }

  .guide-question { font: 400 clamp(1.5rem, 3vw, 2.2rem)/1.3 var(--font-display); max-width: 32ch; margin: 0 0 18px; }
  .guide-header { padding-bottom: 36px; }
  .guide-intro { font-size: 18px; max-width: 62ch; }
  .guide-body > section:first-child { border: 0; margin: 0; padding: 0; }
  .bring { margin: 0; }
  .bring div { margin-block: 20px; }
  .bring dt { font-weight: 600; margin-bottom: 6px; }
  .bring dd { margin: 0; line-height: 1.7; }
  .guide-body .small-note { color: var(--ink-muted); font-size: 14px; }
  .review-checklist { padding: 0; list-style: none; }
  .review-checklist li { padding-block: 18px; border-top: 1px solid var(--rule); }
  .review-checklist label { display: flex; align-items: center; gap: 14px; min-height: 44px; font-weight: 600; cursor: pointer; }
  .review-checklist input { flex: 0 0 20px; width: 20px; height: 20px; accent-color: var(--action-ink); }
  .review-checklist p { margin: 6px 0 0 34px; font-size: 16px; }
  .review-alternative { padding: 22px; background: var(--paper-inset); margin-block: 24px; }
  .review-alternative h3 { margin-top: 0; }
  .review-alternative p { margin-bottom: 0; }
  .example-body dl { margin: 0; }
  .example-body dt { font-weight: 600; margin-top: 16px; }
  .example-body dd { margin: 6px 0; }
  .setup-path { display: block; overflow-wrap: anywhere; margin-block: 16px; }
  .guide-body .version { font-size: 13px; color: var(--ink-muted); }
  .preview-label { font-size: 14px; color: var(--ink-muted); padding: 12px 0; border-bottom: 1px solid var(--rule); margin-bottom: 24px; }
</style>
