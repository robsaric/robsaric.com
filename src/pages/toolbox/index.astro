---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Arrow from '../../components/Arrow.astro';
import ToolboxNewsletter from '../../components/ToolboxNewsletter.astro';
import { COLLECTION } from '../../data/toolbox-collection.mjs';
import { TOOLBOX_INSTALLATION as S } from '../../data/toolbox-installation';
import { TOOLBOX as T } from '../../data/toolbox';
import { VALUE_STREAM } from '../../data/value-stream-mapping';
import { CRM } from '../../data/crm-by-conversation';

const titles = {
  interview: T.feature.title,
  dashboard: T.dashboard.title,
  mapping: VALUE_STREAM.title,
  crm: CRM.title,
};
---

<BaseLayout title={T.title} description={T.description} ogImageAlt={T.intro}>
  <div class="wrap toolbox-page">
    <header>
      <h1>{T.title}</h1>
      <p>{T.intro}</p>
    </header>

    <nav id="workflows" aria-label={T.navigationLabel}>
      <ul class="guide-list">
        {COLLECTION.entries.map(guide => <li>
          <a class="guide-row" href={`/toolbox/${guide.slug}/`}>
            <span class="guide-name">{titles[guide.kind]}</span>
            <span class="guide-job">{guide.job}</span>
            <Arrow />
          </a>
        </li>)}
      </ul>
    </nav>

    <details class="reference">
      <summary id="downloads">{T.downloads.heading}</summary>
      <p>{T.downloads.intro}</p>
      <ul>{T.downloads.items.map(item => <li>
        <a href={item.href} download>{item.title}</a>
        <span>{item.format}</span>
      </li>)}</ul>
    </details>
    <details class="reference">
      <summary id="tools">{T.resources.heading}</summary>
      <p>{T.resources.intro}</p>
      <ul>{T.resources.items.map(item => <li>
        <a href={item.href}>{item.title}</a>
        <span>{item.use} {item.limit}</span>
      </li>)}</ul>
      <a href={S.repo}>{S.collection}</a>
    </details>
    <ToolboxNewsletter id="toolbox-newsletter" />
  </div>
</BaseLayout>

<style>
  .toolbox-page { max-width: 64rem; padding-block: 44px 64px; }
  header { padding-bottom: 28px; }
  h1 { margin: 0 0 12px; font-size: clamp(3rem, 7vw, 5.5rem); }
  header p { margin: 0; font-size: 18px; line-height: 1.55; }
  ul { list-style: none; margin: 0; padding: 0; }
  .guide-list { border-bottom: 1px solid var(--rule); }
  .guide-row {
    display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1fr) auto;
    align-items: center; gap: 24px; min-height: 44px; padding: 22px 4px;
    border-top: 1px solid var(--rule); color: var(--ink); text-decoration: none;
  }
  .guide-row:is(:hover, :focus-visible) .guide-name { text-decoration: underline; text-underline-offset: 4px; }
  .guide-name { font: 400 clamp(1.45rem, 3vw, 2rem)/1.2 var(--font-editorial); }
  .guide-job, .reference { font-size: 16px; line-height: 1.55; }
  .guide-job, .reference span { color: var(--ink-muted); }
  nav { margin-bottom: 32px; }
  .reference { border-bottom: 1px solid var(--rule); }
  .reference summary { min-height: 44px; padding-block: 12px; cursor: pointer; }
  .reference p { margin: 4px 0 12px; max-width: 65ch; }
  .reference a { display: inline-flex; align-items: center; min-height: 44px; }
  .reference li { padding-bottom: 12px; }
  .reference span { display: block; max-width: 65ch; }
  @media (max-width: 767px) {
    .toolbox-page { padding-block: 24px 48px; }
    header { padding-bottom: 18px; }
    header p { font-size: 16px; }
    .guide-row { grid-template-columns: minmax(0, 1fr) auto; gap: 4px 12px; padding-block: 14px; }
    .guide-job { grid-column: 1; }
    .guide-row :global(svg) { grid-column: 2; grid-row: 1 / span 2; }
  }
</style>
