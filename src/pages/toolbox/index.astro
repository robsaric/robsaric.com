---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Arrow from '../../components/Arrow.astro';
import ToolboxSample from '../../components/ToolboxSample.astro';
import { COLLECTION as C } from '../../data/toolbox-presentation';
import { TOOLBOX_INSTALLATION as S } from '../../data/toolbox-installation';
import { TOOLBOX as T } from '../../data/toolbox';
import { VALUE_STREAM as V } from '../../data/value-stream-mapping';
const guides = [
  { title: T.feature.title, category: T.feature.category, formats: T.feature.kind, description: T.feature.description, href: T.feature.href, ...C.entries[0] },
  { title: T.dashboard.title, category: T.dashboard.category, formats: T.dashboard.kind, description: T.dashboard.description, href: T.dashboard.href, ...C.entries[1] },
  { title: V.title, category: V.category, formats: V.formats, description: V.promise, href: '/toolbox/value-stream-mapping/', ...C.entries[2] },
];
---

<BaseLayout title={T.title} description={T.description}>
  <div class="wrap toolbox-page">
    <header class="toolbox-header">
      <h1>{T.title}</h1>
      <div class="toolbox-introduction">
        <p class="toolbox-intro">{T.intro}</p>
        <p>{T.explanation}</p>
      </div>
    </header>

    <nav class="collection-nav" aria-label={T.navigationLabel}>
      {T.sections.map(section => <a href={section.href}>{section.label}<Arrow /></a>)}
    </nav>

    <section id="workflows" aria-labelledby="workflows-heading">
      <h2 id="workflows-heading">{T.workflowHeading}</h2>
      <div class="guide-collection">
        {guides.map(guide => <article class="collection-entry">
          <div class="entry-intro">
            <h3><a href={guide.href}>{guide.title}</a></h3>
            <p class="resource-category">{guide.category}</p>
            <p class="entry-description">{guide.description}</p>
            <p class="entry-bring"><strong>{C.bring}:</strong> {guide.bring}</p>
          </div>
          <ToolboxSample kind={guide.kind} />
          <div class="entry-footer"><p class="resource-kind">{guide.formats}</p><div class="entry-links"><a class="text-link" href={guide.href}>{C.open}<span class="visually-hidden">: {guide.title}</span><Arrow /></a><a class="text-link" href={C.repo + guide.slug}>{C.github}<span class="visually-hidden">: {guide.title}</span><Arrow /></a></div></div>
        </article>)}
      </div>
    </section>

    <section id="downloads" aria-labelledby="downloads-heading">
      <div class="section-heading">
        <h2 id="downloads-heading">{T.downloads.heading}</h2>
        <p>{T.downloads.intro}</p>
      </div>
      <ul class="download-list">
        {T.downloads.items.map(item => <li>
          <div><h3>{item.title}</h3><p class="resource-kind">{item.format}</p></div>
          <p class="download-description">{item.description}</p>
          <a class="text-link" href={item.href} download>{T.downloads.action}<span class="visually-hidden"> {item.title}</span><Arrow /></a>
        </li>)}
      </ul>
    </section>

    <section id="tools" aria-labelledby="tools-heading">
      <div class="section-heading">
        <h2 id="tools-heading">{T.resources.heading}</h2>
        <div><p>{T.resources.intro}</p><p><a class="text-link" href={S.repo}>{S.collection}</a></p></div>
      </div>
      <ul class="resource-list">
        {T.resources.items.map(item => <li>
          <div class="resource-title"><h3><a href={item.href}>{item.title}</a></h3><p class="resource-kind">{item.kind}</p></div>
          <dl>
            <div><dt>{T.resources.useLabel}</dt><dd>{item.use}</dd></div>
            <div><dt>{T.resources.limitLabel}</dt><dd>{item.limit}</dd></div>
          </dl>
          <a class="text-link resource-action" href={item.href}>{item.action}<span class="visually-hidden">: {item.title}</span><Arrow /></a>
        </li>)}
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .resource-category { font: 600 14px/1.5 var(--font-sans); margin: 12px 0 0; color: var(--ink); }
  .toolbox-page { padding-block: 44px 80px; }
  .toolbox-header { display: grid; grid-template-columns: .85fr 1.15fr; gap: 48px; align-items: center; margin-bottom: 28px; }
  h1 { font-size: clamp(3.5rem, 7vw, 5.5rem); margin: 0; }
  .toolbox-introduction p { max-width: 48ch; font-size: 17px; line-height: 1.65; margin: 12px 0 0; color: var(--ink-muted); }
  .toolbox-introduction .toolbox-intro { font-size: clamp(1.3rem, 2vw, 1.6rem); line-height: 1.4; margin: 0; color: var(--ink); }
  .collection-nav { display: flex; flex-wrap: wrap; gap: 8px 36px; border-block: 1px solid var(--rule); padding-block: 8px; }
  .collection-nav a { display: inline-flex; align-items: center; gap: 12px; min-height: 44px; color: var(--ink); text-decoration: none; font-size: 15px; }
  .collection-nav a:hover { text-decoration: underline; text-underline-offset: 5px; }
  .collection-nav :global(svg) { width: 15px; height: 15px; }
  section { scroll-margin-top: 32px; padding-block: 40px; }
  section + section { border-top: 1px solid var(--rule); }
  h2 { font-size: clamp(1.7rem, 2.7vw, 2.2rem); line-height: 1.2; margin: 0 0 24px; }
  h3, h4 { margin: 0; }
  h3 a { color: var(--ink); text-decoration: none; }
  h3 a:hover { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 5px; }
  .workflow-feature { display: grid; grid-template-columns: 1.1fr .9fr; gap: 64px; align-items: start; }
  .workflow-description h3 { font-size: clamp(2rem, 3.8vw, 3.25rem); line-height: 1.12; text-wrap: balance; }
  .resource-kind { font: 13px/1.5 var(--font-sans); color: var(--ink-muted); margin: 10px 0 0; }
  .feature-description { font-size: 21px; line-height: 1.5; max-width: 38ch; margin: 20px 0 12px; }
  .feature-detail { font-size: 16px; line-height: 1.65; color: var(--ink-muted); max-width: 48ch; margin: 0; }
  .feature-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; margin-top: 24px; }
  .feature-actions .text-link { font-size: 15px; }
  .workflow-sequence { background: var(--paper-inset); margin: 0; padding: 8px 28px 8px 54px; }
  .workflow-sequence li { padding: 20px 0 20px 8px; }
  .workflow-sequence li + li { border-top: 1px solid var(--rule); }
  .workflow-sequence li::marker { font: 14px var(--font-sans); color: var(--ink-muted); }
  .workflow-sequence h4 { font: 600 17px/1.45 var(--font-sans); letter-spacing: -.01em; }
  .workflow-sequence p { font-size: 15px; line-height: 1.6; color: var(--ink-muted); margin: 6px 0 0; }
  .section-heading { display: grid; grid-template-columns: .65fr 1.35fr; gap: 48px; align-items: start; margin-bottom: 24px; }
  .section-heading h2 { margin: 0; }
  .section-heading p { font-size: 16px; line-height: 1.65; color: var(--ink-muted); max-width: 65ch; margin: 0; }
  .download-list, .resource-list { margin: 0; padding: 0; list-style: none; }
  .download-list li { display: grid; grid-template-columns: .65fr 1fr auto; gap: 24px 48px; align-items: center; padding-block: 24px; border-top: 1px solid var(--rule); }
  .download-list h3 { font-size: 25px; line-height: 1.2; }
  .download-list .resource-kind { margin-top: 6px; }
  .download-description { font-size: 16px; line-height: 1.65; margin: 0; max-width: 48ch; }
  .download-list .text-link, .resource-action { font-size: 15px; min-height: 44px; width: fit-content; }
  .resource-list li { display: grid; grid-template-columns: .65fr 1.35fr; gap: 12px 48px; padding-block: 28px; border-top: 1px solid var(--rule); }
  .resource-title h3 { font-size: 27px; line-height: 1.25; }
  .resource-list dl { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; margin: 0; }
  .resource-list dt { font: 600 13px/1.5 var(--font-sans); margin-bottom: 8px; }
  .resource-list dd { font-size: 16px; line-height: 1.65; margin: 0; }
  .resource-list dl > div + div dd { color: var(--ink-muted); }
  .resource-action { grid-column: 2; }
  @media (max-width: 1100px) {
    .workflow-feature { gap: 32px; }
    .section-heading, .resource-list li, .download-list li { column-gap: 32px; }
    .resource-list dl { grid-template-columns: 1fr; gap: 16px; }
    .download-list li { grid-template-columns: .8fr 1.2fr; }
    .download-list .text-link { grid-column: 2; }
  }
  @media (max-width: 767.98px) {
    .toolbox-page { padding-block: 28px 48px; }
    .toolbox-header, .workflow-feature, .section-heading, .download-list li, .resource-list li { grid-template-columns: minmax(0, 1fr); gap: 20px; }
    .toolbox-header { margin-bottom: 24px; }
    .toolbox-introduction p { font-size: 16px; }
    .collection-nav { gap: 0 20px; }
    .collection-nav a { font-size: 14px; gap: 8px; }
    section { padding-block: 32px; }
    .workflow-feature { gap: 28px; }
    .feature-description { font-size: 19px; margin-top: 16px; }
    .feature-actions { gap: 8px 20px; }
    .workflow-sequence { padding-inline: 42px 20px; }
    .workflow-sequence li { padding-block: 16px; }
    .section-heading { gap: 12px; }
    .download-list li, .resource-list li { gap: 12px; padding-block: 24px; }
    .download-list .text-link, .resource-action { grid-column: auto; }
  }
  .dashboard-resource { display: grid; grid-template-columns: 1fr 1.4fr; gap: 48px; border-top: 1px solid var(--rule); padding-top: 32px; margin-top: 40px; }
  .dashboard-resource h3 { font-size: clamp(1.8rem, 3vw, 2.5rem); }
  .dashboard-resource .feature-description { margin-top: 0; }
  @media (max-width: 767.98px) { .dashboard-resource { grid-template-columns: 1fr; gap: 20px; } }

.guide-collection { display: grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:32px; }
.collection-entry { min-width:0; display:grid; grid-template-rows:subgrid; grid-row:span 3; gap:20px; }
.entry-intro h3 { font-size:clamp(1.65rem,2.5vw,2.25rem); line-height:1.15; margin:0; }
.entry-description { font-size:17px; line-height:1.55; margin:16px 0 12px; }
.entry-bring { font-size:14px; line-height:1.6; color:var(--ink-muted); margin:0; }
.entry-bring strong { font-weight:500; color:var(--ink); }
.entry-footer .resource-kind { margin:0 0 8px; }
.entry-footer .text-link { min-height:44px; }
.entry-links { display:flex; flex-wrap:wrap; gap:8px 24px; }
@supports not (grid-template-rows:subgrid) { .collection-entry { grid-template-rows:auto 1fr auto; grid-row:auto; } }
@media(max-width:1100px) { .guide-collection { gap:24px; } }
@media(max-width:767.98px) {
  .guide-collection { grid-template-columns:minmax(0,1fr); gap:32px; }
  .collection-entry { display:grid; grid-template-rows:auto; grid-row:auto; gap:20px; padding-top:24px; border-top:1px solid var(--rule); }
  .collection-entry:first-child { border-top:0; padding-top:0; }
  .entry-intro h3 { font-size:2rem; }
}
</style>
