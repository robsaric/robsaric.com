---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Arrow from '../../components/Arrow.astro';
import ToolboxWorkedExample from '../../components/ToolboxWorkedExample.astro';
import { Content as RepairExample } from '../../../skills/value-stream-mapping/resources/repair-example.md';
import ToolboxQuickStart from '../../components/ToolboxQuickStart.astro';
import { QUICK_START as Q } from '../../data/toolbox-start';
import { VALUE_STREAM as V } from '../../data/value-stream-mapping';
---
<BaseLayout title={V.title} description={V.description} ogImageAlt={V.promise}>
  <div class="wrap guide">
    {import.meta.env.DEV && <p class="preview">{V.preview}</p>}
    <header class="guide-hero">
      <a class="text-link back" href="/toolbox/">{V.back}</a>
      <h1>{V.title}</h1>
      <p class="promise">{V.promise}</p>
      <p class="intro">{V.intro}</p>
      <p class="kind"><strong>{V.category}</strong> · {V.formats}</p>
      <div class="actions"><a class="action" href="#prompt">{V.start}<Arrow /></a><a class="text-link" href="/downloads/value-stream-mapping/value-stream-mapping-kit.zip" download>{V.download}<Arrow /></a></div>
      <p class="small">{V.free}</p>
    </header>

<ToolboxQuickStart kind="mapping" name="value-stream-mapping" prompt={V.prompt} methodHref="#example" kit />


    <section id="example" class="split">
      <div class="section-lead"><h2>{V.sampleHeading}</h2><p>{V.sampleIntro}</p></div>
      <ToolboxWorkedExample label={V.sampleLabel}><RepairExample /></ToolboxWorkedExample>
    </section>
    <details class="output-details"><summary>{Q.outputs}</summary><section id="outputs">
      <h2>{V.outputHeading}</h2><p class="section-intro">{V.outputIntro}</p>
      <table class="outputs" role="table">
        <thead role="rowgroup"><tr role="row">{V.outputColumns.map(label => <th scope="col" role="columnheader">{label}</th>)}</tr></thead>
        <tbody role="rowgroup">{V.outputRows.map(row => <tr role="row">
          {[row.input, row.output, row.decision].map((text, i) => <td role="cell"><span class="mobile-label" aria-hidden="true">{V.outputColumns[i]}</span>{text}</td>)}
        </tr>)}</tbody>
      </table>
      <p class="small table-note">{V.outputNote}</p>
    </section></details>
<section id="method" class="split">
      <div class="section-lead">
        <div id="meaning"><h2>{V.meaning}</h2><p>{V.explanation}</p></div>
        <h3>{V.fitHeading}</h3><p>{V.fit}</p>
        <h3>{V.limitsHeading}</h3><p>{V.limits}</p>
      </div>
      <div>
        <h3 class="first-heading">{V.bringHeading}</h3><dl>{V.bring.map(item => <div><dt>{item.title}</dt><dd>{item.text}</dd></div>)}</dl>
        <p class="small">{V.privacy}</p>
        <details class="method-details"><summary>{V.methodDetails}</summary><div class="setup">
          <p>{V.methodIntro}</p>
          <ol class="steps">{V.steps.map(step => <li><h4>{step.title}</h4><p>{step.text}</p></li>)}</ol>
        </div></details>
      </div>
    </section>
    <section id="downloads" class="split">
      <div class="section-lead"><h2>{Q.setup}</h2><p>{V.downloadsIntro}</p>
        <a class="text-link" href="/downloads/value-stream-mapping/value-stream-mapping/SKILL.md">{V.sourceLabel}<Arrow /></a>
      </div>
      <div>
        <ul class="downloads">{V.files.map(file => <li><a class="text-link" href={file.href} download>{file.title}<Arrow /></a><span class="small format">{file.format}</span><p>{file.text}</p></li>)}</ul>
        <h3>{V.setupHeading}</h3>
        {V.setups.map(setup => <details><summary>{setup.name}</summary><div class="setup"><p>{setup.body}</p>{setup.path && <code>{setup.path}</code>}<blockquote>{setup.invoke}</blockquote></div></details>)}
        <p class="small check">{V.setupCheck}</p>
        <a class="text-link" href="/downloads/value-stream-mapping/installation.md">{V.installLabel}<Arrow /></a>
      </div>
    </section>
    <footer class="guide-ending"><p>{V.ending}</p><p class="small">{V.referencesLabel}</p><ul class="references">{V.references.map(ref => <li><a href={ref.href}>{ref.label}</a></li>)}</ul></footer>
  </div>
</BaseLayout>

<style>
.guide { padding-block: 24px 64px; }
.preview { font-size: 13px; color: var(--ink-muted); border-bottom: 1px solid var(--rule); padding-bottom: 12px; }
.guide-hero { max-width: 980px; padding-block: 16px 32px; }
.back { font-size: 14px; color: var(--ink-muted); }
h1 { font-size: clamp(2.8rem,6vw,5.3rem); line-height: 1.08; margin: 28px 0 20px; text-wrap: balance; }
.promise { font: 400 clamp(1.6rem,3vw,2.3rem)/1.3 var(--font-display); margin: 0 0 18px; }
.intro { font-size: 18px; line-height: 1.7; max-width: 64ch; }
.kind { font-size: 13px; color: var(--ink-muted); margin-top: 16px; }
.actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; margin-block: 24px 12px; }
.small { font-size: 14px; line-height: 1.6; color: var(--ink-muted); }
.guide-nav { display: flex; flex-wrap: wrap; gap: 0 28px; border-block: 1px solid var(--rule); padding-block: 8px; }
.guide-nav a { min-height: 44px; display: inline-flex; align-items: center; font-size: 14px; text-underline-offset: 4px; }
section { padding-block: 48px; scroll-margin-top: 28px; }
section + section { border-top: 1px solid var(--rule); }
h2 { font-size: clamp(1.9rem,3vw,2.5rem); line-height: 1.2; margin: 0 0 20px; }
h3 { font: 600 18px/1.5 var(--font-sans); margin: 28px 0 8px; }
h4 { font: 600 16px/1.5 var(--font-sans); margin: 0 0 8px; }
section p, dd { font-size: 16px; line-height: 1.75; margin: 0 0 20px; }
section .small { font-size: 14px; line-height: 1.6; }
.section-intro { max-width: 64ch; }
.outputs { width: 100%; border-collapse: collapse; table-layout: fixed; }
.outputs th { text-align: left; font-size: 14px; color: var(--ink-muted); font-weight: 500; padding: 16px 24px; }
.outputs td { vertical-align: top; font-size: 16px; line-height: 1.65; padding: 24px; border-top: 1px solid var(--rule); }
.outputs th:first-child { width: 28%; }
.outputs th:last-child { width: 30%; }
.outputs th:nth-child(2), .outputs td:nth-child(2) { background: var(--paper-inset); }
.outputs td:first-child { font-weight: 600; }
.mobile-label { display: none; }
.table-note { margin-top: 20px; }
.split { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1.5fr); gap: clamp(32px,6vw,80px); }
.section-lead { max-width: 45ch; }
.sample { margin: 0; padding: 28px; background: var(--paper-inset); border: 1px solid var(--rule); border-radius: 4px; }
.sample figcaption { font-size: 13px; color: var(--ink-muted); }
.sample h3 { font: 400 28px/1.2 var(--font-display); margin: 16px 0 24px; }
.sample ol { list-style: none; padding: 0; margin: 0; }
.sample li { display: grid; grid-template-columns: 108px minmax(0,1fr); gap: 16px; padding-block: 20px; border-top: 1px solid var(--rule); }
.state-label { font-size: 13px; color: var(--ink-muted); line-height: 1.5; }
.sample li p { font-size: 15px; margin-bottom: 0; }
.sample > p { margin: 4px 0 0; }
.first-heading { margin-top: 0; }
dl { margin: 0; }
dl > div { margin-block: 20px; }
dt { font-weight: 600; margin-bottom: 6px; }
dd { margin-inline: 0; }
details { border-block-end: 1px solid var(--rule); }
summary { min-height: 54px; padding-block: 14px; cursor: pointer; font-size: 15px; font-weight: 600; }
.method-details { border-top: 1px solid var(--rule); margin-top: 28px; }
.setup { padding: 8px 0 20px; }
.steps { padding-left: 24px; }
.steps li { padding-left: 8px; margin-block: 20px; }
.setup code { display: block; white-space: normal; overflow-wrap: anywhere; font-size: 14px; }
blockquote { margin: 20px 0 0; border-left: 2px solid var(--rule); padding-left: 16px; font-size: 15px; line-height: 1.7; }
textarea { width: 100%; min-height: 256px; resize: vertical; border: 1px solid var(--rule); border-radius: 4px; padding: 20px; color: var(--ink); background: var(--paper-inset); font: 400 16px/1.7 var(--font-sans); }
.downloads { list-style: none; padding: 0; margin: 0; }
.downloads li { border-bottom: 1px solid var(--rule); padding-block: 20px; }
.downloads li:first-child { padding-top: 0; }
.downloads a { min-height: 44px; }
.downloads p { margin: 4px 0 0; font-size: 15px; }
.format { margin-left: 12px; }
.check { margin-top: 24px; }
.guide-ending { border-top: 1px solid var(--rule); padding-top: 32px; }
.guide-ending > p { max-width: 75ch; line-height: 1.7; }
.references { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 8px 24px; }
.references a { display: inline-flex; align-items: center; min-height: 44px; font-size: 14px; text-underline-offset: 4px; }
@media(max-width: 1000px) {
  .split { grid-template-columns: minmax(0,1fr); gap: 28px; }
  .section-lead { max-width: 70ch; }
  .outputs th, .outputs td { padding: 16px; }
  .sample li { grid-template-columns: 140px minmax(0,1fr); }
}
@media(max-width: 600px) {
  section { padding-block: 32px; }
  .guide-nav { gap: 0 20px; }
  .outputs, .outputs tbody, .outputs tr, .outputs td { display: block; width: 100%; }
  .outputs thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .outputs tr { border-top: 1px solid var(--rule); padding-block: 16px; }
  .outputs td { border: 0; padding: 8px 0; }
  .outputs td:nth-child(2) { background: transparent; }
  .mobile-label { display: block; font-size: 13px; font-weight: 400; color: var(--ink-muted); margin-bottom: 4px; }
  .sample { padding: 20px; }
  .sample li { grid-template-columns: minmax(0,1fr); gap: 8px; }
  .format { display: block; margin-left: 0; }
}
</style>
