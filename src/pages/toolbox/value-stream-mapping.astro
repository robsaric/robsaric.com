---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Arrow from '../../components/Arrow.astro';
import { VALUE_STREAM as V } from '../../data/value-stream-mapping';
---
<BaseLayout title={V.title} description={V.description} ogImageAlt={V.promise}>
  <div class="wrap guide">
    {import.meta.env.DEV && <p class="preview">{V.preview}</p>}
    <header>
      <a class="text-link back" href="/toolbox/">{V.back}</a>
      <p class="kind"><strong>{V.category}</strong> · {V.formats}</p>
      <h1>{V.title}</h1>
      <p class="promise">{V.promise}</p>
      <p class="intro">{V.intro}</p>
      <div class="actions"><a class="action" href="#method">{V.start}<Arrow /></a><a class="text-link" href="#downloads">{V.download}<Arrow /></a></div>
      <p class="small">{V.free}</p>
    </header>
    <div class="layout">
      <nav aria-label={V.navLabel}>{V.nav.map(item => <a href={item.href}>{item.label}</a>)}</nav>
      <div class="body">
        <section id="meaning">
          <h2>{V.meaning}</h2><p>{V.explanation}</p><p>{V.distinction}</p>
          <figure class="flow"><figcaption>{V.exampleLabel}</figcaption><ol>{V.example.map((label,i) => <li class:list={{ waiting: i === 2 }}>{label}</li>)}</ol><p>{V.exampleNote}</p></figure>
          <h3>{V.bringHeading}</h3><dl>{V.bring.map(item => <div><dt>{item.title}</dt><dd>{item.text}</dd></div>)}</dl><p class="small">{V.privacy}</p>
        </section>
        <section id="method">
          <h2>{V.methodHeading}</h2><p>{V.methodIntro}</p>
          <ol class="steps">{V.steps.map(step => <li><h3>{step.title}</h3><p>{step.text}</p></li>)}</ol>
          <figure class="views"><figcaption>{V.viewsHeading}</figcaption><ol>{V.views.map(view => <li><h3>{view.title}</h3><p>{view.text}</p></li>)}</ol><p class="small">{V.viewsNote}</p></figure>
        </section>
        <section id="prompt">
          <h2>{V.promptHeading}</h2><p>{V.promptIntro}</p>
          <label class="visually-hidden" for="vsm-prompt">{V.promptLabel}</label>
          <textarea id="vsm-prompt" readonly rows="10" spellcheck="false">{V.prompt}</textarea>
          <div class="actions"><button class="action" id="copy-vsm" type="button" hidden data-copied={V.copied} data-fallback={V.fallback} data-select={V.select}>{V.copy}</button><p class="small" id="copy-status" role="status" aria-live="polite"></p></div>
          <noscript><p>{V.noScript}</p></noscript>
        </section>
        <section id="downloads">
          <h2>{V.downloadsHeading}</h2><p>{V.downloadsIntro}</p>
          <ul class="downloads">{V.files.map(file => <li><a class="text-link" href={file.href} download>{file.title}<Arrow /></a><span class="small format">{file.format}</span><p>{file.text}</p></li>)}</ul>
          <a class="text-link" href="/downloads/value-stream-mapping/value-stream-mapping/SKILL.md">{V.sourceLabel}<Arrow /></a>
          <h3>{V.setupHeading}</h3>
          {V.setups.map(setup => <details><summary>{setup.name}</summary><div class="setup"><p>{setup.body}</p>{setup.path && <code>{setup.path}</code>}<blockquote>{setup.invoke}</blockquote></div></details>)}
          <p class="small check">{V.setupCheck}</p>
          <a class="text-link" href="/downloads/value-stream-mapping/installation.md">{V.installLabel}<Arrow /></a>
        </section>
        <section>
          <h2>{V.endingHeading}</h2><p>{V.ending}</p>
          <p class="small">{V.referencesLabel}</p><ul class="references">{V.references.map(ref => <li><a href={ref.href}>{ref.label}</a></li>)}</ul>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>
<script>
  const button = document.querySelector<HTMLButtonElement>('#copy-vsm');
  const input = document.querySelector<HTMLTextAreaElement>('#vsm-prompt');
  const status = document.querySelector<HTMLElement>('#copy-status');
  if (button && input && status) {
    button.hidden = false;
    if (!navigator.clipboard?.writeText) button.textContent = button.dataset.select ?? '';
    button.addEventListener('click', async () => {
      try {
        if (!navigator.clipboard?.writeText) throw new Error('clipboard unavailable');
        await navigator.clipboard.writeText(input.value);
        status.textContent = button.dataset.copied ?? '';
      } catch {
        input.focus(); input.select(); input.setSelectionRange(0,input.value.length);
        status.textContent = button.dataset.fallback ?? '';
      }
    });
  }
</script>
<style>
  .guide { padding-block: 24px 80px; }
  .preview { font-size: 13px; color: var(--ink-muted); border-bottom: 1px solid var(--rule); padding-bottom: 12px; }
  header { max-width: 980px; padding-block: 16px 36px; }
  .back { font-size: 14px; color: var(--ink-muted); }
  .kind { font-size: 14px; margin: 22px 0 14px; color: var(--ink-muted); }
  h1 { font-size: clamp(2.8rem, 6vw, 5.3rem); line-height: 1.08; margin: 0 0 20px; text-wrap: balance; }
  .promise { font: 400 clamp(1.6rem, 3vw, 2.3rem)/1.3 var(--font-display); margin: 0 0 18px; }
  .intro { font-size: 18px; line-height: 1.7; max-width: 56ch; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; margin-block: 24px 12px; }
  .small { font-size: 14px; line-height: 1.6; color: var(--ink-muted); }
  .layout { display: grid; grid-template-columns: minmax(150px,.4fr) minmax(0,1.6fr); gap: clamp(32px,7vw,90px); border-top: 1px solid var(--rule); padding-top: 32px; }
  nav { align-self: start; display: flex; flex-direction: column; }
  nav a { min-height: 44px; padding: 10px 0; font-size: 14px; color: var(--ink-muted); text-underline-offset: 4px; }
  .body { min-width: 0; max-width: 72ch; }
  section { scroll-margin-top: 28px; }
  section + section { margin-top: 40px; padding-top: 36px; border-top: 1px solid var(--rule); }
  h2 { font-size: clamp(1.9rem,3vw,2.5rem); line-height: 1.2; margin: 0 0 20px; }
  h3 { font: 600 18px/1.5 var(--font-sans); margin: 28px 0 8px; }
  .body p, dd { font-size: 17px; line-height: 1.75; margin: 0 0 20px; }
  .body .small { font-size: 14px; }
  dl { margin: 24px 0; }
  dt { font-weight: 600; margin-bottom: 6px; }
  dd { margin-left: 0; }
  .flow, .views { margin: 32px 0; padding: 24px; background: var(--paper-inset); border: 1px solid var(--rule); border-radius: 4px; }
  figcaption { font-size: 14px; font-weight: 600; margin-bottom: 22px; }
  .flow ol { list-style: none; display: flex; flex-wrap: wrap; align-items: center; gap: 12px; padding: 0; margin: 0 0 24px; }
  .flow li { padding: 10px 14px; border: 1px solid var(--rule); border-radius: 3px; font-size: 14px; line-height: 1.5; }
  .flow li + li::before { content: '→'; margin-right: 10px; }
  .flow .waiting { border-style: dashed; font-weight: 600; }
  .flow p { font-size: 15px; margin: 0; }
  .steps { padding-left: 24px; }
  .steps li { padding-left: 10px; margin-bottom: 24px; }
  .steps h3 { margin-top: 0; }
  .views ol { list-style: none; display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 20px; padding: 0; margin: 0 0 24px; }
  .views h3 { margin: 0 0 12px; font-size: 16px; }
  .views li + li { border-left: 1px solid var(--rule); padding-left: 20px; }
  .views p { font-size: 15px; margin: 0; }
  textarea { width: 100%; min-height: 240px; resize: vertical; background: var(--paper-inset); color: var(--ink); border: 1px solid var(--rule); border-radius: 4px; padding: 18px; font: 16px/1.65 var(--font-sans); }
  button { cursor: pointer; }
  .downloads { list-style: none; padding: 0; }
  .downloads li { padding: 18px 0; border-bottom: 1px solid var(--rule); }
  .format { display: inline-block; margin-left: 16px; }
  .downloads p { font-size: 15px; margin: 8px 0 0; color: var(--ink-muted); }
  details { border-top: 1px solid var(--rule); }
  summary { min-height: 54px; padding: 16px 0; cursor: pointer; font-size: 16px; font-weight: 600; }
  .setup p { font-size: 16px; }
  code { display: block; overflow-wrap: anywhere; padding: 16px; background: var(--paper-inset); font-size: 14px; }
  blockquote { margin: 16px 0 24px; padding-left: 18px; border-left: 2px solid var(--rule); line-height: 1.7; overflow-wrap: anywhere; }
  .body .check { margin-top: 24px; }
  .references { padding-left: 20px; font-size: 14px; line-height: 1.7; }
  .references a { display: inline-flex; align-items: center; min-height: 44px; }
  @media (max-width: 900px) { .layout { grid-template-columns: minmax(0,1fr); gap: 28px; } nav { flex-direction: row; flex-wrap: wrap; gap: 0 24px; } }
  @media (max-width: 600px) {
    .guide { padding-block: 12px 56px; }
    header { padding-bottom: 24px; }
    .actions { gap: 12px 20px; }
    .views ol { grid-template-columns: 1fr; gap: 18px; }
    .views li + li { border-left: 0; border-top: 1px solid var(--rule); padding-left: 0; padding-top: 18px; }
    .flow, .views { padding: 20px; }
    .flow ol { flex-direction: column; align-items: stretch; }
    .flow li + li::before { content: '↓'; }
    section + section { margin-top: 28px; padding-top: 28px; }
  }
</style>
