---
import BaseLayout from '../layouts/BaseLayout.astro';
import Principles from '../components/Principles.astro';
import Arrow from '../components/Arrow.astro';
import { BELIEFS_PAGE as B } from '../data/principles';
---
<BaseLayout title={B.title} description={B.description}>
  <div class="beliefs-page wrap">
    <header>
      <h1>{B.title}<span aria-hidden="true">.</span></h1>
      <p>{B.intro}</p>
    </header>
    <Principles />
    <aside class="beliefs-closing">
      <h2>{B.closing}</h2>
      <div><p>{B.closingBody}</p><div class="closing-links"><a class="text-link" href="/contact/">{B.contact}<Arrow /></a><a class="text-link" href="/building/">{B.building}<Arrow /></a></div></div>
    </aside>
  </div>
</BaseLayout>
<style>
.beliefs-page { max-width: 1280px; padding-block: 64px 80px; }
header { display: grid; grid-template-columns: 1fr 1.2fr; gap: clamp(40px,7vw,100px); align-items: end; padding-bottom: 56px; margin-bottom: 56px; border-bottom: 1px solid var(--ink); }
h1 { font-size: clamp(3rem,6vw,5rem); font-weight: 400; line-height: 1.05; margin: 0; max-width: 10ch; }
h1 span { color: var(--blue); }
header p { font-size: 21px; line-height: 1.6; max-width: 42ch; margin: 0; }
.beliefs-closing { display: grid; grid-template-columns: 1fr 1.2fr; gap: clamp(40px,7vw,100px); margin-top: 64px; padding-top: 40px; border-top: 1px solid var(--ink); }
.beliefs-closing h2 { font-size: 26px; line-height: 1.3; max-width: 22ch; margin: 0; }
.beliefs-closing p { font-size: 17px; line-height: 1.7; margin: 0 0 18px; max-width: 58ch; }
.closing-links { display: flex; flex-wrap: wrap; gap: 8px 24px; font-size: 14px; }
@media (max-width: 767.98px) {
 .beliefs-page { padding-block: 36px 56px; }
 header, .beliefs-closing { grid-template-columns: minmax(0,1fr); gap: 24px; }
 header { padding-bottom: 32px; margin-bottom: 32px; }
 h1 { font-size: 52px; }
 header p { font-size: 18px; }
 .beliefs-closing { margin-top: 40px; padding-top: 32px; }
}
</style>
