---
import BaseLayout from '../layouts/BaseLayout.astro';
import { EDITORIAL as E } from '../data/editorial';
import { SITE } from '../data/site';
import { UI } from '../data/ui';
import Arrow from '../components/Arrow.astro';
---
<BaseLayout title={UI.nav.writeToMe} description={E.contact.body}>
  <section class="wrap contact">
    <h1>{E.contact.heading}</h1><p>{E.contact.body}</p>
    <div><a class="action" href={`mailto:${SITE.email}`}>{SITE.email}<Arrow /></a><a class="text-link" href={SITE.links.linkedin} target="_blank" rel="noopener">{UI.footer.linkedin}<Arrow diagonal /></a></div>
  </section>
</BaseLayout>
<style>
.contact { padding-block: 96px 120px; }
h1 { max-width: 14ch; font-size: clamp(3rem,6vw,5.5rem); margin: 0 0 32px; font-weight: 400; }
p { font-size: 21px; line-height: 1.65; max-width: 48ch; margin: 0 0 32px; }
.contact > div { display: flex; flex-wrap: wrap; align-items: center; gap: 20px 32px; }
@media (max-width: 767.98px) { .contact { padding-block: 48px 64px; } p { font-size: 18px; } .action { padding-inline: 16px; } }
</style>
