---
import BaseLayout from '../layouts/BaseLayout.astro';
import { COPY } from '../data/copy';
import { NEWSLETTER as N } from '../data/newsletter';
import { EDITORIAL as E } from '../data/editorial';
import Newsletter from '../components/Newsletter.astro';
import { privateHeaders } from '../lib/newsletter-http';

export const prerender = false;
for (const [name, value] of privateHeaders()) Astro.response.headers.set(name, value);

type SubscribedStatus =
  keyof typeof COPY.subscribed.states;

const requestedStatus =
  Astro.url.searchParams.get('status');

const status: SubscribedStatus =
  requestedStatus
  && Object.hasOwn(
    COPY.subscribed.states,
    requestedStatus,
  )
    ? requestedStatus as SubscribedStatus
    : 'pending';

const state = COPY.subscribed.states[status];
const description = [
  state.body.beforeLink,
  state.body.link,
  state.body.afterLink,
].join('');
---

<BaseLayout
  title={state.heading}
  description={description}
  noindex
>
  <div class="subscribed">
    <h1>{state.heading}</h1>

    <p>
      {state.body.beforeLink}
      {state.body.link && (
        <a href="/contact/">{state.body.link}</a>
      )}
      {state.body.afterLink}
    </p>

    {status === 'pending' && <p class="subscribed__help">{COPY.subscribed.pendingHelp}</p>}
    {(status === 'invalid' || status === 'invalidlink' || status === 'error') && <Newsletter id="signup-retry" recovery />}

    <a class="subscribed__back" href={E.newsletter.sampleHref}>
      {N.read}
    </a>
  </div>
</BaseLayout>

<style>
  .subscribed {
    width: 100%;
    max-width: 880px;
    margin: 0 auto;
    padding: var(--section-pad-desktop) var(--gutter-desktop);
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  h1 {
    max-width: 60ch;
    margin: 0;
    font-size: 48px;
    line-height: 1.1;
    letter-spacing: -0.028em;
    text-wrap: pretty;
  }

  p {
    max-width: 60ch;
    margin: 0;
    font-size: 18px;
    line-height: var(--lh-body);
    text-wrap: pretty;
  }

  .subscribed__back {
    min-height: var(--tap-min);
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    font-size: 16px;
    font-weight: 600;
  }
  .subscribed__help { font-size: 15px; color: var(--ink-muted); }

  @media (max-width: 767.98px) {
    .subscribed {
      padding: var(--section-pad-mobile) var(--gutter-mobile);
    }

    h1 { font-size: 34px; }
    p { font-size: 17px; }
  }
</style>
