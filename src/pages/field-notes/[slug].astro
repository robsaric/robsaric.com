---
import { render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { STAGES } from '../../data/stages';
import { SITE } from '../../data/site';
import { UI } from '../../data/ui';
import { clampDescription } from '../../lib/seo';
import {
  formatNoteDate,
  getPublishedNotes,
  noteHref,
  type NoteEntry,
} from '../../lib/notes';

interface Props {
  entry: NoteEntry;
}

export async function getStaticPaths() {
  const notes = await getPublishedNotes();

  return notes.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const stage = entry.data.stage >= 0 ? STAGES[entry.data.stage]?.name : undefined;
const eyebrow = [
  entry.data.type,
  formatNoteDate(entry.data.date),
  stage,
].filter(Boolean).join(UI.section.separator);
const description = clampDescription(
  entry.data.description ?? entry.data.summary,
);
const pageUrl = new URL(noteHref(entry), Astro.site ?? SITE.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: entry.data.title,
  description,
  datePublished: entry.data.date.toISOString(),
  dateModified: (entry.data.updated ?? entry.data.date).toISOString(),
  url: pageUrl,
  mainEntityOfPage: pageUrl,
  image: new URL(`/og/notes/${entry.id}.png`, Astro.site ?? SITE.url).href,
  author: {
    '@type': 'Person',
    name: SITE.author.name,
    url: new URL('/about/', SITE.url).href,
  },
};
---

<ArticleLayout
  title={entry.data.title}
  description={description}
  ogImage={`/og/notes/${entry.id}.png`}
  ogImageAlt={UI.meta.noteOgImageAlt(entry.data.type, entry.data.title)}
  eyebrow={eyebrow}
  date={entry.data.date}
  publishedTime={entry.data.date}
  modifiedTime={entry.data.updated}
  showByline
  backHref="/field-notes/"
  backLabel={UI.article.backToFieldNotes}
  jsonLd={jsonLd}
>
  <Content />
</ArticleLayout>
