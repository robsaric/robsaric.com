---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CurrentWork from '../components/CurrentWork.astro';
import FieldNotes from '../components/FieldNotes.astro';
import About from '../components/About.astro';
import WriteToMe from '../components/WriteToMe.astro';
import { getPublishedNotes } from '../lib/notes';
import { SITE } from '../data/site';
import { UI } from '../data/ui';

const notes = await getPublishedNotes();

const sameAs = [
  SITE.links.linkedin,
  SITE.links.x,
  SITE.links.github,
].filter(Boolean);

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.author.name,
  url: SITE.url,
  jobTitle: SITE.author.jobTitle,
  sameAs,
  worksFor: {
    '@type': 'Organization',
    name: UI.nav.caretrics,
    url: SITE.caretricsUrl,
  },
};
---

<BaseLayout jsonLd={personJsonLd}>
  <Hero />
  <CurrentWork />
  <FieldNotes
    notes={notes}
    limit={3}
    showHeaderLink
    compact
  />
  <About />
  <WriteToMe />
</BaseLayout>
