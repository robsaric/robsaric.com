---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Arrow from '../components/Arrow.astro';
import ReadingList from '../components/ReadingList.astro';
import WorkingSketch from '../components/WorkingSketch.astro';
import Connect from '../components/Connect.astro';
import portrait from '../assets/images/rob-portrait.jpg';
import hiking from '../assets/images/rob-hiking.jpg';
import { EDITORIAL as E } from '../data/editorial';
import { SITE } from '../data/site';
import { getEarlierWriting, getRecentWriting } from '../lib/editorial';
const earlier = await getEarlierWriting();
const recent = await getRecentWriting();
const featured = recent.find(item => item.href.includes('small-teams-deserve-their-time-back')) ?? recent[0];
const selections = [recent.find(item => item.href.includes('building-with-ai-and-life-beyond-the-feed')) ?? recent.find(item => item !== featured), earlier[0]].filter((item): item is NonNullable<typeof item> => Boolean(item));
const personJsonLd = { '@context': 'https://schema.org', '@type': 'Person', name: SITE.name, url: SITE.url, jobTitle: SITE.author.jobTitle, sameAs: [SITE.links.linkedin, SITE.links.github] };
---
<BaseLayout jsonLd={personJsonLd}>
  <section class="hero wrap">
    <div class="hero-copy">
      <h1>{E.hero.heading} <span>{E.hero.emphasis}</span></h1>
      <p class="hero-lead">{E.hero.lead}</p>
      <p class="hero-intro">{E.hero.intro}</p>
      <div class="hero-actions"><a class="action" href="/field-notes/">{E.hero.read}<Arrow /></a><a class="text-link" href={SITE.links.linkedin} target="_blank" rel="noopener">{E.hero.follow}<Arrow diagonal /></a></div>
    </div>
    <figure class="hero-portrait">
      <Image src={portrait} alt={E.hero.portraitAlt} width={460} height={554} widths={[400, 600, 920]} sizes="(max-width: 767px) calc(100vw - 48px), 38vw" loading="eager" fetchpriority="high" />
      <figcaption>{E.hero.caption}</figcaption>
    </figure>
  </section>
  <section class="writing wrap" aria-labelledby="writing-title">
    <div class="section-heading"><h2 id="writing-title">{E.writing.title}</h2><a class="text-link" href="/field-notes/">{E.writing.all}<Arrow /></a></div>
    <div class="writing-grid">
      {featured && <article class="featured">
        <h3><a href={featured.href}>{featured.title}<Arrow diagonal /></a></h3>
        <p>{featured.summary}</p>
        <div class="featured-date"><time datetime={featured.date.toISOString()}>{new Intl.DateTimeFormat('en-CA', { month: 'short', year: 'numeric', timeZone: 'UTC' }).format(featured.date)}</time></div>
      </article>}
      <ReadingList items={selections} compact />
    </div>
  </section>
  <WorkingSketch />
  <section id="work" class="work wrap" aria-labelledby="work-title">
    <div class="work-heading"><h2 id="work-title">{E.work.heading}</h2><p>{E.work.intro}</p></div>
    <div class="project">
      <div class="project-name"><h3>{E.work.togetheren.name}</h3><p>{E.work.togetheren.status}</p></div>
      <div class="project-detail"><p>{E.work.togetheren.body}</p><div class="skillnav"><h4>{E.work.togetheren.child}<span>{E.work.togetheren.childStatus}</span></h4><p>{E.work.togetheren.childBody}</p></div><a class="text-link" href="/contact/">{E.work.togetheren.link}<Arrow /></a></div>
    </div>
    <div class="project">
      <div class="project-name"><h3>{E.work.caretrics.name}</h3><p>{E.work.caretrics.status}</p></div>
      <div class="project-detail"><p>{E.work.caretrics.body}</p><a class="text-link" href={SITE.caretricsUrl} target="_blank" rel="noopener">{E.work.caretrics.link}<Arrow diagonal /></a></div>
    </div>
  </section>
  <section class="personal" aria-labelledby="personal-title">
    <div class="wrap personal-layout">
      <figure><Image src={hiking} alt={E.about.hikingAlt} width={620} height={550} widths={[400, 620, 1240]} sizes="(max-width: 767px) calc(100vw - 48px), 45vw" loading="lazy" fit="cover" /></figure>
      <div><h2 id="personal-title">{E.personal.heading}</h2><p data-personal-copy>{E.personal.body}</p><p>{E.personal.bodyTwo}</p><a class="text-link" href="/about/">{E.personal.link}<Arrow /></a></div>
    </div>
  </section>
  <Connect />
</BaseLayout>
<style>
.hero { display: grid; grid-template-columns: minmax(0,1.35fr) minmax(0, .85fr); gap: clamp(40px, 6vw, 88px); padding-top: 72px; padding-bottom: 88px; align-items: center; }
h1 { font-weight: 800; margin: 0 0 30px; font-size: var(--text-hero); line-height: 1.04; max-width: 12ch; }
h1 span { color: var(--blue); display: block; }
.hero-lead { max-width: 40ch; font-size: 21px; line-height: 1.55; margin: 0 0 22px; }
.hero-intro { max-width: 48ch; font-size: 16px; line-height: 1.7; color: var(--ink-muted); margin: 0; }
.hero-actions { display: flex; flex-wrap: wrap; gap: 16px 24px; align-items: center; margin-top: 30px; }
.hero-actions .text-link { font-size: 14px; }
.hero-portrait { margin: 0; padding-top: 12px; }
.hero-portrait img { display: block; width: 100%; height: auto; aspect-ratio: 460 / 554; object-fit: cover; border-radius: 48% 48% 4px 4px; }
.hero-portrait figcaption { margin-top: 18px; padding-top: 16px; border-top: 1px solid var(--rule); font-size: 13px; color: var(--ink-muted); }
.writing { padding-block: 64px 96px; border-top: 1px solid var(--rule); }
.section-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 32px; margin-bottom: 40px; }
.section-heading h2 { font-size: var(--text-h2); max-width: 18ch; margin: 0; }
.section-heading .text-link { white-space: nowrap; }
.writing-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; }
.featured { background: var(--sky); padding: 40px; display: flex; flex-direction: column; align-items: flex-start; }
.featured h3 { font-size: clamp(1.8rem, 3vw, 2.75rem); margin: 0 0 24px; line-height: 1.16; }
.featured h3 a { color: var(--blue); text-decoration: none; }
.featured h3 a:hover { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 6px; }
.featured h3 :global(.arrow) { margin-left: 8px; }
.featured p { max-width: 36ch; font-size: 18px; line-height: 1.6; margin: 0 0 30px; }
.featured-date { font-size: 13px; margin-top: auto; color: var(--ink-muted); }
.work { padding-block: 104px; scroll-margin-top: 24px; }
.work-heading { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: start; margin-bottom: 56px; }
.work-heading h2 { font-size: var(--text-h2); max-width: 14ch; margin: 0; }
.work-heading p { max-width: 44ch; font-size: 19px; line-height: 1.65; margin: 0; color: var(--ink-muted); }
.project { border-top: 1px solid var(--rule); padding: 40px 0; display: grid; grid-template-columns: 1fr 1fr; gap: 64px; }
.project:last-child { padding-bottom: 0; }
.project-name h3 { font-size: 35px; margin: 0 0 12px; }
.project-name p { color: var(--ink-muted); font-size: 13px; margin: 0; }
.project-detail > p { font-size: 18px; line-height: 1.7; max-width: 54ch; margin: 0 0 20px; }
.skillnav { padding: 20px 0; margin: 24px 0 8px; border-top: 1px solid var(--rule); }
.skillnav h4 { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; font-size: 20px; margin: 0 0 12px; font-family: var(--font-display); }
.skillnav h4 span { font: 400 12px var(--font-sans); padding: 5px 8px; border-radius: 3px; background: var(--sky); }
.skillnav p { font-size: 16px; line-height: 1.7; margin: 0; color: var(--ink-muted); }
.personal { padding: 0 0 104px; }
.personal-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }
.personal figure { margin: 0; }
.personal img { display: block; width: 100%; height: auto; border-radius: 4px; }
.personal h2 { font-size: clamp(2rem, 3.4vw, 3rem); margin: 0 0 24px; max-width: 20ch; }
.personal p { font-size: 17px; line-height: 1.7; margin: 0 0 20px; }
@media (min-width: 768px) and (max-width: 1050px) {
 .hero { gap: 36px; }
 .hero-actions { gap: 8px; }
 .writing-grid, .work-heading, .project, .personal-layout { gap: 36px; }
 .featured { padding: 28px; }
}
@media (max-width: 767.98px) {
 .hero { padding-top: 40px; padding-bottom: 56px; grid-template-columns: minmax(0,1fr); gap: 36px; }
 h1 { font-size: clamp(2.85rem, 11vw, 4.5rem); margin-bottom: 24px; max-width: 13ch; }
 .hero-lead { font-size: 19px; }
 .hero-intro { font-size: 16px; }
 .hero-actions { gap: 12px 20px; margin-top: 26px; }
 .hero-portrait { padding: 0; width: 100%; }
 .hero-portrait img { aspect-ratio: 1.12; object-position: 50% 30%; border-radius: 120px 120px 4px 4px; }
 .writing { padding-block: 48px 56px; }
 .section-heading { align-items: flex-start; flex-direction: column; gap: 16px; margin-bottom: 24px; }
 .writing-grid, .work-heading, .project, .personal-layout { grid-template-columns: minmax(0,1fr); gap: 28px; }
 .featured { padding: 28px; }
 .featured h3 { font-size: 29px; }
 .featured p { font-size: 17px; }
 .work { padding-block: 56px; }
 .work-heading { gap: 22px; margin-bottom: 36px; }
 .work-heading p { font-size: 17px; }
 .project { padding: 30px 0; gap: 24px; }
 .project-name h3 { font-size: 30px; }
 .project-detail > p { font-size: 17px; }
 .personal { padding-bottom: 56px; }
 .personal img { aspect-ratio: 1.2; object-fit: cover; }
}
</style>
