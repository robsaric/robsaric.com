---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Arrow from '../components/Arrow.astro';
import ReadingList from '../components/ReadingList.astro';
import FeaturedEssay from '../components/FeaturedEssay.astro';
import EditorialCharacter from '../components/EditorialCharacter.astro';
import HalloweenCharacter from '../components/HalloweenCharacter.astro';
import { HERO_SCENE } from '../data/hero-scenes';

import Connect from '../components/Connect.astro';
import hiking from '../assets/images/rob-hiking.jpg';
import { EDITORIAL as E } from '../data/editorial';
import { SITE } from '../data/site';
import { getEarlierWriting, getRecentWriting } from '../lib/editorial';
const [earlier, recent] = await Promise.all([getEarlierWriting(), getRecentWriting()]);
const featured = recent.find(item => item.href === E.writing.featuredHref);
// The supporting essays broaden the view beyond the featured essay.
const selections = [
  recent.find(item => item.href.includes('small-teams-deserve-their-time-back')) ?? earlier[2],
  recent.find(item => item.href.includes('building-with-ai-and-life-beyond-the-feed')) ?? earlier[0],
].filter((item): item is NonNullable<typeof item> => Boolean(item));
const personJsonLd = { '@context': 'https://schema.org', '@type': 'Person', name: SITE.name, url: SITE.url, jobTitle: SITE.author.jobTitle, sameAs: [SITE.links.linkedin, SITE.links.github] };
---
<BaseLayout jsonLd={personJsonLd} theme="warm">
  <section class="hero wrap">
    <div class="hero-copy">
      <p class="hero-identity">{E.hero.identity} <a href="https://caretrics.com/">{E.hero.identityCompany}</a><span aria-hidden="true"> · </span>{E.hero.identityContext}</p>
      <h1>{E.hero.heading} <span>{E.hero.emphasis} <em>{E.hero.markedWord}</em></span></h1>
      <p class="hero-lead">{E.hero.lead}</p>
      <div class="hero-actions"><a class="action" href="#start-here">{E.hero.read}<Arrow /></a><a class="text-link" href="/building/">{E.hero.work}<Arrow /></a></div>
    </div>
    <div class="hero-character">
      {HERO_SCENE === 'halloween' ? <HalloweenCharacter /> : <>
        <div class="day-character"><EditorialCharacter variant="runner" /></div>
        <div class="night-character"><EditorialCharacter variant="reader" /></div>
      </>}
    </div>
  </section>
  <section id="start-here" class="writing wrap" aria-labelledby="writing-title">
    <h2 id="writing-title" class="visually-hidden">{E.writing.pageHeading}</h2>
    <div class="writing-selections">
      {featured && <FeaturedEssay item={featured} />}
      <ReadingList items={selections} compact paired />
    </div>
  </section>
  <Connect newsletterOnly />
  <section id="work" class="work wrap" aria-labelledby="work-title">
    <div id="caretrics" class="work-heading"><h2 id="work-title">{E.work.heading}</h2><div><p>{E.work.intro}</p><a class="text-link" href="/building/">{E.work.link}<Arrow /></a></div></div>
    <div class="work-example">
      <div class="work-story"><h3>{E.work.example.heading}</h3><p>{E.work.example.story}</p><p>{E.work.example.lesson}</p></div>
      <figure class="work-evolution">
        <figcaption>{E.work.example.caption}</figcaption>
        <ol>{E.work.example.steps.map(step => <li><span>{step.label}</span><p>{step.body}</p></li>)}</ol>
        <p class="work-next"><strong>{E.work.example.nextLabel}</strong> {E.work.example.next}</p>
      </figure>
    </div>
  </section>
  <section class="personal" aria-labelledby="personal-title">
    <div class="wrap personal-layout">
      <figure><Image src={hiking} alt={E.about.hikingAlt} width={400} height={360} widths={[400, 800]} sizes="(max-width: 767px) calc(100vw - 48px), 32vw" loading="lazy" fit="cover" /></figure>
      <div><h2 id="personal-title">{E.personal.heading}</h2><p data-personal-copy>{E.personal.body}</p><p>{E.personal.bodyTwo}</p><a class="text-link" href="/about/">{E.personal.link}<Arrow /></a></div>
    </div>
  </section>
</BaseLayout>
<style>
.hero { display: grid; grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr); gap: 32px; align-items: end; padding-top: 48px; padding-bottom: 56px; }
.hero-identity { color: var(--ink-muted); font-size: 14px; margin: 0 0 18px; }
.hero-identity a { color: var(--ink); text-underline-offset: 4px; }
h1 { font-family: var(--font-editorial); font-weight: 400; margin: 0 0 28px; font-size: clamp(3.25rem, 5.2vw, 5.25rem); line-height: 1.08; letter-spacing: -.025em; text-wrap: initial; }
h1 > span { display: block; text-wrap: balance; }
h1 em { font-weight: inherit; font-style: italic; }
.hero-lead { max-width: 55ch; font-size: 18px; line-height: 1.7; margin: 0; }
.hero-actions { display: flex; flex-wrap: wrap; gap: 16px 24px; align-items: center; margin-top: 26px; }
.hero-actions .action { flex: none; }
.hero-character { min-width: 0; padding-bottom: 8px; }
.hero-character :global(.ink-character) { width: 100%; display: block; }
.hero-character :global(.ink-stage) { width: 100%; height: 272px; border-bottom: 1px solid var(--rule); }
.hero-character :global(.ink-pose) { width: min(256px, 100%); height: auto; }
.hero-character :global(.ink-character--reader .ink-pose) { width: min(280px, 100%); left: 16px; }
.hero-character :global(.ink-stage::after) { display: none; }
.hero-character :global(.ink-toggle) { margin-left: auto; margin-top: 8px; }
.night-character { display: none; }
:global(html[data-appearance="night"]) .day-character { display: none; }
:global(html[data-appearance="night"]) .night-character { display: block; }
.hero-actions .text-link { font-size: 15px; }
.writing { padding-block: 0 56px; scroll-margin-top: 24px; }
.work-heading h2, .work-story h3, .personal h2 { font-family: var(--font-editorial); font-weight: 400; letter-spacing: -.02em; }
.work { padding-block: 80px 88px; scroll-margin-top: 24px; }
.work-heading { display: grid; grid-template-columns: 1fr 1.2fr; gap: 64px; align-items: start; scroll-margin-top: 24px; }
.work-heading h2 { font-size: clamp(2rem, 3.2vw, 2.75rem); font-weight: 400; margin: 0; }
.work-heading p { max-width: 48ch; font-size: 18px; line-height: 1.65; margin: 0; color: var(--ink-muted); }
.work-heading .text-link { margin-top: 20px; }
.work-example { display: grid; grid-template-columns: 1fr 1.2fr; gap: 64px; margin-top: 48px; padding-top: 40px; border-top: 1px solid var(--rule); align-items: start; }
.work-story h3 { font-size: 30px; font-weight: 400; margin: 0 0 20px; }
.work-story p { max-width: 43ch; font-size: 17px; line-height: 1.7; margin: 0 0 16px; }
.work-evolution { margin: 0; padding: 28px 32px; background: var(--surface); border: 1px solid var(--rule); border-radius: 10px; }
.work-evolution figcaption { font-size: 14px; color: var(--ink-muted); margin-bottom: 20px; }
.work-evolution ol { list-style: none; padding: 0; margin: 0; }
.work-evolution li { position: relative; padding: 0 0 22px 25px; border-left: 1px solid var(--rule); }
.work-evolution li::before { content: ''; position: absolute; left: -4px; top: 7px; width: 7px; height: 7px; background: var(--ink-muted); border-radius: 50%; }
.work-evolution li:last-child { border-left-color: transparent; padding-bottom: 0; }
.work-evolution li span { font-size: 18px; font-weight: 500; }
.work-evolution li p { font-size: 14px; line-height: 1.6; margin: 4px 0 0; color: var(--ink-muted); }
.work-next { font-size: 14px; line-height: 1.65; border-top: 1px dashed var(--ink-muted); padding-top: 18px; margin: 22px 0 0; }
.work-next strong { font-weight: 600; }
.personal { padding-block: 64px; background: var(--paper-inset); }
.personal-layout { display: grid; grid-template-columns: minmax(0,400px) minmax(0,600px); gap: 80px; align-items: center; justify-content: center; }
.personal figure { margin: 0; }
.personal img { display: block; width: 100%; height: auto; border-radius: 4px; }
.personal h2 { font-size: clamp(2rem, 3.2vw, 2.75rem); font-weight: 400; margin: 0 0 24px; }
.personal p { font-size: 17px; line-height: 1.7; margin: 0 0 16px; }
@media (min-width: 768px) and (max-width: 1050px) {
 .hero { grid-template-columns: minmax(0,1fr); }
 .hero-copy { max-width: 780px; }
 .hero-character { width: 380px; justify-self: end; }
 .hero-actions { gap: 8px 16px; }
 .work-heading, .work-example, .personal-layout { gap: 36px; }
}
@media (max-width: 767.98px) {
 .hero { grid-template-columns: minmax(0,1fr); gap: 16px; padding-top: 24px; padding-bottom: 32px; }
 .hero-identity { margin-bottom: 22px; }
 h1 { font-size: clamp(2.6rem, 10.8vw, 4.6rem); margin-bottom: 24px; }
 .hero-character { width: min(320px, 100%); justify-self: end; padding-bottom: 0; }
 .hero-character :global(.ink-stage) { height: 184px; }
 .hero-character :global(.ink-pose) { width: 180px; }
 .hero-character :global(.ink-character--reader .ink-pose) { width: 194px; }
 .hero-lead { font-size: 17px; line-height: 1.6; }
 .hero-actions { gap: 8px 12px; margin-top: 20px; }
 .hero-actions .action { font-size: 15px; }
 .hero-actions .text-link { font-size: 14px; }
 .writing { padding-block: 0 40px; }
 .work { padding-block: 40px 48px; }
 .work-heading, .work-example, .personal-layout { grid-template-columns: minmax(0,1fr); gap: 24px; }
 .work-example { margin-top: 28px; padding-top: 28px; }
 .work-evolution { padding: 24px; }
 .work-heading { gap: 18px; }
 .work-heading p { font-size: 17px; }
 .personal { padding-block: 40px; }
 .personal img { aspect-ratio: 1.5; object-fit: cover; }
}
</style>
