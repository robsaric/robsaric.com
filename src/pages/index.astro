---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Arrow from '../components/Arrow.astro';
import ReadingList from '../components/ReadingList.astro';
import FeaturedEssay from '../components/FeaturedEssay.astro';
import Connect from '../components/Connect.astro';
import portrait from '../assets/images/rob-portrait.jpg';
import hiking from '../assets/images/rob-hiking.jpg';
import { EDITORIAL as E } from '../data/editorial';
import { SITE } from '../data/site';
import { getEarlierWriting, getRecentWriting } from '../lib/editorial';
const [earlier, recent] = await Promise.all([getEarlierWriting(), getRecentWriting()]);
const featured = recent.find(item => item.href === E.writing.featuredHref);
// The supporting essays broaden the view beyond the featured essay.
const selections = [
  recent.find(item => item.href.includes('small-teams-deserve-their-time-back')) ?? earlier[2],
  recent.find(item => item.href.includes('building-with-ai-and-life-beyond-the-feed')) ?? earlier[0],
].filter((item): item is NonNullable<typeof item> => Boolean(item));
const personJsonLd = { '@context': 'https://schema.org', '@type': 'Person', name: SITE.name, url: SITE.url, jobTitle: SITE.author.jobTitle, sameAs: [SITE.links.linkedin, SITE.links.github] };
---
<BaseLayout jsonLd={personJsonLd} theme="warm">
  <section class="hero wrap">
    <div class="hero-copy">
      <p class="hero-identity">{E.hero.identity}</p>
      <h1>{E.hero.heading} <span>{E.hero.emphasis} <span class="ink-underline">{E.hero.markedWord}</span></span></h1>
      <p class="hero-lead">{E.hero.lead}</p>
      <div class="hero-actions"><a class="action" href="#start-here">{E.hero.read}<Arrow /></a><a class="text-link" href="/building/">{E.hero.work}<Arrow /></a></div>
    </div>
    <figure class="hero-portrait">
      <Image src={portrait} alt={E.hero.portraitAlt} width={320} height={384} widths={[160, 320, 640]} sizes="(max-width: 767px) 66px, (max-width: 1050px) 25vw, 320px" loading="eager" fetchpriority="high" />
    </figure>
  </section>
  <section id="start-here" class="writing wrap" aria-labelledby="writing-title">
    <div class="section-heading"><h2 id="writing-title">{E.writing.title}</h2><a class="text-link" href="/field-notes/">{E.writing.all}<Arrow /></a></div>
    <div class="writing-selections">
      {featured && <FeaturedEssay item={featured} />}
      <ReadingList items={selections} compact paired />
    </div>
  </section>
  <Connect newsletterOnly />
  <section id="work" class="work wrap" aria-labelledby="work-title">
    <div id="caretrics" class="work-heading"><h2 id="work-title">{E.work.heading}</h2><div><p>{E.work.intro}</p><a class="text-link" href="/building/">{E.work.link}<Arrow /></a></div></div>
  </section>
  <section class="personal" aria-labelledby="personal-title">
    <div class="wrap personal-layout">
      <figure><Image src={hiking} alt={E.about.hikingAlt} width={400} height={360} widths={[400, 800]} sizes="(max-width: 767px) calc(100vw - 48px), 32vw" loading="lazy" fit="cover" /></figure>
      <div><h2 id="personal-title">{E.personal.heading}</h2><p data-personal-copy>{E.personal.body}</p><p>{E.personal.bodyTwo}</p><a class="text-link" href="/about/">{E.personal.link}<Arrow /></a></div>
    </div>
  </section>
</BaseLayout>
<style>
.hero { display: grid; grid-template-columns: minmax(0,1fr) minmax(220px, 320px); gap: clamp(40px, 5vw, 72px); padding-top: 48px; padding-bottom: 56px; align-items: center; }
.hero-identity { color: var(--ink-muted); font-size: 14px; margin: 0 0 18px; }
h1 { font-weight: 800; margin: 0 0 24px; font-size: clamp(2.75rem, 4.45vw, 4rem); line-height: 1.1; text-wrap: initial; }
h1 > span { display: block; }
.hero-lead { max-width: 58ch; font-size: 19px; line-height: 1.6; margin: 0; }
.hero-actions { display: flex; flex-wrap: wrap; gap: 12px 28px; align-items: center; margin-top: 26px; }
.hero-actions .text-link { font-size: 15px; }
.hero-portrait { margin: 0; }
.hero-portrait img { display: block; width: 100%; height: auto; aspect-ratio: 5 / 6; object-fit: cover; object-position: 50% 35%; border-radius: 12px; }
.writing { padding-block: 32px 56px; border-top: 1px solid var(--rule); scroll-margin-top: 24px; }
.section-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; margin-bottom: 24px; }
.section-heading h2 { font-size: 28px; margin: 0; }
.section-heading .text-link { font-size: 14px; }
.work { padding-block: 64px 80px; border-top: 1px solid var(--rule); scroll-margin-top: 24px; }
.work-heading { display: grid; grid-template-columns: 1fr 1.2fr; gap: 64px; align-items: start; scroll-margin-top: 24px; }
.work-heading h2 { font-size: clamp(2rem, 3.2vw, 2.75rem); margin: 0; }
.work-heading p { max-width: 48ch; font-size: 18px; line-height: 1.65; margin: 0; color: var(--ink-muted); }
.work-heading .text-link { margin-top: 20px; }
.personal { padding-block: 64px; background: var(--sky); }
.personal-layout { display: grid; grid-template-columns: minmax(0,400px) minmax(0,600px); gap: 80px; align-items: center; justify-content: center; }
.personal figure { margin: 0; }
.personal img { display: block; width: 100%; height: auto; border-radius: 12px; }
.personal h2 { font-size: clamp(2rem, 3.2vw, 2.75rem); margin: 0 0 24px; }
.personal p { font-size: 17px; line-height: 1.7; margin: 0 0 16px; }
@media (min-width: 768px) and (max-width: 1050px) {
 .hero { grid-template-columns: minmax(0,1fr) minmax(200px, 25%); gap: 32px; }
 .hero-portrait { align-self: start; padding-top: 38px; }
 .hero-actions { gap: 8px 16px; }
 .work-heading, .personal-layout { gap: 36px; }
}
@media (max-width: 767.98px) {
 .hero { position: relative; padding-top: 24px; padding-bottom: 32px; grid-template-columns: minmax(0,1fr); gap: 0; }
 .hero-identity { min-height: 72px; display: flex; align-items: center; max-width: calc(100% - 92px); margin-bottom: 18px; }
 h1 { font-size: clamp(2rem, 8.2vw, 3.5rem); margin-bottom: 20px; }
 .hero-lead { font-size: 17px; line-height: 1.6; }
 .hero-actions { gap: 8px 12px; margin-top: 20px; }
 .hero-actions .action { padding-inline: 12px; font-size: 14px; gap: 10px; }
 .hero-actions .text-link { font-size: 14px; }
 .hero-portrait { position: absolute; top: 24px; right: var(--gutter-mobile); width: 66px; }
 .hero-portrait img { aspect-ratio: 10 / 11; border-radius: 8px; }
 .writing { padding-block: 28px 40px; }
 .section-heading { align-items: center; gap: 16px; margin-bottom: 20px; }
 .section-heading h2 { font-size: 28px; margin: 0; }
 .work { padding-block: 40px 48px; }
 .work-heading, .personal-layout { grid-template-columns: minmax(0,1fr); gap: 24px; }
 .work-heading { gap: 18px; }
 .work-heading p { font-size: 17px; }
 .personal { padding-block: 40px; }
 .personal img { aspect-ratio: 1.5; object-fit: cover; }
}
</style>
