---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import NowStrip from '../components/NowStrip.astro';
import Evidence from '../components/Evidence.astro';
import OperatorProof from '../components/OperatorProof.astro';
import Stages from '../components/Stages.astro';
import Principles from '../components/Principles.astro';
import FieldNotes from '../components/FieldNotes.astro';
import About from '../components/About.astro';
import WriteToMe from '../components/WriteToMe.astro';
import { getPublishedNotes } from '../lib/notes';
import { SITE } from '../data/site';
import { UI } from '../data/ui';

const notes = await getPublishedNotes();

const sameAs = [
  SITE.links.linkedin,
  SITE.links.x,
  SITE.links.github,
].filter(Boolean);

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.author.name,
  url: SITE.url,
  jobTitle: SITE.author.jobTitle,
  sameAs,
  worksFor: {
    '@type': 'Organization',
    name: UI.nav.caretrics,
    url: SITE.caretricsUrl,
  },
};
---

<BaseLayout jsonLd={personJsonLd}>
  <Hero />
  <NowStrip />
  <Evidence />
  <OperatorProof />
  <Stages />
  <Principles />
  <FieldNotes
    notes={notes}
    limit={6}
    showHeaderLink
  />
  <About />
  <WriteToMe />
</BaseLayout>
