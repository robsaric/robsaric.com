---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Arrow from '../components/Arrow.astro';
import CompanyMark from '../components/CompanyMark.astro';
import hiking from '../assets/images/rob-hiking.jpg';
import followup from '../assets/images/caretrics-followup-demo.webp';
import followupMobile from '../assets/images/caretrics-followup-demo-mobile.webp';
import { EDITORIAL as E } from '../data/editorial';
import { SITE } from '../data/site';
const B = E.building;
---
<BaseLayout title={B.title} description={B.description} theme="warm">
  <section class="building-intro wrap" aria-labelledby="building-title">
    <h1 id="building-title">{B.heading}</h1>
    <p class="lead">{B.lead}</p>
    <nav class="intro-links" aria-label={B.title}>
      <a class="text-link" href="#projects">{B.projectsLink}<Arrow /></a>
      <a class="text-link" href="#togetheren">{B.studioLink}<Arrow /></a>
      <a class="text-link" href="#why">{B.whyLink}<Arrow /></a>
    </nav>
  </section>

  <div id="projects" class="projects wrap">
    <section id="caretrics" class="caretrics-project" aria-labelledby="caretrics-title">
      <header class="project-identity">
        <h2 id="caretrics-title"><span class="visually-hidden">{E.work.caretrics.name}</span><CompanyMark company="caretrics" /></h2>
        <p class="project-status">{E.work.caretrics.status}</p>
      </header>
      <div class="caretrics-layout">
        <div class="project-story">
          <h3>{B.caretrics.heading}</h3>
          <p>{B.caretrics.problem}</p>
          <p>{B.caretrics.approach}</p>
          <a class="action" href={SITE.caretricsUrl} target="_blank" rel="noopener">{E.work.caretrics.link}<Arrow diagonal /></a>
        </div>
        <figure class="product-example">
          <p class="image-label">{B.caretrics.imageLabel}</p>
          <picture>
            <source media="(max-width: 767.98px)" srcset={followupMobile.src} width="596" height="340" />
            <Image src={followup} alt={B.caretrics.imageAlt} width={1094} height={422} widths={[700, 1094]} sizes="(max-width: 1050px) calc(100vw - 80px), 52vw" loading="lazy" />
          </picture>
          <figcaption><strong>{B.caretrics.detailHeading}</strong>{B.caretrics.imageCaption}</figcaption>
        </figure>
      </div>
      <div class="thinking">
        <h3>{B.caretrics.thinkingHeading}</h3>
        <div>{B.caretrics.thinking.map(paragraph => <p>{paragraph}</p>)}</div>
      </div>
    </section>

    <section id="togetheren" class="studio" aria-labelledby="togetheren-title">
      <div class="studio-intro">
        <header class="project-identity">
          <h2 id="togetheren-title"><span class="visually-hidden">{E.work.togetheren.name}</span><CompanyMark company="togetheren" /></h2>
          <p class="project-status">{B.togetheren.status}</p>
        </header>
        <h3>{B.togetheren.heading}</h3>
        <p>{B.togetheren.body}</p>
      </div>
      <section id="skillnav" class="experiment" aria-labelledby="skillnav-title">
        <header class="project-identity">
          <h3 id="skillnav-title"><span class="visually-hidden">{E.work.togetheren.child}</span><CompanyMark company="skillnav" /></h3>
          <p class="project-status">{E.work.togetheren.childStatus}</p>
        </header>
        <h4>{B.togetheren.skillnavHeading}</h4>
        <p>{B.togetheren.skillnavBody}</p>
        <p>{B.togetheren.skillnavAim}</p>
        <a class="text-link" href="/contact/">{B.togetheren.skillnavLink}<Arrow /></a>
      </section>
    </section>
  </div>

  <section id="why" class="why wrap" aria-labelledby="why-title">
    <div class="why-story">
      <h2 id="why-title">{B.whyHeading}</h2>
      {B.why.map(paragraph => <p>{paragraph}</p>)}
      <a class="text-link" href="/archive/enjoy-the-little-things/">{B.storyLink}<Arrow /></a>
    </div>
    <figure><Image src={hiking} alt={E.about.hikingAlt} width={350} height={380} widths={[350, 700]} sizes="(max-width: 767px) calc(100vw - 48px), 28vw" loading="lazy" fit="cover" /></figure>
  </section>

  <section class="invitation wrap" aria-labelledby="invitation-title">
    <h2 id="invitation-title">{B.closingHeading}</h2>
    <p>{B.closingBody}</p>
    <div class="invitation-actions"><a class="action" href={SITE.links.linkedin} target="_blank" rel="noopener">{E.connect.follow}<Arrow diagonal /></a><a class="text-link" href="/contact/">{B.contactLink}<Arrow /></a></div>
  </section>
</BaseLayout>

<style>
  .building-intro { padding-block: 56px 48px; }
  h1 { margin: 0 0 24px; font-size: clamp(3rem, 5.5vw, 5rem); line-height: 1.08; }
  .lead { max-width: 62ch; margin: 0; font-size: 21px; line-height: 1.65; }
  .intro-links { display: flex; flex-wrap: wrap; gap: 8px 32px; margin-top: 20px; }
  .intro-links .text-link { font-size: 15px; }
  h2 { margin: 0 0 24px; font-size: clamp(2rem, 3.2vw, 2.75rem); line-height: 1.15; }
  h3, h4 { margin: 0 0 20px; font-size: clamp(1.75rem, 2.8vw, 2.4rem); line-height: 1.16; text-wrap: balance; }
  p { max-width: 68ch; margin: 0 0 20px; font-size: 18px; line-height: 1.75; }
  #projects, #caretrics, #togetheren, #skillnav, #why { scroll-margin-top: 24px; }
  .caretrics-project { padding-block: 28px 64px; border-top: 1px solid var(--rule); }
  .project-identity { display: flex; align-items: center; gap: 12px 28px; flex-wrap: wrap; margin-bottom: 28px; }
  .project-identity h2, .project-identity h3 { margin: 0; }
  .project-status { margin: 0; font-size: 13px; line-height: 1.5; color: var(--ink-muted); }
  .caretrics-layout { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.4fr); gap: 56px; align-items: start; }
  .project-story h3 { max-width: 22ch; }
  .project-story .action { margin-top: 4px; background: #c8f57d; color: #0c3b2e; }
  .project-story .action:hover { background: #b8e56d; }
  .caretrics-project .project-status { background: #c8f57d; color: #0c3b2e; padding: 5px 10px; border-radius: 3px; }
  .product-example { margin: 2px 0 0; }
  .image-label { margin: 0 0 12px; font-size: 13px; color: var(--ink-muted); }
  .product-example picture { display: block; border: 1px solid var(--rule); border-radius: 4px; overflow: hidden; }
  .product-example img { display: block; width: 100%; height: auto; }
  figcaption { max-width: 60ch; margin-top: 18px; font-size: 14px; line-height: 1.65; color: var(--ink-muted); }
  figcaption strong { display: block; margin-bottom: 6px; color: var(--ink); font-weight: 600; }
  .thinking { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.4fr); gap: 56px; padding-top: 32px; margin-top: 40px; border-top: 1px solid var(--rule); }
  .thinking h3 { font-size: 25px; }
  .thinking p { margin-bottom: 18px; font-size: 17px; }
  .thinking p:last-child { margin-bottom: 0; }
  .studio { border-top: 1px solid var(--rule); padding-block: 40px 64px; }
  .studio-intro { max-width: 760px; }
  .studio-intro .project-identity { margin-bottom: 20px; }
  .studio-intro > p { margin-bottom: 0; }
  .experiment { margin: 36px 0 0 40px; padding: 4px 0 4px 36px; border-left: 1px solid var(--rule); max-width: 820px; }
  .experiment .project-identity { margin-bottom: 22px; }
  .experiment h4 { font-size: 30px; max-width: 32ch; }
  .experiment p { font-size: 17px; }
  .experiment .project-status { font-size: 13px; }
  .experiment .text-link { font-size: 16px; }
  .why { display: grid; grid-template-columns: minmax(0, 720px) minmax(200px, 350px); gap: 80px; align-items: center; padding-block: 64px; border-top: 1px solid var(--rule); }
  .why figure { margin: 0; }
  .why img { display: block; width: 100%; height: auto; border-radius: 4px; }
  .why .text-link { font-size: 16px; }
  .invitation { padding-block: 56px 72px; border-top: 1px solid var(--rule); }
  .invitation h2 { margin-bottom: 20px; }
  .invitation > p { max-width: 62ch; }
  .invitation-actions { display: flex; align-items: center; gap: 16px 32px; flex-wrap: wrap; margin-top: 28px; }
  @media (min-width: 768px) and (max-width: 1050px) {
    .caretrics-layout { grid-template-columns: minmax(0, 1fr); gap: 32px; }
    .project-story { max-width: 68ch; }
    .project-story h3 { max-width: none; }
    .thinking { gap: 36px; }
    .why { grid-template-columns: minmax(0, 1fr) minmax(180px, 28%); gap: 36px; }
  }
  @media (max-width: 767.98px) {
    .building-intro { padding-block: 32px 32px; }
    h1 { font-size: clamp(2.5rem, 10vw, 3.5rem); margin-bottom: 20px; }
    .lead { font-size: 18px; }
    .intro-links { gap: 0 20px; margin-top: 16px; }
    h2 { font-size: 30px; }
    h3, h4 { font-size: 29px; }
    p { font-size: 17px; }
    .caretrics-project { padding-block: 24px 40px; }
    .project-identity { gap: 8px 18px; margin-bottom: 24px; }
    .caretrics-layout { grid-template-columns: minmax(0, 1fr); gap: 32px; }
    .thinking { grid-template-columns: minmax(0, 1fr); gap: 0; padding-top: 28px; margin-top: 28px; }
    .thinking h3 { margin-bottom: 14px; }
    .studio { padding-block: 28px 40px; }
    .experiment { margin: 28px 0 0; padding: 0 0 0 20px; }
    .experiment .project-identity { flex-direction: column; align-items: flex-start; gap: 8px; }
    .experiment h4 { font-size: 27px; }
    .why { grid-template-columns: minmax(0, 1fr); gap: 28px; padding-block: 40px; }
    .why img { aspect-ratio: 1.3; object-fit: cover; object-position: 50% 35%; }
    .invitation { padding-block: 40px 48px; }
    .invitation-actions { align-items: flex-start; flex-direction: column; gap: 12px; margin-top: 24px; }
    .invitation-actions .text-link { font-size: 15px; }
  }
</style>
