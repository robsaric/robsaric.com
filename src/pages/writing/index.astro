---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReadingList from '../../components/ReadingList.astro';
import FeaturedEssay from '../../components/FeaturedEssay.astro';
import Newsletter from '../../components/Newsletter.astro';
import Arrow from '../../components/Arrow.astro';
import { EDITORIAL as E } from '../../data/editorial';
import { SITE } from '../../data/site';
import { UI } from '../../data/ui';
import { getEarlierWriting, getRecentWriting } from '../../lib/editorial';
const earlier = await getEarlierWriting();
const recent = await getRecentWriting();
const featured = recent.find(item => item.href === E.writing.featuredHref);
const supporting = recent.filter(item => item.href !== featured?.href);
const newsletterEndpoint = import.meta.env.PUBLIC_NEWSLETTER_ENDPOINT?.trim();
---
<BaseLayout title={E.writing.pageTitle} description={E.writing.pageDescription}>
  <div class="wrap writing-page">
    <header><h1>{E.writing.pageHeading}</h1><p>{E.writing.pageIntro}</p></header>
    <div class="thread-controls" data-thread-controls hidden>
      <p>{UI.writingThreads.intro}</p>
      <div class="thread-buttons" role="group" aria-label={UI.writingThreads.label}>
        {(['all', 'digital', 'analog'] as const).map(thread => <button type="button" data-thread={thread} aria-pressed={thread === 'all'}>{UI.writingThreads[thread]}</button>)}
        <span class="thread-count" data-thread-count role="status" aria-live="polite">{UI.writingThreads.count(recent.length)}</span>
      </div>
    </div>
    <section class="recent" data-thread-results aria-labelledby="recent-title"><h2 id="recent-title" class="visually-hidden">{E.writing.latest}</h2>{featured && <FeaturedEssay item={featured} compact />}<ReadingList items={supporting} compact paired /><p data-thread-empty hidden>{UI.writingThreads.empty}</p></section>
    <section class="earlier" aria-labelledby="earlier-title"><div class="section-intro"><h2 id="earlier-title">{E.writing.earlier}</h2><p>{E.writing.earlierIntro}</p></div><ReadingList items={earlier} /><a class="text-link archive-link" href="/archive/">{E.writing.archive}<Arrow /></a></section>
  </div>
  <div class="writing-follow">
    <div class="wrap">
      <div class="writing-follow-content">
        {newsletterEndpoint ? <Newsletter id="writing-newsletter" split showLinkedIn /> : <section class="follow-fallback" aria-labelledby="follow-title"><h2 id="follow-title">{E.article.followHeading}</h2><p>{E.article.followBody}</p><a class="text-link" href={SITE.links.linkedin} target="_blank" rel="noopener">{E.connect.follow}<Arrow diagonal /></a></section>}
      </div>
    </div>
  </div>
</BaseLayout>
<script>
  import { UI } from '../../data/ui';
  const controls = document.querySelector<HTMLElement>('[data-thread-controls]');
  const entries = [...document.querySelectorAll<HTMLElement>('[data-thread-results] [data-writing-entry]')];
  if (controls) {
    const buttons = [...controls.querySelectorAll<HTMLButtonElement>('[data-thread]')];
    controls.hidden = false;
    buttons.forEach(button => button.addEventListener('click', () => {
      const selected = button.dataset.thread;
      buttons.forEach(item => item.setAttribute('aria-pressed', String(item === button)));
      entries.forEach(entry => { entry.hidden = selected !== 'all' && !entry.dataset.threads?.split(' ').includes(selected ?? ''); });
      const count = entries.filter(entry => !entry.hidden).length;
      const status = controls.querySelector('[data-thread-count]');
      if (status) status.textContent = UI.writingThreads.count(count);
      const empty = document.querySelector<HTMLElement>('[data-thread-empty]');
      if (empty) empty.hidden = count > 0;
      document.querySelectorAll<HTMLElement>('[data-thread-results] .reading-list').forEach(list => { list.hidden = ![...list.children].some(item => !(item as HTMLElement).hidden); });
    }));
  }
</script>
<style>
.thread-controls { margin: 0 0 20px; }
.thread-controls p { max-width: 65ch; margin: 0 0 12px; color: var(--ink-muted); font-size: 15px; line-height: 1.6; }
.thread-buttons { display: flex; align-items: center; flex-wrap: wrap; gap: 4px 20px; }
.thread-buttons button { min-height: 44px; min-width: 44px; padding: 8px 0; border: 0; border-bottom: 2px solid transparent; background: transparent; color: var(--ink-muted); cursor: pointer; font-size: 15px; }
.thread-buttons button[aria-pressed="true"] { color: var(--ink); border-bottom-color: var(--ink); }
.thread-buttons button:hover { color: var(--blue); }
.thread-count { margin-left: auto; color: var(--ink-muted); font-size: 13px; }
.writing-page { padding-block: 40px 56px; }
header { margin-bottom: 28px; display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(24px,4vw,56px); align-items: start; }
h1 { font-size: clamp(3rem, 5.2vw, 4.5rem); line-height: 1.1; margin: 0; }
header p { font-size: 19px; line-height: 1.6; max-width: 46ch; margin: 0; }
.earlier { margin-top: 48px; }
.section-intro { display: grid; grid-template-columns: 1fr 1.6fr; gap: 48px; margin-bottom: 24px; }
.section-intro h2 { margin: 0; font-size: 30px; }
.section-intro p { font-size: 17px; line-height: 1.65; margin: 0; max-width: 60ch; color: var(--ink-muted); }
.archive-link { margin-top: 22px; }
.writing-follow { padding-block: 0 56px; }
.writing-follow-content { padding: 48px; border: 1px solid var(--rule); border-radius: 12px; background: var(--paper-inset); }
.follow-fallback h2 { font-size: 30px; line-height: 1.2; margin: 0 0 20px; }
.follow-fallback p { font-size: 17px; line-height: 1.65; max-width: 60ch; margin: 0 0 16px; }
@media (max-width: 767.98px) {
 .writing-page { padding-block: 28px 40px; }
 header { margin-bottom: 24px; grid-template-columns: minmax(0,1fr); gap: 16px; }
 header p { font-size: 17px; }
 .section-intro { grid-template-columns: minmax(0,1fr); gap: 16px; }
 .section-intro h2 { font-size: 28px; }
 .earlier { margin-top: 36px; }
 .writing-follow { padding-block: 0 40px; }
 .writing-follow-content { padding: 28px 22px; }
}
</style>
